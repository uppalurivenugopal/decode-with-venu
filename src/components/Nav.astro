---
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';

const concepts = (await getCollection('concepts')).sort(
  (a, b) => (a.data.seriesIndex ?? 0) - (b.data.seriesIndex ?? 0)
);

const links = [
  { href: '/decode-framework', label: 'DECODE Framework' },
  { href: '/strategies', label: 'Strategies' },
  { href: '/perspectives', label: 'Perspectives' },
  { href: '/about', label: 'About Me' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur-lg">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="flex h-16 items-center justify-between">
      <Logo />

      <nav class="hidden md:flex items-center gap-1 text-sm">
        <a
          href="/"
          class:list={["px-3 py-2 rounded-md transition-colors", currentPath === '/' ? 'text-white' : 'text-mist-400 hover:text-white']}
        >Home</a>

        <div class="relative group">
          <a
            href="/concepts"
            class:list={["px-3 py-2 rounded-md transition-colors flex items-center gap-1", currentPath.startsWith('/concepts') ? 'text-white' : 'text-mist-400 hover:text-white']}
          >
            Concepts
            <svg class="w-3 h-3 opacity-60" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-150">
            <div class="w-72 rounded-xl border border-white/10 bg-ink-900 shadow-2xl shadow-black/40 p-1.5">
              {concepts.map((c) => (
                <a href={`/concepts/${c.id}`} class="block rounded-lg px-3 py-2.5 hover:bg-white/5 transition-colors">
                  <p class="text-sm text-mist-200 font-medium leading-snug">{c.data.title}</p>
                </a>
              ))}
            </div>
          </div>
        </div>

        {links.map((l) => (
          <a
            href={l.href}
            class:list={["px-3 py-2 rounded-md transition-colors", currentPath === l.href ? 'text-white' : 'text-mist-400 hover:text-white']}
          >{l.label}</a>
        ))}
      </nav>

      <div class="hidden md:block">
        <a href="/subscribe" class="inline-flex items-center rounded-full bg-white text-ink-950 px-4 py-2 text-sm font-semibold hover:bg-mist-200 transition-colors">
          Subscribe
        </a>
      </div>

      <button id="menu-btn" aria-label="Open menu" class="md:hidden text-mist-200 p-2 -mr-2">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-ink-950">
    <nav class="flex flex-col px-5 py-3 gap-0.5 text-sm">
      <a href="/" class="px-2 py-2.5 text-mist-300 hover:text-white">Home</a>
      <a href="/concepts" class="px-2 py-2.5 text-mist-300 hover:text-white">Concepts</a>
      {concepts.map((c) => (
        <a href={`/concepts/${c.id}`} class="pl-5 py-2 text-mist-400 hover:text-white text-[13px]">{c.data.title}</a>
      ))}
      {links.map((l) => (
        <a href={l.href} class="px-2 py-2.5 text-mist-300 hover:text-white">{l.label}</a>
      ))}
      <a href="/subscribe" class="mt-2 text-center rounded-full bg-white text-ink-950 px-4 py-2.5 font-semibold">Subscribe</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
