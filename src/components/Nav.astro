---
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';

const concepts = (await getCollection('concepts')).sort(
  (a, b) => (a.data.seriesIndex ?? 0) - (b.data.seriesIndex ?? 0)
);

const links = [
  { href: '/', label: 'Home' },
  { href: '/concepts', label: 'Concepts' },
  { href: '/decode-framework', label: 'DECODE Framework' },
  { href: '/strategies', label: 'Strategies' },
  { href: '/perspectives', label: 'Perspectives' },
  { href: '/projects', label: 'Casual Projects' },
  { href: '/resources', label: 'Resources' },
  { href: '/guest-lectures', label: 'Guest Lectures' },
  { href: '/contact', label: 'Contact Me' },
  { href: '/about', label: 'About Me' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!-- Desktop: fixed left sidebar -->
<aside class="hidden md:flex md:flex-col md:fixed md:inset-y-0 md:left-0 md:w-[248px] md:border-r md:border-edge/15 md:bg-ink-950 md:px-7 md:py-9 md:overflow-y-auto">
  <Logo />

  <nav class="mt-12 flex flex-col gap-0.5 text-[15px]">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={["px-2.5 py-2 -mx-2.5 rounded-md font-medium transition-colors", isActive(l.href) ? 'text-fg bg-edge/[0.04]' : 'text-mist-400 hover:text-fg']}
      >{l.label}</a>
    ))}
  </nav>

  <div class="mt-auto pt-8 border-t border-edge/15">
    <a href="/subscribe" class="inline-flex items-center border-b border-cyan-glow pb-0.5 text-[15px] font-semibold text-fg hover:text-cyan-glow transition-colors">
      Newsletter
    </a>
  </div>
</aside>

<!-- Mobile: top bar -->
<header class="md:hidden sticky top-0 z-50 border-b border-edge/15 bg-ink-950/95 backdrop-blur-sm">
  <div class="px-5 flex h-[72px] items-center justify-between">
    <Logo />
    <button id="menu-btn" aria-label="Open menu" class="text-mist-200 p-2 -mr-2">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-edge/15 bg-ink-950">
    <nav class="flex flex-col px-5 py-3 gap-0.5 text-base">
      {links.map((l) => (
        <a href={l.href} class="px-2 py-2.5 text-mist-300 hover:text-fg">{l.label}</a>
      ))}
      {currentPath.startsWith('/concepts') && concepts.map((c) => (
        <a href={`/concepts/${c.id}`} class="pl-5 py-2 text-mist-400 hover:text-fg text-sm">{c.data.title}</a>
      ))}
      <a href="/subscribe" class="mt-2 px-2 py-2.5 font-semibold text-cyan-glow">Newsletter</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
