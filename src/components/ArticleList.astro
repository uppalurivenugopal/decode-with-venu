---
// Editorial index rows shared by the concepts, strategies and perspectives listings:
// date column, serif headline, and the article thumbnail on the right.
import { formatShortDate, readingMinutes } from '../utils/article';

interface Item {
  href: string;
  title: string;
  description: string;
  date: Date;
  body?: string;
  kicker?: string;
  image?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="border-b border-edge/15">
  {items.map((item) => (
    <li>
      <a href={item.href} class="group grid gap-x-10 gap-y-4 border-t border-edge/15 py-9 transition-colors hover:border-cyan-glow md:grid-cols-[8rem_minmax(0,1fr)_13rem] md:py-10">
        <div class="flex gap-3 text-sm text-mist-400 md:block">
          <time datetime={item.date.toISOString()} class="font-semibold text-fg">{formatShortDate(item.date)}</time>
          {item.body && <p class="md:mt-1">{readingMinutes(item.body)} min read</p>}
        </div>

        <div class="min-w-0">
          {item.kicker && <p class="mb-3 text-sm leading-snug text-mist-400">{item.kicker}</p>}
          <h2 class="font-serif text-2xl sm:text-[1.75rem] font-semibold leading-tight tracking-[-0.025em] text-fg group-hover:text-cyan-glow transition-colors">
            {item.title}
          </h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-mist-300">{item.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-fg group-hover:text-cyan-glow transition-colors">Read <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span></span>
        </div>

        {item.image && (
          <div class="max-w-xs md:max-w-none">
            <img
              src={item.image}
              alt=""
              loading="lazy"
              class="w-full h-auto border border-edge/15 bg-ink-900 transition-colors group-hover:border-cyan-glow/60"
              onerror="this.closest('div').style.display='none';"
            />
          </div>
        )}
      </a>
    </li>
  ))}
</ol>
