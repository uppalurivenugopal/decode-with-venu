---
interface Props {
  eyebrow?: string;
  title: string;
  class?: string;
}
const { eyebrow, title, class: className = '' } = Astro.props;
---
<div class={className}>
  {eyebrow && (
    <p class="font-mono text-xs tracking-widest text-cyan-glow/80 uppercase mb-3">{eyebrow}</p>
  )}
  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">{title}</h2>
  <div class="accent-rule mt-4"></div>
</div>
