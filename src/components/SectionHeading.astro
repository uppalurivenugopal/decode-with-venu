---
interface Props {
  eyebrow?: string;
  title: string;
  class?: string;
}
const { eyebrow, title, class: className = '' } = Astro.props;
---
<div class={className}>
  {eyebrow && (
    <p class="text-[13px] font-bold tracking-[0.14em] text-cyan-glow uppercase mb-3">{eyebrow}</p>
  )}
  <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-[-0.03em] text-fg">{title}</h2>
  <div class="accent-rule mt-4"></div>
</div>
