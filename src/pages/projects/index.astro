---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const industries = [
  { key: '', label: 'All industries' },
  { key: 'bfsi', label: 'BFSI' },
  { key: 'tech', label: 'Technology' },
  { key: 'healthcare', label: 'Healthcare' },
  { key: 'manufacturing', label: 'Manufacturing' },
  { key: 'retail', label: 'Retail & consumer' },
  { key: 'consulting', label: 'Consulting & services' },
];

const functions = [
  { key: '', label: 'All functions' },
  { key: 'hr', label: 'HR & talent' },
  { key: 'marketing', label: 'Marketing & growth' },
  { key: 'finance', label: 'Finance & risk' },
  { key: 'ops', label: 'Operations & supply chain' },
  { key: 'strategy', label: 'Strategy & analytics' },
  { key: 'tech', label: 'Technology' },
];

const projects = [
  {
    href: '/projects/tread',
    icon: 'run',
    tag: 'Data aggregator · refreshed weekly',
    title: 'T.R.E.A.D',
    description: 'Trail and Road Event Aggregated Database. Every upcoming running event in India, from 5K community runs to 300K Himalayan ultras, plus the world\'s marquee races, for the next 13 months. Crawled weekly from four race platforms, de-duplicated, with a source link for every race, and filterable by philanthropic cause.',
    industries: [],
    functions: [],
  },
  {
    href: '/projects/stride',
    icon: 'strength',
    tag: 'Rule-based planner · pairs with T.R.E.A.D',
    title: 'S.T.R.I.D.E',
    description: 'Strength Training for Runners, Individually Designed for your Event. Pick a race from T.R.E.A.D, enter your age, current training, equipment and time, and get a phased, week-by-week strength plan that rebuilds with every answer you change.',
    industries: [],
    functions: [],
  },
  {
    href: '/projects/microsoft-certification-path',
    icon: 'cert',
    tag: 'Decision tree · refreshed monthly',
    title: 'Microsoft Certification Path',
    description: 'Five questions on your track and interests, one recommended Microsoft certification: the official skills it measures, why it matters to clients and your own team, Solutions Partner credit, and links to learn and book. Includes the full roadmap and every retirement and replacement, re-checked against Microsoft Learn every month.',
    industries: ['bfsi', 'tech', 'healthcare', 'manufacturing', 'retail', 'consulting'],
    functions: ['tech', 'strategy'],
  },
  {
    href: '/projects/offer-signal',
    icon: 'offer',
    tag: 'Weighted scorecard',
    title: 'Offer signal',
    description: 'The offer is signed, the interviews are done — will they actually join? A 17-signal scorecard across compensation, market fit, mobility, timing, and candidate context.',
    industries: ['bfsi', 'tech', 'healthcare', 'manufacturing', 'retail', 'consulting'],
    functions: ['hr'],
  },
  {
    href: '/projects/governance-passport',
    icon: 'governance',
    tag: 'Maturity assessment',
    title: 'Governance Passport',
    description: 'A 24-question, 8-theme AI governance assessment for enterprises. Places you at Novice, Dabbling, or Intermediate, then builds a phased roadmap of concrete steps, time estimates, and the templates each one needs.',
    industries: ['bfsi', 'tech', 'healthcare', 'manufacturing', 'retail', 'consulting'],
    functions: ['strategy', 'ops', 'tech'],
  },
];
---

<Layout title="Vibing" description="Small interactive builds applying business-school concepts — logistic regression, weighted scorecards — to real workplace decisions.">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <PageHero eyebrow="Vibing" aside={`${projects.length} interactive tools, filtered by industry and function below.`}>
      <Fragment slot="title">Small builds, <span class="gradient-text">real intuition</span></Fragment>
      Not case studies — toy models. Each one takes a concept from the classroom and turns it into
      something you can drag, break, and stare at until it clicks. Illustrative weights, not trained
      on real data, built to teach the shape of the reasoning rather than ship a production score.
    </PageHero>

    <div class="mb-10 grid gap-6 border-t border-edge/15 pt-8 lg:grid-cols-2 lg:gap-10">
      <div>
        <p class="mb-3 text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Industry</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2" data-filter-group="industry">
          {industries.map((i) => (
            <button type="button" data-filter-value={i.key} class="filter-btn">{i.label}</button>
          ))}
        </div>
      </div>
      <div>
        <p class="mb-3 text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Business function</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2" data-filter-group="function">
          {functions.map((f) => (
            <button type="button" data-filter-value={f.key} class="filter-btn">{f.label}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
      {projects.map((p) => (
        <a
          href={p.href}
          class="card group flex flex-col py-7"
          data-industries={p.industries.join(',')}
          data-functions={p.functions.join(',')}
        >
          <div class="mb-5">
            {p.icon === 'offer' && (
              <svg class="w-7 h-7 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 13l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {p.icon === 'run' && (
              <svg class="w-7 h-7 text-cyan-glow" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 12h17M12 3.5c2.5 2.3 3.6 5.2 3.6 8.5S14.5 18.2 12 20.5M12 3.5C9.5 5.8 8.4 8.7 8.4 12s1.1 6.2 3.6 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            )}
            {p.icon === 'strength' && (
              <svg class="w-7 h-7 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M6.5 7v10M17.5 7v10M3.5 9.5v5M20.5 9.5v5M6.5 12h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            )}
            {p.icon === 'cert' && (
              <svg class="w-7 h-7 text-cyan-glow" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="9" r="5.5" stroke="currentColor" stroke-width="1.4"/><path d="M9.5 9l1.8 1.8L14.8 7.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.8 13.6L7.5 21l4.5-2.4 4.5 2.4-1.3-7.4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            )}
            {p.icon === 'governance' && (
              <svg class="w-7 h-7 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 12.5l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </div>
          <p class="mb-2 text-sm text-mist-400">{p.tag}</p>
          <h2 class="flex items-center gap-2 font-serif text-2xl font-semibold tracking-[-0.02em] text-fg group-hover:text-cyan-glow transition-colors">
            {p.title}
            <svg class="w-3.5 h-3.5 text-mist-400 group-hover:text-cyan-glow group-hover:translate-x-0.5 transition-all" viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7M6 2.5L9.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </h2>
          <p class="mt-3 leading-relaxed text-mist-300">{p.description}</p>
        </a>
      ))}
    </div>

    <div id="empty-state" class="hidden card max-w-xl py-10">
      <p class="text-mist-300 font-medium">No projects match yet</p>
      <p class="mt-2 text-sm text-mist-400">More Vibing builds are on the way — try a different combination or check back soon.</p>
    </div>
  </div>
</Layout>

<style>
  .filter-btn {
    font-size: 14px;
    font-weight: 500;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
    color: var(--color-mist-400);
    background: transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .filter-btn:hover {
    color: var(--color-fg);
  }
  .filter-btn[data-active='true'] {
    color: var(--color-fg);
    font-weight: 600;
    border-color: var(--color-cyan-glow);
  }
</style>

<script>
  const state: { industry: string; fn: string } = { industry: '', fn: '' };

  function applyButtonStyles() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter-group="industry"] .filter-btn').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.filterValue === state.industry);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-filter-group="function"] .filter-btn').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.filterValue === state.fn);
    });
  }

  function applyFilter() {
    const cards = document.querySelectorAll<HTMLAnchorElement>('#project-grid > a');
    let visibleCount = 0;
    cards.forEach((card) => {
      const cardIndustries = (card.dataset.industries || '').split(',');
      const cardFunctions = (card.dataset.functions || '').split(',');
      const industryMatch = state.industry === '' || cardIndustries.includes(state.industry);
      const functionMatch = state.fn === '' || cardFunctions.includes(state.fn);
      const visible = industryMatch && functionMatch;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });
    document.getElementById('empty-state')!.classList.toggle('hidden', visibleCount > 0);
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest<HTMLElement>('[data-filter-group]')!.dataset.filterGroup;
      const value = btn.dataset.filterValue || '';
      if (group === 'industry') state.industry = value;
      if (group === 'function') state.fn = value;
      applyButtonStyles();
      applyFilter();
    });
  });

  applyButtonStyles();
  applyFilter();
</script>
