---
import Layout from '../../layouts/Layout.astro';

const industries = [
  { key: '', label: 'All industries' },
  { key: 'bfsi', label: 'BFSI' },
  { key: 'tech', label: 'Technology' },
  { key: 'healthcare', label: 'Healthcare' },
  { key: 'manufacturing', label: 'Manufacturing' },
  { key: 'retail', label: 'Retail & consumer' },
  { key: 'consulting', label: 'Consulting & services' },
];

const functions = [
  { key: '', label: 'All functions' },
  { key: 'hr', label: 'HR & talent' },
  { key: 'marketing', label: 'Marketing & growth' },
  { key: 'finance', label: 'Finance & risk' },
  { key: 'ops', label: 'Operations & supply chain' },
  { key: 'strategy', label: 'Strategy & analytics' },
  { key: 'tech', label: 'Technology' },
];

const projects = [
  {
    href: '/projects/offer-signal',
    icon: 'offer',
    tag: 'Weighted scorecard',
    title: 'Offer signal',
    description: 'The offer is signed, the interviews are done — will they actually join? A 17-signal scorecard across compensation, market fit, mobility, timing, and candidate context.',
    industries: ['bfsi', 'tech', 'healthcare', 'manufacturing', 'retail', 'consulting'],
    functions: ['hr'],
  },
  {
    href: '/projects/governance-passport',
    icon: 'governance',
    tag: 'Maturity assessment',
    title: 'Governance Passport',
    description: 'A 24-question, 8-theme AI governance assessment for enterprises. Places you at Novice, Dabbling, or Intermediate, then builds a phased roadmap of concrete steps, time estimates, and the templates each one needs.',
    industries: ['bfsi', 'tech', 'healthcare', 'manufacturing', 'retail', 'consulting'],
    functions: ['strategy', 'ops', 'tech'],
  },
];
---

<Layout title="Casual Projects" description="Small interactive builds applying business-school concepts — logistic regression, weighted scorecards — to real workplace decisions.">
  <section class="relative overflow-hidden bg-grid border-b border-edge/5">
    <div class="glow w-[30rem] h-[30rem] bg-indigo-glow/15 -top-40 right-1/4"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-5 sm:px-8 pt-20 pb-16 sm:pt-28 sm:pb-20">
      <p class="font-mono text-xs tracking-widest text-cyan-glow/80 uppercase mb-4">Casual Projects</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-fg leading-tight">
        Small builds, <span class="gradient-text">real intuition</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-mist-300">
        Not case studies — toy models. Each one takes a concept from the classroom and turns it into
        something you can drag, break, and stare at until it clicks. Illustrative weights, not trained
        on real data, built to teach the shape of the reasoning rather than ship a production score.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 sm:px-8 py-16 sm:py-20">
    <div class="mb-10 space-y-5">
      <div>
        <p class="font-mono text-[11px] tracking-widest uppercase text-mist-400 mb-2.5">Industry</p>
        <div class="flex flex-wrap gap-2" data-filter-group="industry">
          {industries.map((i) => (
            <button type="button" data-filter-value={i.key} class="filter-btn">{i.label}</button>
          ))}
        </div>
      </div>
      <div>
        <p class="font-mono text-[11px] tracking-widest uppercase text-mist-400 mb-2.5">Business function</p>
        <div class="flex flex-wrap gap-2" data-filter-group="function">
          {functions.map((f) => (
            <button type="button" data-filter-value={f.key} class="filter-btn">{f.label}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="grid gap-5 max-w-xl" id="project-grid">
      {projects.map((p) => (
        <a
          href={p.href}
          class="card group p-7 flex flex-col"
          data-industries={p.industries.join(',')}
          data-functions={p.functions.join(',')}
        >
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-glow/20 to-indigo-glow/20 border border-edge/10 flex items-center justify-center mb-6">
            {p.icon === 'offer' && (
              <svg class="w-5 h-5 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 13l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {p.icon === 'governance' && (
              <svg class="w-5 h-5 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 12.5l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </div>
          <p class="font-mono text-[11px] tracking-widest uppercase text-mist-400 mb-2">{p.tag}</p>
          <h2 class="text-xl font-semibold text-fg flex items-center gap-2">
            {p.title}
            <svg class="w-3.5 h-3.5 text-mist-400 group-hover:text-cyan-glow group-hover:translate-x-0.5 transition-all" viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7M6 2.5L9.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </h2>
          <p class="mt-3 text-sm text-mist-400 leading-relaxed">{p.description}</p>
        </a>
      ))}
    </div>

    <div id="empty-state" class="hidden card max-w-xl p-10 text-center">
      <p class="text-mist-300 font-medium">No projects match yet</p>
      <p class="mt-2 text-sm text-mist-400">More Casual Projects are on the way — try a different combination or check back soon.</p>
    </div>
  </section>
</Layout>

<style>
  .filter-btn {
    font-size: 12.5px;
    font-weight: 500;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-edge) 10%, transparent);
    color: var(--color-mist-400);
    opacity: 0.5;
    background: transparent;
    transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .filter-btn:hover {
    opacity: 0.85;
  }
  .filter-btn[data-active='true'] {
    opacity: 1;
    color: var(--color-cyan-glow);
    border-color: color-mix(in srgb, var(--color-cyan-glow) 35%, transparent);
    background: color-mix(in srgb, var(--color-cyan-glow) 10%, transparent);
  }
</style>

<script>
  const state: { industry: string; fn: string } = { industry: '', fn: '' };

  function applyButtonStyles() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter-group="industry"] .filter-btn').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.filterValue === state.industry);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-filter-group="function"] .filter-btn').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.filterValue === state.fn);
    });
  }

  function applyFilter() {
    const cards = document.querySelectorAll<HTMLAnchorElement>('#project-grid > a');
    let visibleCount = 0;
    cards.forEach((card) => {
      const cardIndustries = (card.dataset.industries || '').split(',');
      const cardFunctions = (card.dataset.functions || '').split(',');
      const industryMatch = state.industry === '' || cardIndustries.includes(state.industry);
      const functionMatch = state.fn === '' || cardFunctions.includes(state.fn);
      const visible = industryMatch && functionMatch;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });
    document.getElementById('empty-state')!.classList.toggle('hidden', visibleCount > 0);
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest<HTMLElement>('[data-filter-group]')!.dataset.filterGroup;
      const value = btn.dataset.filterValue || '';
      if (group === 'industry') state.industry = value;
      if (group === 'function') state.fn = value;
      applyButtonStyles();
      applyFilter();
    });
  });

  applyButtonStyles();
  applyFilter();
</script>
