---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Governance Passport"
  description="A phased AI governance maturity assessment for enterprises — 24 calibrated questions across 8 themes, a personalized roadmap, and step-by-step activity tracking with save-and-resume."
  image="/images/og/governance-passport.png"
>
  <section class="relative overflow-hidden bg-grid border-b border-edge/5">
    <div class="glow w-[28rem] h-[28rem] bg-cyan-glow/15 -top-40 left-1/3"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-5 sm:px-8 pt-14 pb-12 sm:pt-20 sm:pb-16">
      <a href="/projects" class="inline-flex items-center gap-1.5 text-xs text-mist-400 hover:text-fg transition-colors mb-6">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M9.5 6h-7M6 2.5L2.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Casual Projects
      </a>
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow mb-4">Interactive assessment &middot; enterprise AI governance</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">
        Chart your organization's <span class="gradient-text">AI governance maturity.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-mist-400">
        24 questions across 8 themes place your organization at Novice, Dabbling, or Intermediate, then
        build a phased, step-by-step roadmap — what to fix first, how long it takes, and which template
        or framework each step needs.
      </p>
      <div id="stagebadge" class="mt-5"></div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 sm:px-8 py-12 sm:py-16">
    <div class="stage anim" id="stage"></div>
  </section>
</Layout>

<style is:global>
  #stage, #stage * { box-sizing: border-box; }

  #stage {
    --surface: color-mix(in srgb, var(--color-edge) 3%, transparent);
    --surface-alt: color-mix(in srgb, var(--color-edge) 6%, transparent);
    --ink: var(--color-fg);
    --ink-muted: var(--color-mist-300);
    --ink-faint: var(--color-mist-400);
    --border: color-mix(in srgb, var(--color-edge) 8%, transparent);
    --border-strong: color-mix(in srgb, var(--color-edge) 16%, transparent);
    --accent: var(--color-cyan-glow);
    --accent-strong: var(--color-indigo-glow);
    --accent-tint: color-mix(in srgb, var(--color-cyan-glow) 12%, transparent);
    --success: #34d399;
    --success-tint: color-mix(in srgb, #34d399 14%, transparent);
    --warning: #fbbf24;
    --warning-tint: color-mix(in srgb, #fbbf24 14%, transparent);
    --critical: #fb7185;
    --critical-tint: color-mix(in srgb, #fb7185 14%, transparent);
    --shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.5);
  }
  :root[data-theme='light'] #stage {
    --success: #059669;
    --success-tint: color-mix(in srgb, #059669 12%, transparent);
    --warning: #b45309;
    --warning-tint: color-mix(in srgb, #b45309 12%, transparent);
    --critical: #e11d48;
    --critical-tint: color-mix(in srgb, #e11d48 12%, transparent);
    --shadow: 0 10px 24px -14px rgba(15, 23, 42, 0.2);
  }

  #stage, #stagebadge { font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif; }
  #stage a, #stage button { font-family: inherit; }

  #stage .eyebrow {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }

  #stage h1, #stage h2, #stage h3 {
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0;
    color: var(--ink);
  }
  #stage p { line-height: 1.6; color: var(--ink); margin: 0; }

  .stagebadge-pill {
    font-family: var(--font-mono), monospace;
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-cyan-glow);
    color: var(--color-cyan-glow);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cyan-glow) 12%, transparent);
    white-space: nowrap;
  }

  /* ---------- Stage panel ---------- */
  .stage {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: var(--shadow);
    padding: 2.75rem 2.5rem;
    backdrop-filter: blur(6px);
  }
  @media (max-width: 640px) { .stage { padding: 1.75rem 1.25rem; } }

  .stage.anim { animation: fadeSlideIn .32s ease; }
  @keyframes fadeSlideIn { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .stage.anim { animation: none; } }

  #stage .btn {
    font-family: var(--font-sans), sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.68rem 1.35rem;
    border-radius: 0.6rem;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease, opacity .15s ease, background-image .15s ease;
  }
  #stage .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #stage .btn-primary { background-image: linear-gradient(90deg, var(--color-cyan-glow), var(--color-indigo-glow)); color: #fff; }
  #stage .btn-primary:hover { opacity: .88; }
  #stage .btn-primary:disabled { opacity: 0.35; cursor: not-allowed; }
  #stage .btn-ghost { background: transparent; border-color: var(--border-strong); color: var(--ink); }
  #stage .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  #stage .btn-ghost:disabled { opacity: 0.35; cursor: not-allowed; }
  #stage .btn-ghost:disabled:hover { border-color: var(--border-strong); color: var(--ink); }

  #stage .actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2.25rem; }
  #stage .actions.split { justify-content: space-between; }

  /* ---------- Intro ---------- */
  #stage .hero h1 { font-size: 2.15rem; line-height: 1.18; max-width: 22ch; }
  #stage .hero .lede { margin-top: 1rem; max-width: 58ch; color: var(--ink-muted); font-size: 1.02rem; }
  #stage .hero .meta { margin-top: 1.4rem; font-family: var(--font-mono), monospace; font-size: 0.75rem; color: var(--ink-faint); letter-spacing: 0.03em; }

  #stage .route {
    margin-top: 2.5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--border); border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden;
  }
  @media (max-width: 640px) { #stage .route { grid-template-columns: 1fr; } }
  #stage .route-card { background: var(--surface); padding: 1.1rem 1.2rem; }
  #stage .route-card .ri { font-family: var(--font-mono), monospace; font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.08em; }
  #stage .route-card .rn { font-weight: 700; font-size: 1.05rem; margin-top: 0.25rem; color: var(--ink); }
  #stage .route-card .rt { font-size: 0.83rem; color: var(--ink-muted); margin-top: 0.4rem; font-style: italic; }
  #stage .route-note { margin-top: 0.9rem; font-size: 0.82rem; color: var(--ink-faint); }

  #stage .resume-banner {
    margin-top: 1.6rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
    padding: 1rem 1.15rem; background: var(--accent-tint); border: 1px solid var(--accent); border-radius: 0.75rem;
  }
  #stage .resume-title { font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  #stage .resume-sub { margin-top: 0.25rem; font-family: var(--font-mono), monospace; font-size: 0.72rem; color: var(--ink-muted); }
  #stage .resume-actions { display: flex; gap: 0.6rem; flex: none; }

  /* ---------- Quiz ---------- */
  #stage .quizlayout { display: grid; grid-template-columns: 210px 1fr; gap: 2.2rem; }
  @media (max-width: 760px) { #stage .quizlayout { grid-template-columns: 1fr; } }

  #stage .themerail { display: flex; flex-direction: column; gap: 0.3rem; border-right: 1px solid var(--border); padding-right: 1.5rem; }
  @media (max-width: 760px) {
    #stage .themerail {
      flex-direction: row; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch;
      border-right: none; padding-right: 0; border-bottom: 1px solid var(--border); padding-bottom: 0.9rem; margin-bottom: 0.3rem;
      scrollbar-width: none;
    }
    #stage .themerail::-webkit-scrollbar { display: none; }
    #stage .themerail-item { flex: 0 0 auto; white-space: nowrap; }
    #stage .themerail-item .tri-name { max-width: 9rem; overflow: hidden; text-overflow: ellipsis; }
  }
  #stage .themerail-item {
    display: flex; align-items: center; gap: 0.5rem; text-align: left; background: none; border: none;
    padding: 0.45rem 0.5rem; border-radius: 0.5rem; cursor: default; color: var(--ink-faint); font-size: 0.78rem;
    line-height: 1.3;
  }
  #stage .themerail-item .tri-num { font-family: var(--font-mono), monospace; font-size: 0.65rem; flex: none; width: 1.2rem; }
  #stage .themerail-item .tri-name { flex: 1; }
  #stage .themerail-item .tri-check { color: var(--success); font-size: 0.72rem; flex: none; }
  #stage .themerail-item.current { color: var(--ink); font-weight: 600; background: var(--accent-tint); }
  #stage .themerail-item.current .tri-num { color: var(--accent); }
  #stage .themerail-item.done { color: var(--ink-muted); cursor: pointer; }
  #stage .themerail-item.done:hover { background: var(--surface-alt); }
  #stage .themerail-item.done:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #stage .themerail-item.upcoming { opacity: 0.55; }

  #stage .qmeta { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.4rem; }
  #stage .qcounter { font-family: var(--font-mono), monospace; font-size: 0.72rem; color: var(--ink-faint); }
  #stage .progressbar-track { height: 4px; background: var(--surface-alt); border-radius: 999px; overflow: hidden; margin-top: 0.9rem; }
  #stage .progressbar-fill { height: 100%; background: var(--accent); transition: width .25s ease; }
  #stage .qtext { font-size: 1.5rem; margin-top: 1.3rem; max-width: 32ch; }
  #stage .options { margin-top: 1.6rem; display: flex; flex-direction: column; gap: 0.65rem; }
  #stage .opt {
    text-align: left; padding: 0.9rem 1.1rem; border: 1.5px solid var(--border);
    border-radius: 0.75rem; background: var(--surface); cursor: pointer; font-size: 0.94rem;
    display: flex; gap: 0.75rem; align-items: flex-start; color: var(--ink);
    transition: border-color .15s ease, background .15s ease;
  }
  #stage .opt:hover { border-color: var(--border-strong); }
  #stage .opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #stage .opt.sel { border-color: var(--accent); background: var(--accent-tint); }
  #stage .opt .mark {
    flex: none; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--border-strong);
    margin-top: 0.15rem; position: relative;
  }
  #stage .opt.sel .mark { border-color: var(--accent); }
  #stage .opt.sel .mark::after {
    content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--accent);
  }
  #stage .opt-divider { border-top: 1px dashed var(--border-strong); margin: 0.3rem 0; }
  #stage .opt.skip { color: var(--ink-muted); font-size: 0.86rem; padding: 0.7rem 1.1rem; }
  #stage .opt.skip.sel { border-color: var(--border-strong); background: var(--surface-alt); }
  #stage .opt.skip.sel .mark { border-color: var(--ink-muted); }
  #stage .opt.skip.sel .mark::after { background: var(--ink-muted); }

  /* ---------- Briefing ---------- */
  #stage .stagename { font-size: 2.1rem; margin-top: 0.4rem; }
  #stage .tagline { font-style: italic; color: var(--ink-muted); margin-top: 0.5rem; font-size: 1.02rem; }
  #stage .profile { margin-top: 1.3rem; padding: 1rem 1.2rem; background: var(--surface-alt); border-radius: 0.75rem; border: 1px solid var(--border); font-size: 0.95rem; color: var(--ink-muted); }
  #stage .fieldnotes { margin-top: 1.6rem; }
  #stage .fieldnotes .fn-title { font-family: var(--font-mono), monospace; font-size: 0.7rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-faint); }
  #stage .fieldnotes ul { list-style: none; margin: 0.8rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  #stage .fieldnotes li { display: flex; gap: 0.65rem; font-size: 0.94rem; color: var(--ink); align-items: baseline; }
  #stage .fieldnotes li::before { content: "\2013"; color: var(--ink-faint); flex: none; }

  /* ---------- Roadmap ---------- */
  #stage .qb-summary {
    margin-top: 1.2rem; padding: 0.95rem 1.15rem; background: var(--surface-alt); border: 1px solid var(--border); border-radius: 0.75rem;
  }
  #stage .qb-summary .qlabel { font-weight: 500; font-size: 0.96rem; color: var(--ink); }
  #stage .qb-summary .qcount { display: block; margin-top: 0.35rem; font-family: var(--font-mono), monospace; font-size: 0.75rem; color: var(--ink-muted); }

  #stage .phase { margin-top: 2.3rem; }
  #stage .phase:first-of-type { margin-top: 1.8rem; }
  #stage .phase-head { padding-left: 1rem; border-left: 3px solid var(--accent); }
  #stage .phase-head.focus { border-left-color: var(--critical); }
  #stage .phase-head.inline { border-left-color: var(--accent); }
  #stage .phase-head.ahead { border-left-color: var(--success); }
  #stage .phase-head .peyebrow { font-family: var(--font-mono), monospace; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); }
  #stage .phase-head h3 { font-size: 1.28rem; margin-top: 0.35rem; }
  #stage .phase-head .phase-sub { margin-top: 0.4rem; font-size: 0.86rem; color: var(--ink-muted); max-width: 62ch; }

  #stage .gapgrid { margin-top: 1.2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 760px) { #stage .gapgrid { grid-template-columns: 1fr; } }

  #stage .gapcard { border: 1px solid var(--border); border-left-width: 3px; border-radius: 0.75rem; padding: 1.1rem 1.15rem; background: var(--surface); display: flex; flex-direction: column; gap: 0.7rem; }
  #stage .gapcard.phase-focus { border-left-color: var(--critical); }
  #stage .gapcard.phase-inline { border-left-color: var(--accent); }
  #stage .gapcard.phase-ahead { border-left-color: var(--success); }
  #stage .gapcard-top { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; }
  #stage .gapcard .gi { font-family: var(--font-mono), monospace; font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); }

  #stage .reqtag {
    display: inline-flex; align-items: baseline; gap: 0.35rem; font-family: var(--font-mono), monospace; font-size: 0.68rem;
    letter-spacing: 0.02em; padding: 0.35rem 0.6rem; border: 1px dashed var(--border-strong); border-radius: 0.5rem;
    color: var(--ink-muted); width: fit-content;
  }
  #stage .reqtag b { color: var(--ink); font-weight: 500; }

  #stage .statuspill {
    font-family: var(--font-mono), monospace; font-size: 0.63rem; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 0.22rem 0.55rem; border-radius: 999px; border: 1px solid transparent; flex: none; white-space: nowrap;
  }
  #stage .statuspill[data-cls="todo"] { background: var(--surface-alt); color: var(--ink-muted); border-color: var(--border-strong); }
  #stage .statuspill[data-cls="started"] { background: var(--warning-tint); color: var(--warning); }
  #stage .statuspill[data-cls="progress"] { background: var(--warning-tint); color: var(--warning); }
  #stage .statuspill[data-cls="closing"] { background: var(--accent-tint); color: var(--accent); }
  #stage .statuspill[data-cls="done"] { background: var(--success-tint); color: var(--success); }

  #stage .activity-track { height: 3px; background: var(--surface-alt); border-radius: 999px; overflow: hidden; }
  #stage .activity-fill { height: 100%; background: var(--accent); transition: width .2s ease; }

  #stage .steplist { display: flex; flex-direction: column; gap: 0.55rem; }
  #stage .step { display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; font-size: 0.87rem; }
  #stage .step input[type="checkbox"] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  #stage .step-box {
    flex: none; width: 16px; height: 16px; border: 1.5px solid var(--border-strong); border-radius: 4px;
    margin-top: 0.15rem; position: relative; background: var(--surface);
  }
  #stage .step.checked .step-box { background: var(--success); border-color: var(--success); }
  #stage .step.checked .step-box::after {
    content: ""; position: absolute; left: 4px; top: 1px; width: 4px; height: 8px;
    border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(40deg);
  }
  #stage .step-text { flex: 1; color: var(--ink); line-height: 1.45; }
  #stage .step-days { flex: none; font-family: var(--font-mono), monospace; font-size: 0.66rem; color: var(--ink-faint); white-space: nowrap; margin-top: 0.18rem; }
  #stage .step.locked { opacity: 0.45; cursor: not-allowed; }
  #stage .step.locked .step-text { color: var(--ink-faint); }
  #stage .step input:focus-visible ~ .step-box { outline: 2px solid var(--accent); outline-offset: 2px; }
  #stage .gate-note { font-size: 0.78rem; color: var(--critical); max-width: 32ch; text-align: right; }

  #stage .glabel { font-family: var(--font-mono), monospace; font-size: 0.65rem; letter-spacing: 0.07em; text-transform: uppercase; }
  #stage .glabel.gap { color: var(--critical); }
  #stage .glabel.rec { color: var(--accent); }
  #stage .gtext { font-size: 0.89rem; margin-top: 0.3rem; color: var(--ink); line-height: 1.5; }
  #stage .divider-dash { border-top: 1px dashed var(--border-strong); }

  /* ---------- Scenario ---------- */
  #stage .scenario-prompt { margin-top: 1.1rem; font-size: 1.25rem; line-height: 1.45; max-width: 46ch; color: var(--ink); font-weight: 700; letter-spacing: -0.01em; }
  #stage .sopt {
    width: 100%; text-align: left; padding: 0.85rem 1.05rem; margin-top: 0.65rem; border: 1.5px solid var(--border);
    border-radius: 0.75rem; background: var(--surface); cursor: pointer; font-size: 0.93rem; color: var(--ink);
  }
  #stage .sopt:hover:not(:disabled) { border-color: var(--border-strong); }
  #stage .sopt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #stage .sopt.chosen.best { border-color: var(--success); background: var(--success-tint); }
  #stage .sopt.chosen:not(.best) { border-color: var(--warning); background: var(--warning-tint); }
  #stage .sopt:disabled { cursor: default; }
  #stage .feedback { margin-top: 1.2rem; padding: 1rem 1.15rem; border-radius: 0.75rem; border: 1px solid var(--border); background: var(--surface-alt); }
  #stage .feedback .flabel { font-family: var(--font-mono), monospace; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  #stage .feedback p { margin-top: 0.4rem; font-size: 0.93rem; color: var(--ink); }

  /* ---------- Completion / stamp ---------- */
  #stage .stampwrap { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.5rem 0; }
  #stage .stamp-big {
    width: 108px; height: 108px; border-radius: 50%; border: 3px solid var(--accent); color: var(--accent);
    display: flex; align-items: center; justify-content: center; flex-direction: column;
    font-family: var(--font-mono), monospace; transform: rotate(-4deg);
    animation: stampIn .5s cubic-bezier(.2,1.3,.4,1);
  }
  @media (prefers-reduced-motion: reduce) { #stage .stamp-big { animation: none; } }
  @keyframes stampIn { 0% { opacity: 0; transform: scale(.5) rotate(-14deg); } 60% { opacity: 1; transform: scale(1.08) rotate(2deg); } 100% { opacity: 1; transform: scale(1) rotate(-4deg); } }
  #stage .stamp-big .sn { font-size: 1.35rem; font-weight: 600; }
  #stage .stamp-big .sl { font-size: 0.52rem; letter-spacing: 0.08em; margin-top: 2px; }
  #stage .passport-h { margin-top: 1.4rem; font-size: 1.6rem; }
  #stage .passport-p { margin-top: 0.6rem; color: var(--ink-muted); max-width: 46ch; }
</style>

<script is:inline>
  const TIER_ORDER = ["novice", "dabbling", "intermediate"];

  const THEMES = [
    { id: "adoption", name: "Adoption & Visibility" },
    { id: "policy", name: "Policy & Accountability" },
    { id: "data", name: "Data & Risk Classification" },
    { id: "vendor", name: "Vendor & Model Risk" },
    { id: "competency", name: "Competency & Enablement" },
    { id: "monitoring", name: "Monitoring & Controls" },
    { id: "incident", name: "Incident Response & Compliance" },
    { id: "strategy", name: "Strategic Oversight" }
  ];

  const TIERS = [
    {
      id: "novice",
      index: "01",
      name: "Novice",
      tagline: "AI is arriving whether you've planned for it or not.",
      profile: "Picture a 40-person company. The IT Director just learned three teams are already using free AI tools for client work — nobody asked, nobody's tracking what data goes in.",
      atGlance: [
        "No AI-specific policy or accountable owner exists yet",
        "Little to no visibility into which tools staff already use",
        "Leadership treats AI as an opportunity, not yet as a risk category"
      ],
      gapsByTheme: {
        adoption: { gap: "No one can say which AI tools are actually in use, or by whom.", requires: "Shadow-AI discovery checklist", steps: [
          { text: "Send a short survey to every team lead asking which AI tools they or their team already use.", days: 2, parallel: false },
          { text: "Cross-check responses against expense reports and admin or SSO logs to catch tools nobody reported.", days: 2, parallel: true },
          { text: "Consolidate both sources into a single tracked list with tool name, team, and purpose.", days: 1, parallel: false }
        ]},
