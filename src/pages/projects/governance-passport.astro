  ];

  const state = {
    screen: "intro",
    qIndex: 0,
    answers: new Array(QUESTIONS.length).fill(null),
    placedTier: null,
    themeSignals: {},
    unratedThemes: [],
    stepChecks: {},
    unlockedPhases: 1,
    scenarioChoice: null
  };

  function tier(id) { return TIERS.find(t => t.id === id); }
  function themeById(id) { return THEMES.find(t => t.id === id); }
  function tierIndex(id) { return TIER_ORDER.indexOf(id); }

  function ensureStepChecks(themeId) {
    const key = state.placedTier + ":" + themeId;
    const steps = tier(state.placedTier).gapsByTheme[themeId].steps;
    if (!state.stepChecks[key] || state.stepChecks[key].length !== steps.length) {
      state.stepChecks[key] = steps.map(() => false);
    }
    return state.stepChecks[key];
  }

  function canCheckStep(steps, checks, i) {
    if (i === 0) return true;
    if (steps[i].parallel) return true;
    return checks[i - 1];
  }

  function normalizeChecks(steps, checks) {
    for (let i = 1; i < steps.length; i++) {
      if (!steps[i].parallel && !checks[i - 1]) checks[i] = false;
    }
    return checks;
  }

  function activityStatus(steps, checks) {
    const totalDays = steps.reduce((a, s) => a + s.days, 0);
    const doneDays = steps.reduce((a, s, i) => a + (checks[i] ? s.days : 0), 0);
    const pct = totalDays ? doneDays / totalDays : 0;
    if (pct >= 1) return { label: "Completed", pct: 100, cls: "done" };
    if (pct >= 0.75) return { label: "Progressing toward closure", pct: pct * 100, cls: "closing" };
    if (pct >= 0.5) return { label: "In progress", pct: pct * 100, cls: "progress" };
    if (pct >= 0.15) return { label: "Started", pct: pct * 100, cls: "started" };
    return { label: "Not started", pct: pct * 100, cls: "todo" };
  }

  const SAVE_KEY = "governance-passport-v1";
  function saveState() {
    try { localStorage.setItem(SAVE_KEY, JSON.stringify(state)); } catch (e) { /* storage unavailable */ }
  }
  function loadSavedState() {
    try {
      const raw = localStorage.getItem(SAVE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  }
  function clearSavedState() {
    try { localStorage.removeItem(SAVE_KEY); } catch (e) { /* storage unavailable */ }
  }
  function hasProgress(s) {
    return !!s && (s.screen !== "intro" || (s.answers || []).some(a => a !== null));
  }

  // Options 0-4 are scored maturity levels; 5 = "Don't know", 6 = "Prefer not to answer" (unscored).
  function scoreOf(qi) {
    const idx = state.answers[qi];
    return (idx === null || idx === undefined || idx >= 5) ? null : idx;
  }
  function scoreToTier(avg) {
    if (avg < 4 / 3) return "novice";
    if (avg < 8 / 3) return "dabbling";
    return "intermediate";
  }

  function computeResults() {
    const signals = {};
    const themeAverages = {};
    let sumOfThemeAverages = 0;
    let ratedThemeCount = 0;

    THEMES.forEach((th, ti) => {
      const scores = [];
      for (let k = 0; k < 3; k++) {
        const s = scoreOf(ti * 3 + k);
        if (s !== null) scores.push(s);
      }
      const avg = scores.length ? scores.reduce((a, b) => a + b, 0) / scores.length : null;
      themeAverages[th.id] = avg;
      if (avg !== null) { sumOfThemeAverages += avg; ratedThemeCount++; }
    });

    const overallAvg = ratedThemeCount ? sumOfThemeAverages / ratedThemeCount : 2;
    state.placedTier = scoreToTier(overallAvg);

    THEMES.forEach(th => {
      const avg = themeAverages[th.id];
      signals[th.id] = avg === null ? state.placedTier : scoreToTier(avg);
    });
    state.themeSignals = signals;
    state.unratedThemes = THEMES.filter(th => themeAverages[th.id] === null).map(th => th.id);
    state.unlockedPhases = 1;
  }

  function priorityFor(themeId) {
    const diff = tierIndex(state.themeSignals[themeId]) - tierIndex(state.placedTier);
    if (diff < 0) return "focus";
    if (diff > 0) return "ahead";
    return "inline";
  }

  const PHASE_TITLES = ["Start now", "Next", "Later"];
  const PHASE_PHRASE = {
    focus: "close your biggest gaps",
    inline: "build out the basics",
    ahead: "formalize what's working"
  };
  const PHASE_SUB = {
    focus: "Your answers marked these areas furthest behind your overall stage — the most urgent to close, and mostly documentation and process rather than new infrastructure.",
    inline: "These track with your overall stage. Once the urgent gaps are handled, this is the next layer of structure to put in place.",
    ahead: "These are already ahead of your stage. The work here is less about starting and more about locking in what's already working."
  };

  function phaseBuckets() {
    const buckets = [
      { key: "focus", themes: THEMES.filter(th => priorityFor(th.id) === "focus") },
      { key: "inline", themes: THEMES.filter(th => priorityFor(th.id) === "inline") },
      { key: "ahead", themes: THEMES.filter(th => priorityFor(th.id) === "ahead") }
    ].filter(b => b.themes.length > 0);
    return buckets.map((b, i) => ({
      key: b.key,
      themes: b.themes,
      title: `${PHASE_TITLES[i]}: ${PHASE_PHRASE[b.key].charAt(0).toUpperCase() + PHASE_PHRASE[b.key].slice(1)}`,
      sub: PHASE_SUB[b.key]
    }));
  }

  function phaseComplete(ph) {
    const t = tier(state.placedTier);
    return ph.themes.every(th => {
      const g = t.gapsByTheme[th.id];
      const checks = normalizeChecks(g.steps, ensureStepChecks(th.id));
      return activityStatus(g.steps, checks).cls === "done";
    });
  }

  const stageEl = document.getElementById("stage");
  const stagebadgeEl = document.getElementById("stagebadge");

  function setStage(html) {
    stageEl.innerHTML = html;
    stageEl.classList.remove("anim");
    void stageEl.offsetWidth;
    stageEl.classList.add("anim");
    stageEl.scrollIntoView({ block: "start", behavior: "auto" });
  }

  function renderStageBadge() {
    stagebadgeEl.innerHTML = state.placedTier
      ? `<span class="stagebadge-pill">Your stage: ${tier(state.placedTier).name}</span>`
      : "";
  }

  function renderIntro() {
    const saved = loadSavedState();
    const resumable = hasProgress(saved);
    setStage(`
      <div class="hero">
        <span class="eyebrow">Begin the assessment</span>
        <h1>Chart your organization's AI governance maturity.</h1>
        <p class="lede">24 questions across 8 themes place you at one of three stages. From there, you'll see a roadmap built for your organization alone — what's furthest behind, what's already ahead, and what to do about each.</p>
        <p class="meta">24 questions · 8 themes · about 6 minutes · you can go back and change any answer</p>
      </div>
      ${resumable ? `
        <div class="resume-banner">
          <div>
            <div class="resume-title">You have an assessment in progress.</div>
            <div class="resume-sub">${saved.screen === "quiz" ? `Question ${saved.qIndex + 1} of ${QUESTIONS.length}` : saved.placedTier ? `Placed as ${tier(saved.placedTier).name} — roadmap in progress` : "Progress saved"}</div>
          </div>
          <div class="resume-actions">
            <button class="btn btn-ghost" id="startover">Start over</button>
            <button class="btn btn-primary" id="resume">Resume</button>
          </div>
        </div>
      ` : ""}
      <div class="route">
        ${TIERS.map(t => `<div class="route-card"><div class="ri">STAGE ${t.index}</div><div class="rn">${t.name}</div><div class="rt">${t.tagline}</div></div>`).join("")}
      </div>
      <p class="route-note">You'll only see the results and roadmap for the stage that matches your answers. Your progress is saved automatically in this browser, so you can pick up later.</p>
      <div class="actions">
        <button class="btn btn-primary" id="start">${resumable ? "Start a new assessment" : "Begin assessment"}</button>
      </div>
    `);
    if (resumable) {
      document.getElementById("resume").addEventListener("click", () => {
        Object.assign(state, saved);
        render();
      });
      document.getElementById("startover").addEventListener("click", () => {
        clearSavedState();
        render();
      });
    }
    document.getElementById("start").addEventListener("click", () => {
      clearSavedState();
      Object.assign(state, {
        screen: "quiz", qIndex: 0,
        answers: new Array(QUESTIONS.length).fill(null),
        placedTier: null, themeSignals: {}, unratedThemes: [],
        stepChecks: {}, unlockedPhases: 1, scenarioChoice: null
      });
      render();
    });
  }

  function renderQuiz() {
    const qi = state.qIndex;
    const q = QUESTIONS[qi];
    const currentThemeIdx = Math.floor(qi / 3);
    const themeNum = currentThemeIdx + 1;
    const th = themeById(q.theme);
    const selected = state.answers[qi];
    const pct = Math.round((qi / QUESTIONS.length) * 100);

    const railHTML = THEMES.map((rt, i) => {
      const firstQ = i * 3;
      let cls = "upcoming";
      if (i === currentThemeIdx) cls = "current";
      else if (i < currentThemeIdx) cls = "done";
      const clickable = cls === "done";
      return `<button class="themerail-item ${cls}" ${clickable ? `data-jump="${firstQ}"` : "disabled"}>
        <span class="tri-num">${String(i + 1).padStart(2, "0")}</span>
        <span class="tri-name">${rt.name}</span>
        ${cls === "done" ? `<span class="tri-check">✓</span>` : ""}
      </button>`;
    }).join("");

    setStage(`
      <div class="quizlayout">
        <nav class="themerail" aria-label="Assessment themes">${railHTML}</nav>
        <div class="quizmain">
          <div class="qmeta">
            <span class="eyebrow">Theme ${themeNum} of ${THEMES.length} · ${th.name}</span>
            <span class="qcounter">Question ${qi + 1} of ${QUESTIONS.length}</span>
          </div>
          <div class="progressbar-track"><div class="progressbar-fill" style="width:${pct}%"></div></div>
          <h2 class="qtext">${q.q}</h2>
          <div class="options" id="opts">
            ${q.opts.map((t, i) => `<button class="opt ${selected === i ? "sel" : ""}" data-i="${i}"><span class="mark"></span><span>${t}</span></button>`).join("")}
            <div class="opt-divider"></div>
            ${SKIP_OPTIONS.map((t, k) => { const i = q.opts.length + k; return `<button class="opt skip ${selected === i ? "sel" : ""}" data-i="${i}"><span class="mark"></span><span>${t}</span></button>`; }).join("")}
          </div>
          <div class="actions split">
            <button class="btn btn-ghost" id="back" ${qi === 0 ? "disabled" : ""}>Back</button>
            <button class="btn btn-primary" id="next" ${selected === null ? "disabled" : ""}>${qi === QUESTIONS.length - 1 ? "See results" : "Next"}</button>
          </div>
        </div>
      </div>
    `);
    document.querySelectorAll(".themerail-item[data-jump]").forEach(btn => {
      btn.addEventListener("click", () => {
        state.qIndex = parseInt(btn.getAttribute("data-jump"), 10);
        render();
      });
    });
    const nextBtn = document.getElementById("next");
    document.querySelectorAll(".opt").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".opt").forEach(b => b.classList.remove("sel"));
        btn.classList.add("sel");
        state.answers[qi] = parseInt(btn.getAttribute("data-i"), 10);
        nextBtn.disabled = false;
      });
    });
    document.getElementById("back").addEventListener("click", () => {
      if (qi === 0) return;
      state.qIndex--;
      render();
    });
    nextBtn.addEventListener("click", () => {
      if (state.answers[qi] === null) return;
      if (qi < QUESTIONS.length - 1) {
        state.qIndex++;
        render();
      } else {
        computeResults();
        state.screen = "briefing";
        render();
      }
    });
  }

  function renderBriefing() {
    const t = tier(state.placedTier);
    setStage(`
      <span class="eyebrow">Your placement</span>
      <h2 class="stagename">${t.name}</h2>
      <p class="tagline">${t.tagline}</p>
      <div class="profile">${t.profile}</div>
      <div class="fieldnotes">
        <div class="fn-title">At a glance</div>
        <ul>${t.atGlance.map(n => `<li>${n}</li>`).join("")}</ul>
      </div>
      <div class="actions">
        <button class="btn btn-primary" id="toroadmap">See your roadmap</button>
      </div>
    `);
    document.getElementById("toroadmap").addEventListener("click", () => {
      state.screen = "roadmap";
      render();
    });
  }

  function renderRoadmap() {
    const t = tier(state.placedTier);
    const phases = phaseBuckets();
    const unlockedCount = Math.min(state.unlockedPhases, phases.length);
    const visiblePhases = phases.slice(0, unlockedCount);
    const hasMore = unlockedCount < phases.length;
    const currentPhaseDone = visiblePhases.length ? phaseComplete(visiblePhases[visiblePhases.length - 1]) : true;
    const leadIn = phases.length
      ? `Phase 1 starts with ${phases[0].themes.map(th => th.name).join(", ")}. Later phases stay hidden until you get there.`
      : "Every area is tracking together — work through the list in any order.";

    function cardHTML(th, phaseKey) {
      const g = t.gapsByTheme[th.id];
      const steps = g.steps;
      const key = state.placedTier + ":" + th.id;
      const checks = normalizeChecks(steps, ensureStepChecks(th.id));
      const status = activityStatus(steps, checks);
      const totalDays = steps.reduce((a, s) => a + s.days, 0);
      return `
      <div class="gapcard phase-${phaseKey}">
        <div class="gapcard-top">
          <span class="gi">${th.name}</span>
          <span class="statuspill" data-cls="${status.cls}">${status.label}</span>
        </div>
        <div class="activity-track"><div class="activity-fill" style="width:${status.pct}%"></div></div>
        <div>
          <div class="glabel gap">Gap</div>
          <div class="gtext">${g.gap}</div>
        </div>
        <div class="divider-dash"></div>
        <div>
          <div class="glabel rec">Recommended steps · ${totalDays % 1 === 0 ? totalDays : totalDays.toFixed(1)} day${totalDays === 1 ? "" : "s"} total</div>
          <div class="steplist">
            ${steps.map((s, i) => {
              const unlocked = canCheckStep(steps, checks, i);
              const checked = checks[i];
              const dayLabel = s.days === 0.5 ? "0.5 day" : `${s.days} day${s.days === 1 ? "" : "s"}`;
              return `<label class="step ${checked ? "checked" : ""} ${!unlocked ? "locked" : ""}">
                <input type="checkbox" data-key="${key}" data-i="${i}" ${checked ? "checked" : ""} ${!unlocked ? "disabled" : ""}>
                <span class="step-box"></span>
                <span class="step-text">${s.text}</span>
                <span class="step-days">${dayLabel}${s.parallel ? " · parallel-ok" : ""}</span>
              </label>`;
            }).join("")}
          </div>
        </div>
        <span class="reqtag">Needs: <b>${g.requires}</b></span>
      </div>`;
    }

    setStage(`
      <span class="eyebrow">Your roadmap · ${t.name}</span>
      <h2 class="stagename" style="font-size:1.7rem;margin-top:0.4rem;">A phased plan, built from your answers</h2>
      <div class="qb-summary">
        <span class="qlabel">${leadIn}</span>
        <span class="qcount">Status updates automatically as you check off steps · progress is saved in this browser</span>
      </div>
      ${visiblePhases.map((ph, i) => `
        <section class="phase">
          <div class="phase-head ${ph.key}">
            <span class="peyebrow">Phase ${i + 1} of ${phases.length}</span>
            <h3>${ph.title}</h3>
            <p class="phase-sub">${ph.sub}</p>
          </div>
          <div class="gapgrid">
            ${ph.themes.map(th => cardHTML(th, ph.key)).join("")}
          </div>
        </section>
      `).join("")}
      <div class="actions split" style="align-items:center;">
        <button class="btn btn-ghost" id="back">Back to your placement</button>
        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.4rem;">
          ${!currentPhaseDone ? `<span class="gate-note">Complete every activity in Phase ${unlockedCount} to continue.</span>` : ""}
          ${hasMore
            ? `<button class="btn btn-primary" id="unlockphase" ${currentPhaseDone ? "" : "disabled"}>Continue to Phase ${unlockedCount + 1}</button>`
            : `<button class="btn btn-primary" id="toscenario" ${currentPhaseDone ? "" : "disabled"}>Continue to field test</button>`}
        </div>
      </div>
    `);

    document.querySelectorAll(".steplist input[type=checkbox]").forEach(cb => {
      cb.addEventListener("change", () => {
        const key = cb.getAttribute("data-key");
        const i = parseInt(cb.getAttribute("data-i"), 10);
        state.stepChecks[key][i] = cb.checked;
        renderRoadmap();
        saveState();
      });
    });
    document.getElementById("back").addEventListener("click", () => { state.screen = "briefing"; render(); });
    if (hasMore) {
      const btn = document.getElementById("unlockphase");
      if (currentPhaseDone) btn.addEventListener("click", () => { state.unlockedPhases = unlockedCount + 1; render(); });
    } else {
      const btn = document.getElementById("toscenario");
      if (currentPhaseDone) btn.addEventListener("click", () => { state.screen = "scenario"; render(); });
    }
  }

  function renderScenario() {
    const t = tier(state.placedTier);
    const chosen = state.scenarioChoice;
    setStage(`
      <span class="eyebrow">Field test</span>
      <p class="scenario-prompt">${t.scenario.prompt}</p>
      <div id="sopts">
        ${t.scenario.options.map((o, i) => `
          <button class="sopt ${chosen === i ? "chosen " + (o.best ? "best" : "") : ""}" data-i="${i}" ${chosen !== null ? "disabled" : ""}>${o.text}</button>
        `).join("")}
      </div>
      <div id="fbwrap">${chosen !== null ? feedbackHTML(t, chosen) : ""}</div>
      <div class="actions split">
        <button class="btn btn-ghost" id="back">Back to roadmap</button>
        <button class="btn btn-primary" id="tostamp" ${chosen === null ? "disabled" : ""}>Continue</button>
      </div>
    `);
    function feedbackHTML(t, i) {
      const o = t.scenario.options[i];
      return `<div class="feedback">
        <div class="flabel">${o.best ? "Strong move" : "Worth reconsidering"}</div>
        <p>${o.feedback}</p>
      </div>`;
    }
    document.querySelectorAll(".sopt").forEach(btn => {
      btn.addEventListener("click", () => {
        if (state.scenarioChoice !== null) return;
        state.scenarioChoice = parseInt(btn.getAttribute("data-i"), 10);
        render();
      });
    });
    document.getElementById("back").addEventListener("click", () => { state.screen = "roadmap"; render(); });
    document.getElementById("tostamp").addEventListener("click", () => {
      if (state.scenarioChoice === null) return;
      state.screen = "complete";
      render();
    });
  }

  function renderComplete() {
    const t = tier(state.placedTier);
    setStage(`
      <div class="stampwrap">
        <div class="stamp-big"><span class="sn">✓</span><span class="sl">ASSESSED</span></div>
        <h2 class="passport-h">Assessment complete: ${t.name}</h2>
        <p class="passport-p">Your roadmap is logged and ready to share. Treat this as a baseline — reassess in a quarter or two as your program matures, and the picture will shift with it.</p>
      </div>
      <div class="actions" style="justify-content:center; gap:1rem;">
        <button class="btn btn-ghost" id="revisit">Revisit your roadmap</button>
        <button class="btn btn-primary" id="restart">Retake assessment</button>
      </div>
    `);
    document.getElementById("revisit").addEventListener("click", () => { state.screen = "roadmap"; render(); });
    document.getElementById("restart").addEventListener("click", () => {
      clearSavedState();
      Object.assign(state, {
        screen: "intro", qIndex: 0,
        answers: new Array(QUESTIONS.length).fill(null),
        placedTier: null, themeSignals: {}, unratedThemes: [],
        stepChecks: {}, unlockedPhases: 1, scenarioChoice: null
      });
      render();
    });
  }

  function render() {
    renderStageBadge();
    if (state.screen === "intro") renderIntro();
    else if (state.screen === "quiz") renderQuiz();
    else if (state.screen === "briefing") renderBriefing();
    else if (state.screen === "roadmap") renderRoadmap();
    else if (state.screen === "scenario") renderScenario();
    else if (state.screen === "complete") renderComplete();
    saveState();
  }

  render();
</script>
