<script>
  // ===================================================================
  // Microsoft Certification Path Finder — browser logic.
  // Astro bundles this <script> (it isn't is:inline), so it can import the
  // same data file the page uses at build time.
  // ===================================================================
  import { CERTS, SKILLS, VALUE, PARTNER, PARTNER_LINKS, DOMAINS, ROLES, PAGE, isNew } from "../../data/ms-certifications.js";

/* A7. QUESTIONS — the decision tree. options(answers) returns the choices,
   so later questions can depend on earlier answers. A question with only
   one possible option is answered automatically and skipped.           */
const QUESTIONS = [
  { key: "track", title: "Which track describes you best?", sub: "This shapes everything that follows.",
    options: () => [
      { value: "technical",  icon: "🛠️", label: "Technical", desc: "I build, configure, code, secure or administer systems." },
      { value: "functional", icon: "🧩", label: "Functional", desc: "I translate business processes into solutions — consultant, analyst, product owner." },
      { value: "business",   icon: "📣", label: "Business / leadership", desc: "I use technology or lead teams and strategy rather than implement it." },
    ] },
  { key: "domain", title: "Which area excites you most?", sub: "Pick the world you want to be known for.",
    options: (a) => Object.entries(DOMAINS).filter(([, d]) => d.tracks.includes(a.track))
      .map(([value, d]) => ({ value, icon: d.icon, label: d.label, desc: d.desc })) },
  { key: "depth", title: "Go broad or go deep?", sub: "Generalists cover the whole area; specialists own one niche.",
    options: (a) => {
      const depths = new Set(rolesFor(a.track, a.domain).map(r => r.depth));   // depths that exist here
      return [
        { value: "broad", icon: "🌍", label: "Broad — generalist", desc: "A widely recognised path that covers the whole area." },
        { value: "deep",  icon: "🎯", label: "Deep — specialist", desc: "A focused niche that sets you apart." },
      ].filter(o => depths.has(o.value));
    } },
  { key: "role", title: "Which role do you see yourself in?", sub: "Your recommended certification comes from this choice.",
    options: (a) => {
      let list = rolesFor(a.track, a.domain);
      const narrowed = list.filter(r => r.depth === a.depth);
      if (narrowed.length) list = narrowed;
      return list.map(r => ({ value: r.id, icon: r.icon, label: r.label, desc: r.desc, ladder: r.ladder }));
    } },
  { key: "exp", title: "How much hands-on experience do you have here?", sub: "We'll pick the right rung of the ladder for you.",
    options: (a) => {
      const role = ROLES.find(r => r.id === a.role);
      if (!role || role.ladder.length < 2) return [{ value: "new", label: "—" }];
      return [
        { value: "new",  icon: "🌱", label: "New to it", desc: "Under a year, or switching careers." },
        { value: "some", icon: "🌿", label: "Some experience", desc: "1–3 years of hands-on work." },
        { value: "pro",  icon: "🌳", label: "Seasoned", desc: "3+ years; I lead or design solutions." },
      ];
    } },
];




/* =====================================================================
   PART B — THE LOGIC
   ===================================================================== */

const TODAY = new Date();          // used to count down to retirements
const DAY_MS = 86400000;           // milliseconds in one day
const LEARN = "https://learn.microsoft.com/en-us";
const CERT_BY_CODE = Object.fromEntries(CERTS.map(c => [c.code, c]));   // quick lookup by code

let answers = {};     // the person's answers so far
let qIndex = 0;       // which question we're on
let trail = [];       // past answers, for the Back button (not "history": that name is the browser's)
let xp = 0;           // gamification points

/* ---------- Helpers ---------- */
function $(id) { return document.getElementById(id); }
function rolesFor(track, domain) { return ROLES.filter(r => r.domain === domain && r.tracks.includes(track)); }

// Whole days until retirement (null if none). The retirement day itself still counts as open.
function daysLeft(cert) {
  if (!cert.retire) return null;
  return Math.ceil((new Date(cert.retire + "T23:59:59") - TODAY) / DAY_MS);
}
function isOpen(cert) { const d = daysLeft(cert); return d === null || d >= 0; }
function fmtDate(iso) { return new Date(iso + "T00:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); }
function esc(s) { return String(s).replace(/[&<>"']/g, ch => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch])); }
function levelLabel(l) { return l === "Business" ? "Business pro" : l; }

// Build all links for one certification
function linksFor(cert) {
  const lc = cert.code.toLowerCase();
  const study = `${LEARN}/credentials/certifications/resources/study-guides/${lc}`;
  return {
    // Official course page (holds the self-paced learning paths); search page as fallback
    learn: cert.course === false ? `${LEARN}/training/browse/?terms=${encodeURIComponent(cert.code)}` : `${LEARN}/training/courses/${lc}t00`,
    // Official page with the "Schedule exam" button; study guide if no page exists yet
    exam: cert.page ? `${LEARN}/credentials/certifications/${cert.page}` : study,
    study,
    practice: `${LEARN}/credentials/certifications/practice-assessments-for-microsoft-certifications`,
    pearson: "https://home.pearsonvue.com/microsoft",
  };
}

// Status pills: level, retirement countdown, partner credit
function pillsFor(cert) {
  let html = `<span class="pill lv-${cert.level}">${levelLabel(cert.level)}</span>`;
  const d = daysLeft(cert);
  if (d !== null && d >= 0) html += ` <span class="pill ${d <= 30 ? "danger" : "warn"}">⚠ Retires ${fmtDate(cert.retire)} · ${d} day${d === 1 ? "" : "s"} left</span>`;
  if (cert.beta) html += ` <span class="pill beta">Beta</span>`;
  if (isNew(cert)) html += ` <span class="pill new">New</span>`;
  if (PARTNER[cert.code]) html += ` <span class="pill partner">Partner credit</span>`;
  return html;
}

// Middle of a range like "25–30" → 27.5 (used for bar length)
function midWeight(range) { const [a, b] = range.split("–").map(Number); return (a + b) / 2; }

/* ---------- Screens ---------- */
function show(id) {
  document.querySelectorAll(".screen").forEach(s => s.classList.toggle("active", s.id === id));
  $("navQuest").classList.toggle("on", id !== "scrAll");
  $("navAll").classList.toggle("on", id === "scrAll");
  const top = $("cq").getBoundingClientRect().top + window.scrollY - 16;
  if (window.scrollY > top) window.scrollTo({ top });   // only scroll up to the tool if we're below it
}

/* ---------- XP ---------- */
function addXP(amount, x, y) {
  xp += amount;
  $("xpLevel").textContent = `LVL ${Math.floor(xp / 100) + 1}`;   // 100 XP per level
  $("xpFill").style.width = (xp % 100) + "%";
  $("xpPts").textContent = `${xp} XP`;
  if (x !== undefined) {
    const pop = document.createElement("div");
    pop.className = "xp-pop"; pop.textContent = `+${amount} XP`;
    pop.style.left = x + "px"; pop.style.top = y + "px";
    document.body.appendChild(pop);
    setTimeout(() => pop.remove(), 900);
  }
}

/* ---------- Decision tree ---------- */
function startQuest() { answers = {}; qIndex = 0; trail = []; show("scrQuiz"); renderQuestion(); }

function renderQuestion() {
  if (qIndex >= QUESTIONS.length) { renderResult(); return; }
  const q = QUESTIONS[qIndex];
  const opts = q.options(answers);
  if (opts.length === 1) { answers[q.key] = opts[0].value; qIndex++; renderQuestion(); return; }   // auto-skip

  $("steps").innerHTML = QUESTIONS.map((_, i) => `<i class="${i < qIndex ? "done" : ""}"></i>`).join("");
  $("backBtn").style.visibility = trail.length ? "visible" : "hidden";
  $("qTitle").textContent = q.title;
  $("qSub").textContent = q.sub;
  $("qOptions").innerHTML = opts.map(o => {
    const hint = o.ladder ? `<div class="pill info" style="margin-top:8px;white-space:normal">Path: ${o.ladder.join(" → ")}</div>` : "";
    return `<button class="opt" type="button" data-v="${esc(o.value)}">
              <span class="ico">${o.icon || ""}</span>
              <span><h4>${esc(o.label)}</h4><p>${esc(o.desc || "")}</p>${hint}</span>
            </button>`;
  }).join("");
  $("qOptions").querySelectorAll(".opt").forEach(btn => btn.addEventListener("click", (e) => {
    trail.push({ qIndex, answers: { ...answers } });     // remember for Back
    answers[q.key] = btn.dataset.v;
    addXP(20, e.clientX, e.clientY);
    qIndex++;
    renderQuestion();
  }));
}
function goBack() { const prev = trail.pop(); if (!prev) return; qIndex = prev.qIndex; answers = prev.answers; renderQuestion(); }

// Pick the ladder rung by experience (skipping anything already retired)
function pickFromLadder(ladder, exp) {
  const open = ladder.filter(code => CERT_BY_CODE[code] && isOpen(CERT_BY_CODE[code]));
  if (!open.length) return null;
  let i = 0;
  if (exp === "some") i = Math.min(1, open.length - 1);
  if (exp === "pro") i = open.length - 1;
  return open[i];
}

/* ---------- Result sections (each returns HTML) ---------- */

// Quick facts: job roles, renewal, prerequisite, exam weighting summary
function factsHtml(cert) {
  const facts = [];
  facts.push(["Job roles (Microsoft)", cert.roles ? esc(cert.roles) : "Not listed on the certification page"]);
  // Microsoft's study guides state: associate, expert and specialty certifications
  // expire annually and renew via a free online assessment.
  const annual = cert.renew || ["Associate", "Expert", "Specialty"].includes(cert.level);
  facts.push(["Renewal", annual ? "Every 12 months — free online renewal assessment" :
    (cert.level === "Fundamentals" ? "Fundamentals certifications don't expire" : "See the certification page")]);
  facts.push(["Prerequisite", cert.prereq ? esc(cert.prereq) : "None required"]);
  return `<div class="facts">${facts.map(([k, v]) => `<div class="fact"><small>${k}</small><span>${v}</span></div>`).join("")}</div>`;
}

// Skills you'll gain: one expandable row per official exam domain
function skillsHtml(cert, L) {
  const s = SKILLS[cert.code];
  if (!s) return `<p class="partner-none">Skills outline not available yet — see the study guide.</p>`;
  const max = Math.max(...s.map(([, w]) => midWeight(w)));          // scale bars to the biggest domain
  const rows = s.map(([name, w, subs], i) => `
    <details class="skill"${i === 0 ? " open" : ""}>
      <summary>
        <span class="nm">${esc(name)}</span>
        <span class="wbar"><span class="track"><span class="w" style="width:${(midWeight(w) / max * 100).toFixed(0)}%"></span></span><em>${w}%</em></span>
      </summary>
      ${subs.length ? `<ul>${subs.map(x => `<li>${esc(x)}</li>`).join("")}</ul>` : `<ul><li>See the study guide for detailed tasks.</li></ul>`}
    </details>`).join("");
  return rows + `<div class="src">Source: <a href="${L.study}" target="_blank" rel="noopener">Microsoft Learn study guide for ${cert.code}</a> · % = share of exam questions.</div>`;
}

// Value for clients and for internal teams
function valueHtml(cert) {
  const v = VALUE[cert.code];
  if (!v) return "";
  const list = (arr) => `<ul>${arr.map(x => `<li>${esc(x)}</li>`).join("")}</ul>`;
  return `<div class="value-grid">
      <div class="value client"><h4>For clients</h4>${list(v.client)}</div>
      <div class="value team"><h4>For internal teams</h4>${list(v.team)}</div>
    </div>
    <div class="src">Practitioner perspective based on the skills measured — not a Microsoft statement.</div>`;
}

// Partner & practice value
function partnerHtml(cert) {
  const p = PARTNER[cert.code];
  if (!p) return `<div class="partner-box"><p class="partner-none">Not currently listed in the skilling requirements of Microsoft's six Solutions Partner designations (checked Oct 2026). It still builds capability — it just doesn't add partner points today.</p></div>`;
  const rows = p.map(x => `
    <div class="partner-row">
      <span class="ptype ${x.t}">${x.t === "points" ? "EARNS POINTS" : "REQUIRED STEP"}</span>
      <div><b><a href="${PARTNER_LINKS[x.d]}" target="_blank" rel="noopener" style="color:inherit">Solutions Partner for ${esc(x.d)}</a></b><span>${esc(x.m)}</span></div>
    </div>`).join("");
  return `<div class="partner-box">${rows}</div>
    <div class="src">“Required step” certifications don't score on their own but must be in place before other certifications earn points. Each person counts once per metric. Source: Microsoft Partner Center Solutions Partner pages.</div>`;
}

/* ---------- The result screen ---------- */
function renderResult(pickedCode) {
  const role = ROLES.find(r => r.id === answers.role);
  const code = pickedCode || pickFromLadder(role.ladder, answers.exp);
  const cert = CERT_BY_CODE[code];
  const L = linksFor(cert);
  const lvcol = { Fundamentals: "var(--good)", Associate: "var(--assoc)", Expert: "var(--expert)", Specialty: "var(--spec)", Business: "var(--biz)", GitHub: "var(--gh)" }[cert.level];

  const expText = role.ladder.length < 2 ? "it is the core certification for that role"
    : ({ new: "you're starting out", some: "you already have hands-on experience", pro: "you're seasoned in this area" }[answers.exp] || "it fits your goal");
  const why = pickedCode ? "You chose this step from your roadmap." : `Because you picked <b>${esc(role.label)}</b> and ${expText}, this is your best next step.`;

  // Alerts: retirement, notes
  let alerts = "";
  const d = daysLeft(cert);
  if (d !== null && d >= 0) alerts += `<div class="alert ${d <= 30 ? "danger" : ""}">⚠ <b>Retiring soon:</b> this exam closes on <b>${fmtDate(cert.retire)}</b> — ${d} day${d === 1 ? "" : "s"} left. After that the certification can no longer be earned.</div>`;
  if (cert.beta && !/beta/i.test(cert.note || "")) alerts += `<div class="alert info">ℹ This exam is in beta: results arrive a few weeks after you sit it, and the content may still change.</div>`;
  if (cert.note) alerts += `<div class="alert info">ℹ ${esc(cert.note)}</div>`;

  // Roadmap ladder
  const road = role.ladder.map((c, i) => {
    const ct = CERT_BY_CODE[c];
    return `<div class="node">
              <button class="card ${c === code ? "here" : ""}" type="button" data-code="${c}">
                <span class="here-tag" ${c === code ? "" : `style="color:var(--muted)"`}>${c === code ? "★ YOUR NEXT STEP" : `STEP ${i + 1}`}</span>
                <b>${c}</b><span class="n">${esc(ct.name)}</span>
                <div class="pills">${pillsFor(ct)}</div>
              </button>
            </div>${i < role.ladder.length - 1 ? `<div class="arrow">→</div>` : ""}`;
  }).join("");

  // Side quests: other roles in the same area that fit this track
  const alts = ROLES.filter(r => r.domain === role.domain && r.id !== role.id && r.tracks.includes(answers.track))
    .map(r => pickFromLadder(r.ladder, answers.exp))
    .filter((c, i, arr) => c && c !== code && arr.indexOf(c) === i).slice(0, 6);

  $("scrResult").innerHTML = `
    <div class="result-top">
      <div class="badge-wrap"><div class="badge" style="--lvcol:${lvcol}">
        <div class="inner"><div class="lvl">${levelLabel(cert.level)}</div><div class="code">${code}</div><div class="lvl" style="color:var(--muted)">Unlocked</div></div>
      </div></div>
      <div>
        <div class="eyebrow">Badge unlocked · Your recommended certification</div>
        <h2>${esc(cert.name)}</h2>
        <p class="why">${why}</p>
        <div class="pills">${pillsFor(cert)}</div>
        ${alerts}
      </div>
    </div>

    <nav class="jump" aria-label="Jump to section">
      <a href="#s-go">Learn & book</a><a href="#s-skills">Skills</a><a href="#s-value">Value</a><a href="#s-partner">Partner credit</a><a href="#s-map">Quest map</a>
    </nav>

    <h3 class="sec" id="s-go">Learn & book</h3>
    <div class="actions">
      <a class="action" href="${L.learn}" target="_blank" rel="noopener">
        <div class="tag">STEP A · LEARN</div><h4>Learning path</h4>
        <p>${cert.course === false ? `Microsoft Learn training matching ${code}.` : `Official ${code} course page with its free self-paced learning paths.`}</p>
        <div class="go">Open learning path ↗</div>
      </a>
      <a class="action" href="${L.exam}" target="_blank" rel="noopener">
        <div class="tag">STEP B · BOOK</div><h4>Schedule the exam</h4>
        <p>${cert.page ? "Official page — choose “Schedule exam” to book online or at a test centre via Pearson VUE." : "No booking page yet — the official study guide shows exam details as they're published."}</p>
        <div class="go">${cert.page ? "Go to exam page ↗" : "Open study guide ↗"}</div>
      </a>
    </div>
    <div class="minor-links">Also useful: <a href="${L.study}" target="_blank" rel="noopener">Study guide</a>
      <a href="${L.practice}" target="_blank" rel="noopener">Free practice assessments</a>
      <a href="${L.pearson}" target="_blank" rel="noopener">Pearson VUE for Microsoft</a></div>
    <div style="margin-top:14px">${factsHtml(cert)}</div>

    <h3 class="sec" id="s-skills">Skills you'll gain</h3>
    <p class="sec-sub">The official skills measured on the exam. Tap a domain to see the tasks inside it.</p>
    ${skillsHtml(cert, L)}

    <h3 class="sec" id="s-value">Why it matters</h3>
    <p class="sec-sub">What this certification lets you do for clients — and for your own organisation.</p>
    ${valueHtml(cert)}

    <h3 class="sec" id="s-partner">Partner & practice value</h3>
    <p class="sec-sub">Does it count toward a Microsoft Solutions Partner designation? Useful for practice leads planning team skilling.</p>
    ${partnerHtml(cert)}

    <h3 class="sec" id="s-map">Your quest map</h3>
    <p class="sec-sub">The full ladder for <b>${esc(role.label)}</b>. Tap any step to switch your target.</p>
    <div class="road">${road}</div>

    ${alts.length ? `<h3 class="sec">Side quests in the same area</h3><p class="sec-sub">Other active certifications that suit your track.</p>
      <div class="grid">${alts.map(certCard).join("")}</div>` : ""}

    <div style="margin-top:34px;display:flex;gap:12px;flex-wrap:wrap">
      <button class="btn" type="button" id="againBtn">↺ Start a new quest</button>
      <button class="btn ghost" type="button" id="shareBtn">🔗 Copy link to this result</button>
      <button class="btn ghost" type="button" id="browseBtn">Browse all certifications</button>
    </div>`;

  // Wire up buttons inside the result
  $("scrResult").querySelectorAll("[data-code]").forEach(b => b.addEventListener("click", () => {
    const c = b.dataset.code;
    if (!role.ladder.includes(c)) {                       // side quest → switch to its own role
      const other = ROLES.find(r => r.domain === role.domain && r.ladder.includes(c));
      if (other) answers.role = other.id;
    }
    renderResult(c);
  }));
  $("againBtn").addEventListener("click", startQuest);
  $("browseBtn").addEventListener("click", () => { renderAll(); show("scrAll"); });

  // Put the result in the address bar (e.g. …#open-az-104) so it can be shared.
  // replaceState changes the URL without reloading or adding a Back step.
  const shareUrl = location.href.split("#")[0] + "#open-" + code.toLowerCase();
  try { history.replaceState(null, "", shareUrl); } catch (e) { /* some preview frames block this */ }
  $("shareBtn").addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(shareUrl); $("shareBtn").textContent = "✓ Link copied"; }
    catch (e) { prompt("Copy this link:", shareUrl); }          // fallback if clipboard is blocked
  });

  show("scrResult");
  if (!pickedCode) { addXP(100); launchConfetti(); }   // reward the first unlock only
}

function certCard(code) {
  const c = CERT_BY_CODE[code];
  return `<button class="cert ${daysLeft(c) !== null ? "retiring" : ""}" type="button" data-code="${code}">
            <div class="row"><b>${code}</b><span style="font-size:18px">${DOMAINS[c.domain].icon}</span></div>
            <div class="n">${esc(c.name)}</div>
            <div class="pills">${pillsFor(c)}</div>
          </button>`;
}

/* ---------- Catalog ---------- */
function setupFilters() {
  $("fDomain").innerHTML = `<option value="">All areas</option>` + Object.entries(DOMAINS).map(([k, d]) => `<option value="${k}">${d.label}</option>`).join("");
  $("fLevel").innerHTML = `<option value="">All levels</option>` + ["Fundamentals", "Associate", "Expert", "Specialty", "Business", "GitHub"].map(l => `<option value="${l}">${levelLabel(l)}</option>`).join("");
  const designations = Object.keys(PARTNER_LINKS);
  $("fPartner").innerHTML = `<option value="">Any partner credit</option>` + designations.map(d => `<option value="${d}">${d}</option>`).join("");
  ["fSearch", "fDomain", "fLevel", "fPartner", "fRetiring"].forEach(id => $(id).addEventListener("input", renderAll));
}

function renderAll() {
  const term = $("fSearch").value.trim().toLowerCase();
  const dom = $("fDomain").value, lvl = $("fLevel").value, par = $("fPartner").value, onlyRet = $("fRetiring").checked;
  // The search also looks inside the official skill domains and sub-skills
  const haystack = (c) => (c.code + " " + c.name + " " + JSON.stringify(SKILLS[c.code] || "")).toLowerCase();
  const list = CERTS.filter(isOpen)
    .filter(c => !term || haystack(c).includes(term))
    .filter(c => !dom || c.domain === dom)
    .filter(c => !lvl || c.level === lvl)
    .filter(c => !par || (PARTNER[c.code] || []).some(x => x.d === par))
    .filter(c => !onlyRet || daysLeft(c) !== null);
  $("fCount").textContent = `${list.length} certification${list.length === 1 ? "" : "s"}`;
  $("allGrid").innerHTML = list.map(c => certCard(c.code)).join("");
  $("allGrid").querySelectorAll("[data-code]").forEach(b => b.addEventListener("click", () => openCert(b.dataset.code)));
}

// Open any certification directly (from the catalog or ticker)
function openCert(code) {
  let role = ROLES.find(r => r.ladder.includes(code));
  if (!role) {                                   // e.g. a certification the monthly refresh just added
    const c = CERT_BY_CODE[code];
    role = { id: "auto-" + code, domain: c.domain, depth: "broad", tracks: ["technical", "functional", "business"],
             icon: "✨", label: c.name, desc: "", ladder: [code] };
    ROLES.push(role);
  }
  answers = { track: role.tracks[0], domain: role.domain, depth: role.depth, role: role.id, exp: "some" };
  renderResult(code);
}

/* ---------- Ticker + home stats ---------- */
function setupTicker() {
  const soon = CERTS.filter(c => { const d = daysLeft(c); return d !== null && d >= 0; }).sort((a, b) => daysLeft(a) - daysLeft(b));
  if (!soon.length) return;
  const first = soon[0];
  $("ticker").innerHTML = `⚠ Retiring soon: <b>${first.code} · ${esc(first.name)}</b> closes ${fmtDate(first.retire)} (${daysLeft(first)} days left)` +
    (soon.length > 1 ? ` + ${soon.length - 1} more` : "") + `<button type="button" id="tickBtn">See details</button>`;
  $("ticker").hidden = false;
  $("tickBtn").addEventListener("click", () => openCert(first.code));
}
function setupStats() {
  const open = CERTS.filter(isOpen);
  const stats = [
    [open.length, "active certifications"],
    [ROLES.length, "role paths"],
    [open.filter(c => PARTNER[c.code]).length, "earn partner credit"],
    [open.filter(c => daysLeft(c) !== null).length, "retiring soon"],
  ];
  $("homeStats").innerHTML = stats.map(([n, t]) => `<div class="stat"><b>${n}</b><span>${t}</span></div>`).join("");
}

/* ---------- Confetti (pure canvas) ---------- */
function launchConfetti() {
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const cv = $("confetti"), ctx = cv.getContext("2d");
  cv.width = innerWidth; cv.height = innerHeight;
  const colors = ["#9e3d2f", "#13283c", "#355f7d", "#c8c0b2", "#2f7d5b"];   // site palette
  const bits = Array.from({ length: 140 }, () => ({
    x: innerWidth / 2, y: innerHeight / 3, vx: (Math.random() - 0.5) * 14, vy: Math.random() * -12 - 4,
    r: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.3,
    c: colors[Math.floor(Math.random() * colors.length)], w: 6 + Math.random() * 6, h: 4 + Math.random() * 4,
  }));
  let frames = 0;
  (function tick() {
    ctx.clearRect(0, 0, cv.width, cv.height);
    bits.forEach(b => { b.vy += 0.35; b.x += b.vx; b.y += b.vy; b.r += b.vr;
      ctx.save(); ctx.translate(b.x, b.y); ctx.rotate(b.r); ctx.fillStyle = b.c; ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h); ctx.restore(); });
    if (++frames < 150) requestAnimationFrame(tick); else ctx.clearRect(0, 0, cv.width, cv.height);
  })();
}

/* ---------- Start-up ---------- */
$("startBtn").addEventListener("click", startQuest);
$("backBtn").addEventListener("click", goBack);
$("navQuest").addEventListener("click", () => { show("scrHome"); try { history.replaceState(null, "", location.pathname); } catch (e) {} });
$("navAll").addEventListener("click", () => { renderAll(); show("scrAll"); });
setupFilters();
setupTicker();
setupStats();

// If the monthly refresh is more than 5 days late, say so honestly rather than show a stale date.
(function markOverdue() {
  const panel = document.getElementById("refreshPanel");
  const next = panel && panel.dataset.next;
  if (!next) return;
  const late = (Date.now() - new Date(next + "T00:00:00Z")) / 86400000;
  if (late > 5) panel.querySelectorAll("dd time")[1]?.insertAdjacentHTML("afterend", " <em>(running late)</em>");
})();

// Deep links: a URL ending in #open-az-104 opens that certification's result.
// Used by the "Copy link" button and by the "Open in path finder" links in the roadmap.
function openFromHash() {
  const m = location.hash.match(/^#open-([a-z]{2}-\d{3})$/i);   // e.g. "#open-az-104"
  if (!m) return false;
  const code = m[1].toUpperCase();
  if (!CERT_BY_CODE[code]) return false;
  openCert(code);
  return true;
}
// Roadmap areas are collapsed. When a link points inside one (e.g. #az-104
// from the retirements table, or #area-data from the contents chips),
// open that area first so the browser can scroll to it.
function revealTarget() {
  const id = location.hash.slice(1);
  if (!id || id.startsWith("open-")) return;
  const el = document.getElementById(id);
  if (!el) return;
  const area = el.matches("details.rm-area") ? el : el.closest("details.rm-area");
  if (area && !area.open) { area.open = true; el.scrollIntoView(); }
}
function onHash() { if (!openFromHash()) revealTarget(); }

onHash();                                       // on first load
window.addEventListener("hashchange", onHash);  // when a link is clicked

// Printing: open every area so the printed poster shows everything,
// then put them back the way they were.
let openedForPrint = [];
window.addEventListener("beforeprint", () => {
  openedForPrint = [...document.querySelectorAll("details.rm-area:not([open])")];
  openedForPrint.forEach(d => d.open = true);
});
window.addEventListener("afterprint", () => openedForPrint.forEach(d => d.open = false));

</script>
