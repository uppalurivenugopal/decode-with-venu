---
// Microsoft Certification Path Finder — a Vibing tool.
// The top half is an interactive path finder (built in the browser by the
// <script> at the bottom). The bottom half — the roadmap of every active
// certification, the 2026 retirements table and the FAQ — is rendered here at
// build time from the same data file, so search engines can read all of it.
import Layout from '../../layouts/Layout.astro';
import { PAGE, CHANGES, FAQ, CERTS, SKILLS, VALUE, PARTNER, DOMAINS, isNew } from '../../data/ms-certifications.js';

// ---------- helpers used while building the page ----------
const LEARN = 'https://learn.microsoft.com/en-us';
// "2026-06-30" → "30 Jun 2026"
const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
// Official links for one certification (same rules as the browser script)
const linksFor = (c: any) => {
  const lc = c.code.toLowerCase();
  const study = `${LEARN}/credentials/certifications/resources/study-guides/${lc}`;
  return {
    learn: c.course === false ? `${LEARN}/training/browse/?terms=${encodeURIComponent(c.code)}` : `${LEARN}/training/courses/${lc}t00`,
    exam: c.page ? `${LEARN}/credentials/certifications/${c.page}` : study,
    study,
  };
};
const levelLabel = (l: string) => (l === 'Business' ? 'Business pro' : l);
const levelOrder = ['Fundamentals', 'Business', 'Associate', 'Specialty', 'GitHub', 'Expert'];

// Certifications still open on the date the catalog was verified
const verified = new Date(PAGE.verified + 'T00:00:00Z');
const open = CERTS.filter((c: any) => !c.retire || new Date(c.retire + 'T23:59:59Z') >= verified);
const byCode = Object.fromEntries(CERTS.map((c: any) => [c.code, c]));
// Refresh dates shown at the top of the page (updated by the monthly GitHub Action)
const lastLabel = fmt(PAGE.lastRefreshed);
const nextLabel = PAGE.nextRefresh ? fmt(PAGE.nextRefresh) : null;
// Certifications Microsoft launched recently — highlighted under the refresh panel
const fresh = open.filter((c: any) => isNew(c, verified));

// One group per career area, ordered fundamentals → expert
const areas = Object.entries(DOMAINS)
  .map(([key, d]: [string, any]) => ({
    key, ...d,
    certs: open.filter((c: any) => c.domain === key).sort((a: any, b: any) => levelOrder.indexOf(a.level) - levelOrder.indexOf(b.level)),
  }))
  .filter((a) => a.certs.length);

// ---------- structured data (JSON-LD) for search engines ----------
const url = PAGE.url;
const fullName = (c: any) =>
  c.domain === 'github' ? c.name : (c.domain === 'm365' ? 'Microsoft 365 Certified: ' : 'Microsoft Certified: ') + c.name;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.decodewithvenu.com/' },
      { '@type': 'ListItem', position: 2, name: 'Vibing', item: 'https://www.decodewithvenu.com/projects' },
      { '@type': 'ListItem', position: 3, name: 'Microsoft Certification Path Finder', item: url } ] },
    { '@type': 'WebApplication', name: 'Microsoft Certification Path Finder', url,
      applicationCategory: 'EducationalApplication', operatingSystem: 'Any (web browser)', isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'Venu Uppaluri', url: 'https://www.decodewithvenu.com/about' },
      dateModified: PAGE.lastRefreshed,
      description: 'Answer five questions about your career track and interests to get a recommended Microsoft certification, a roadmap, the official skills measured, and links to learn and book the exam.' },
    { '@type': 'ItemList', name: `Active Microsoft certifications (${PAGE.verifiedLabel})`, numberOfItems: open.length,
      itemListElement: open.map((c: any, i: number) => ({ '@type': 'ListItem', position: i + 1, item: {
        '@type': 'EducationalOccupationalCredential', name: fullName(c), url: `${url}#${c.code.toLowerCase()}`,
        identifier: c.code, credentialCategory: 'Professional certification', educationalLevel: c.level,
        recognizedBy: { '@type': 'Organization', name: 'Microsoft', url: 'https://learn.microsoft.com/credentials/' },
        ...(SKILLS[c.code] ? { competencyRequired: SKILLS[c.code].map(([n]: [string]) => n) } : {}),
        ...(c.retire ? { validUntil: c.retire } : {}) } })) },
    { '@type': 'FAQPage', mainEntity: FAQ.map((f: any) => ({
      '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
// "<\/" stops any "</script>" inside the text from closing the tag early
const jsonldText = JSON.stringify(jsonld).replace(/<\//g, '<\\/');
---

<Layout
  title="Microsoft Certification Path 2026: Interactive Roadmap"
  description={`Find the right Microsoft certification in 5 questions. All ${open.length} active certifications, official skills measured, 2026 retirements and replacements, and exam booking links.`}
  image="/images/og/microsoft-certification-path-2026.png"
>
  <script type="application/ld+json" set:html={jsonldText} />

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden border-b border-edge/5">
    <div class="relative z-10 mx-auto max-w-6xl px-5 sm:px-8 pt-14 pb-12 sm:pt-20 sm:pb-14">
      <a href="/projects" class="inline-flex items-center gap-1.5 text-xs text-mist-400 hover:text-fg transition-colors mb-6">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M9.5 6h-7M6 2.5L2.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Vibing
      </a>
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow mb-4">Interactive roadmap &middot; Microsoft certifications {PAGE.year}</p>
      <h1 class="font-serif text-5xl sm:text-6xl font-semibold leading-[0.98] tracking-[-0.045em] text-fg">
        Find your <span class="gradient-text">Microsoft certification</span> path.
      </h1>
      <p class="mt-5 max-w-2xl text-mist-400">
        Microsoft's certification line-up changed more in 2026 than in years, and there's no single up-to-date guide to it.
        Answer up to five questions about your track and interests and get a recommended certification: the official skills
        it measures, why it matters to clients and to your own team, whether it earns Microsoft partner credit, and direct
        links to learn and book the exam. Only active certifications.
      </p>

      <!-- Refresh panel: the data is re-checked against Microsoft Learn on the 1st of every month -->
      <dl class="cq-refresh" id="refreshPanel" data-next={PAGE.nextRefresh}>
        <div><dt>Last refreshed</dt><dd><time datetime={PAGE.lastRefreshed}>{lastLabel}</time></dd></div>
        {nextLabel && <div><dt>Next refresh</dt><dd><time datetime={PAGE.nextRefresh}>{nextLabel}</time></dd></div>}
        <div><dt>Source</dt><dd>Microsoft Learn — re-checked monthly for new and retiring certifications</dd></div>
      </dl>
      {fresh.length > 0 && (
        <p class="cq-fresh">
          <span>New on Microsoft Learn:</span>
          {fresh.map((c: any, i: number) => <>{i > 0 && ' · '}<a href={`#open-${c.code.toLowerCase()}`}>{c.code} {c.name.replace(/^GitHub Certified:\s*/, '')}</a>{c.beta && ' (beta)'}</>)}
        </p>
      )}
    </div>
  </section>

  <!-- ============ THE TOOL ============ -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-10 sm:py-12">
    <div id="cq">
      <div class="cq-ticker" id="ticker" hidden></div>

      <div class="cq-bar">
        <div class="cq-xp" title="Earn XP as you answer">
          <span class="cq-lvl" id="xpLevel">LVL 1</span>
          <div class="cq-track"><div class="cq-fill" id="xpFill"></div></div>
          <span class="cq-pts" id="xpPts">0 XP</span>
        </div>
        <nav class="cq-nav" aria-label="Path finder">
          <button id="navQuest" class="on" type="button">Find my path</button>
          <button id="navAll" type="button">Browse all</button>
          <a href="#roadmap">Roadmap</a>
        </nav>
      </div>

      <!-- Screen 1: start -->
      <div class="screen active" id="scrHome">
        <p class="eyebrow">Five questions · one recommendation</p>
        <h2 class="cq-h">Technical or functional, specialist or generalist — start here.</h2>
        <p class="cq-lead">You'll unlock a certification badge and a quest map of what comes next.</p>
        <button class="btn" id="startBtn" type="button">Start the quest →</button>
        <div class="stats" id="homeStats"></div>
        <div class="features">
          <div class="feature"><b>Official skills measured</b><span>Exam domains and weightings from Microsoft's study guides.</span></div>
          <div class="feature"><b>Value for clients</b><span>What the certification lets you deliver on engagements.</span></div>
          <div class="feature"><b>Value for internal teams</b><span>How it strengthens your own team and practice.</span></div>
          <div class="feature"><b>Partner credit</b><span>Whether it counts toward a Solutions Partner designation.</span></div>
        </div>
      </div>

      <!-- Screen 2: the decision tree -->
      <div class="screen" id="scrQuiz">
        <div class="qhead">
          <button class="back" id="backBtn" type="button">← Back</button>
          <div class="steps" id="steps"></div>
        </div>
        <h2 class="qtitle" id="qTitle"></h2>
        <p class="qsub" id="qSub"></p>
        <div class="options" id="qOptions"></div>
      </div>

      <!-- Screen 3: the result (filled in by the script) -->
      <div class="screen" id="scrResult"></div>

      <!-- Screen 4: browse every certification -->
      <div class="screen" id="scrAll">
        <h2 class="cq-h">All active certifications</h2>
        <p class="cq-lead">Every certification here is open for exams today. Ones with a scheduled retirement are flagged.</p>
        <div class="filters">
          <input id="fSearch" type="search" placeholder="Search code, name or skill — e.g. AZ-104, Fabric, Copilot, DLP" />
          <select id="fDomain"></select>
          <select id="fLevel"></select>
          <select id="fPartner"></select>
          <label><input type="checkbox" id="fRetiring" /> Only retiring</label>
        </div>
        <div class="count" id="fCount"></div>
        <div class="grid" id="allGrid"></div>
      </div>
    </div>
    <canvas id="confetti" aria-hidden="true"></canvas>
  </section>

  <!-- ============ ROADMAP (built at build time — readable by search engines) ============ -->
  <section id="roadmap" class="mx-auto max-w-6xl px-5 sm:px-8 pb-16">
    <div class="border-t border-edge/15 pt-12">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow mb-4">The full roadmap</p>
      <h2 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">
        Microsoft certification roadmap {PAGE.year}: all {open.length} active certifications
      </h2>
      <p class="mt-4 max-w-2xl text-mist-400">
        Every Microsoft certification you can still earn, grouped by career area and last refreshed from Microsoft Learn on
        {lastLabel}. Open an area for each certification's
        official skills measured, why it matters, partner credit, and links to the learning path and exam page.
      </p>
      <ul class="rm-toc">
        {areas.map((a) => <li><a href={`#area-${a.key}`}>{a.label}</a></li>)}
        <li><a href="#changes-2026">2026 retirements</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>

      {areas.map((a) => (
        <details class="rm-area" id={`area-${a.key}`}>
          <summary>
            <h3>{a.label} certifications <span class="rm-count">{a.certs.length}</span></h3>
            <span class="rm-desc">{a.desc}</span>
          </summary>
          <div class="rm-grid">
            {a.certs.map((c: any) => {
              const L = linksFor(c);
              const skills = SKILLS[c.code] || [];
              const value = VALUE[c.code];
              const partner = PARTNER[c.code];
              return (
                <article class:list={['rm', c.retire && 'retiring']} id={c.code.toLowerCase()}>
                  <h4><span class="c">{c.code}</span> · {c.name}</h4>
                  <div class="pills">
                    <span class={`pill lv-${c.level}`}>{levelLabel(c.level)}</span>
                    {c.retire && <span class="pill warn">Retires {fmt(c.retire)}</span>}
                    {c.beta && <span class="pill beta">Beta</span>}
                    {isNew(c, verified) && <span class="pill new">New</span>}
                    {partner && <span class="pill partner">Partner credit</span>}
                  </div>
                  {c.prereq && <p><strong>Prerequisite:</strong> {c.prereq}.</p>}
                  {c.note && <p>{c.note}</p>}
                  {skills.length > 0 && (
                    <>
                      <p><strong>Skills measured:</strong></p>
                      <ul>{skills.map(([n, w]: [string, string]) => <li>{n} ({w}%)</li>)}</ul>
                    </>
                  )}
                  {value && <p><strong>Why it matters:</strong> {value.client[0]}.</p>}
                  {partner && <p><strong>Partner credit:</strong> {partner.map((p: any) => `Solutions Partner for ${p.d} (${p.m})`).join('; ')}.</p>}
                  <div class="links">
                    <a href={L.learn} target="_blank" rel="noopener">Learning path</a>
                    <a href={L.exam} target="_blank" rel="noopener">{c.page ? 'Exam page' : 'Study guide (no exam page yet)'}</a>
                    <a href={`#open-${c.code.toLowerCase()}`}>Open in path finder</a>
                  </div>
                </article>
              );
            })}
          </div>
        </details>
      ))}

      <h3 class="rm-h" id="changes-2026">Microsoft certification retirements and replacements in 2026</h3>
      <p class="text-mist-400 max-w-2xl">From Microsoft Learn's retirement schedule. “Where to go now” is the closest active certification; where Microsoft hasn't named one, we say so.</p>
      <div class="rm-table-wrap">
        <table class="rm-table">
          <thead><tr><th>Exam</th><th>Certification</th><th>Retires / retired</th><th>Where to go now</th></tr></thead>
          <tbody>
            {CHANGES.map((ch: any) => (
              <tr>
                <td>{ch.old}</td>
                <td>{ch.name}</td>
                <td>{ch.upcoming ? '⚠ ' : ''}{fmt(ch.date)}</td>
                <td>{ch.next && byCode[ch.next]
                  ? <a href={`#${ch.next.toLowerCase()}`}>{ch.next} · {byCode[ch.next].name}</a>
                  : 'No direct replacement named'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="rm-h" id="faq">Frequently asked questions</h3>
      <div class="rm-faq">
        {FAQ.map((f: any) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>

      <p class="rm-note">
        Sources: certification and exam pages, study guides and the retirement schedule on
        <a href="https://learn.microsoft.com/en-us/credentials/" target="_blank" rel="noopener">Microsoft Learn</a>, and the
        <a href="https://learn.microsoft.com/en-us/partner-center/membership/solutions-partner" target="_blank" rel="noopener">Solutions Partner</a>
        pages in Microsoft Partner Center. “Value” notes are practitioner perspective, not Microsoft statements.
        Always confirm on the official exam page before booking. Not affiliated with Microsoft.
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  /* =====================================================================
     Styles for the path finder (#cq) and the roadmap (#roadmap).
     Every colour maps onto the site's --color-* tokens (global.css), so a
     brand palette change re-themes this page automatically. House rules from
     AGENTS.md: flat, square corners, top-border cards, no gradients.
     ===================================================================== */
  #cq, #roadmap {
    --ink: var(--color-fg);
    --text: var(--color-mist-200);
    --muted: var(--color-mist-400);
    --muted-2: var(--color-mist-300);
    --rule: color-mix(in srgb, var(--color-edge) 15%, transparent);
    --rule-strong: color-mix(in srgb, var(--color-edge) 30%, transparent);
    --tint: color-mix(in srgb, var(--color-edge) 4%, transparent);
    --accent: var(--color-cyan-glow);          /* brick/rust */
    --steel: var(--color-indigo-glow);         /* muted slate blue */
    /* Certification-level colours: deep tones that read on cream */
    --lv-fund: #2f7d5b;
    --lv-assoc: var(--color-indigo-glow);
    --lv-expert: #6b3f7d;
    --lv-spec: #a65a1c;
    --lv-biz: #1f6f6b;
    --lv-gh: #4b4a8a;
    --warn: #8a5a00;
    --warn-tint: color-mix(in srgb, #b0780a 10%, transparent);
    font-family: var(--font-sans);
    color: var(--text);
  }
  #cq *, #roadmap * { box-sizing: border-box; }
  #cq h2, #cq h3, #cq h4, #roadmap h3, #roadmap h4 { font-family: var(--font-serif); color: var(--ink); font-weight: 600; letter-spacing: -0.02em; }
  #cq a, #roadmap a { color: var(--steel); text-underline-offset: 3px; }
  /* Tailwind's reset removes list bullets; put them back inside the tool */
  #cq ul, #roadmap ul:not(.rm-toc) { list-style: disc; }

  /* Small rust uppercase labels — the site's eyebrow style */
  #cq .eyebrow, #cq .action .tag, #cq .here-tag, #cq .fact small {
    font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
  }

  /* ---------- refresh panel (hero) ---------- */
  .cq-refresh { display: flex; flex-wrap: wrap; gap: 0; margin: 26px 0 0; border-top: 2px solid var(--color-fg); max-width: 820px; }
  .cq-refresh > div { padding: 12px 22px 4px 0; margin-right: 22px; }
  .cq-refresh > div + div { border-left: 1px solid color-mix(in srgb, var(--color-edge) 15%, transparent); padding-left: 22px; }
  .cq-refresh dt { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-cyan-glow); }
  .cq-refresh dd { margin: 4px 0 0; font-family: var(--font-serif); font-size: 20px; font-weight: 600; color: var(--color-fg); }
  .cq-refresh > div:last-child dd { font-family: var(--font-sans); font-size: 14.5px; font-weight: 400; color: var(--color-mist-400); max-width: 300px; }
  .cq-refresh em { font-style: normal; font-size: 13px; color: var(--color-cyan-glow); }
  @media (max-width: 640px) { .cq-refresh > div + div { border-left: 0; padding-left: 0; } }
  .cq-fresh { margin-top: 14px; font-size: 14.5px; color: var(--color-mist-300); }
  .cq-fresh span { font-weight: 700; color: var(--color-cyan-glow); margin-right: 6px; }
  .cq-fresh a { color: var(--color-indigo-glow); }
  #cq .pill.beta, #roadmap .pill.beta { color: #6b3f7d; }
  #cq .pill.new, #roadmap .pill.new { color: #fff; background: var(--color-cyan-glow); border-color: var(--color-cyan-glow); }

  /* ---------- retirement ticker ---------- */
  #cq .cq-ticker { border-top: 2px solid var(--warn); background: var(--warn-tint); color: var(--warn); padding: 10px 14px; font-size: 14px; margin-bottom: 18px; }
  #cq .cq-ticker b { color: #6b4a00; }
  #cq .cq-ticker button { background: none; border: 0; color: #6b4a00; text-decoration: underline; cursor: pointer; font: inherit; padding: 0 0 0 6px; }

  /* ---------- top bar: XP + screen buttons ---------- */
  #cq .cq-bar { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--rule); margin-bottom: 28px; }
  #cq .cq-xp { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 220px; max-width: 360px; }
  #cq .cq-lvl { font-size: 12px; font-weight: 700; letter-spacing: .08em; color: #fff; background: var(--ink); padding: 4px 8px; white-space: nowrap; }
  #cq .cq-track { flex: 1; height: 6px; background: var(--rule); overflow: hidden; }
  #cq .cq-fill { height: 100%; width: 0%; background: var(--accent); transition: width .6s ease; }
  #cq .cq-pts { font-size: 13px; color: var(--muted); white-space: nowrap; }
  #cq .cq-nav { display: flex; gap: 6px; flex-wrap: wrap; }
  #cq .cq-nav button, #cq .cq-nav a {
    background: transparent; color: var(--ink); border: 1px solid var(--rule-strong); padding: 7px 14px;
    font: 600 14px var(--font-sans); cursor: pointer; text-decoration: none; transition: border-color .2s, background-color .2s;
  }
  #cq .cq-nav button:hover, #cq .cq-nav a:hover { border-color: var(--accent); }
  #cq .cq-nav button.on { background: var(--ink); border-color: var(--ink); color: #fff; }

  /* ---------- screens ---------- */
  #cq .screen { display: none; animation: cq-rise .4s ease; }
  #cq .screen.active { display: block; }
  @keyframes cq-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  #cq .cq-h { font-size: clamp(26px, 3.4vw, 34px); line-height: 1.12; margin: 10px 0 8px; max-width: 760px; }
  #cq .cq-lead { color: var(--muted); margin: 0 0 22px; max-width: 680px; }

  /* Primary and outline buttons (site's .btn-primary look) */
  #cq .btn {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; text-decoration: none;
    background: var(--ink); color: #fff; border: 1px solid var(--ink); font: 600 15px var(--font-sans); padding: 13px 22px;
    transition: background-color .2s, border-color .2s;
  }
  #cq .btn:hover { background: var(--accent); border-color: var(--accent); }
  #cq .btn.ghost { background: transparent; color: var(--ink); border-color: var(--rule-strong); }
  #cq .btn.ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* Stats + feature row on the start screen */
  #cq .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0 24px; margin-top: 34px; }
  #cq .stat { border-top: 1px solid var(--rule); padding: 14px 0; }
  #cq .stat b { display: block; font: 600 30px var(--font-serif); color: var(--ink); line-height: 1.1; }
  #cq .stat span { color: var(--muted); font-size: 13.5px; }
  #cq .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 24px; margin-top: 18px; }
  #cq .feature { border-top: 1px solid var(--rule); padding: 14px 0; }
  #cq .feature b { display: block; font: 600 16px var(--font-serif); color: var(--ink); margin-bottom: 2px; }
  #cq .feature span { color: var(--muted); font-size: 14px; }

  /* ---------- questions ---------- */
  #cq .qhead { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 8px; }
  #cq .steps { display: flex; gap: 5px; }
  #cq .steps i { width: 30px; height: 3px; background: var(--rule); display: block; }
  #cq .steps i.done { background: var(--accent); }
  #cq .qtitle { font-size: clamp(24px, 3.2vw, 32px); margin: 8px 0 4px; }
  #cq .qsub { color: var(--muted); margin: 0 0 22px; }
  #cq .back { background: none; border: 0; color: var(--muted); cursor: pointer; font: 500 14px var(--font-sans); padding: 4px 0; }
  #cq .back:hover { color: var(--ink); }
  #cq .options { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0 24px; }
  #cq .opt {
