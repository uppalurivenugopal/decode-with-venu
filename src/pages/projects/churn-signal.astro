---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Churn signal" description="An interactive logistic regression demo — adjust a customer's tenure, spend, tickets, and contract to see churn probability update live, with each factor's contribution broken out.">
  <section class="relative overflow-hidden bg-grid border-b border-edge/5">
    <div class="glow w-[26rem] h-[26rem] bg-cyan-glow/15 -top-40 left-1/4"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-5 sm:px-8 pt-14 pb-12 sm:pt-20 sm:pb-16">
      <a href="/projects" class="inline-flex items-center gap-1.5 text-xs text-mist-400 hover:text-fg transition-colors mb-6">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M9.5 6h-7M6 2.5L2.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Casual Projects
      </a>
      <p class="font-mono text-xs tracking-widest text-cyan-glow/80 uppercase mb-4">Interactive demo &middot; logistic regression</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-fg leading-tight">
        Will this customer <span class="gradient-text">stick around?</span>
      </h1>
      <p class="mt-4 max-w-xl text-mist-400">
        Move the inputs below and watch the model's estimate change in real time. Each factor's pull
        toward or away from churn is shown separately, so the number never arrives unexplained.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 sm:px-8 py-12 sm:py-16">
    <div class="grid md:grid-cols-2 gap-5 items-start">
      <div class="card p-6 sm:p-7">
        <p class="font-mono text-[11px] tracking-widest uppercase text-mist-400 mb-5">Customer profile</p>

        <div class="mb-5">
          <div class="flex justify-between items-baseline mb-1.5">
            <span class="text-sm font-medium text-mist-200">Tenure</span>
            <span id="tenure-out" class="font-mono text-xs text-cyan-glow tabular-nums">12 months</span>
          </div>
          <input type="range" min="0" max="72" step="1" value="12" id="tenure" aria-label="Tenure in months" />
        </div>

        <div class="mb-5">
          <div class="flex justify-between items-baseline mb-1.5">
            <span class="text-sm font-medium text-mist-200">Monthly charges</span>
            <span id="charges-out" class="font-mono text-xs text-cyan-glow tabular-nums">$70</span>
          </div>
          <input type="range" min="20" max="120" step="1" value="70" id="charges" aria-label="Monthly charges in dollars" />
        </div>

        <div class="mb-5">
          <div class="flex justify-between items-baseline mb-1.5">
            <span class="text-sm font-medium text-mist-200">Support tickets, last 90 days</span>
            <span id="tickets-out" class="font-mono text-xs text-cyan-glow tabular-nums">2</span>
          </div>
          <input type="range" min="0" max="10" step="1" value="2" id="tickets" aria-label="Support tickets in the last 90 days" />
        </div>

        <div>
          <label class="block text-sm font-medium text-mist-200 mb-1.5" for="contract">Contract type</label>
          <select id="contract" aria-label="Contract type">
            <option value="0">Month-to-month</option>
            <option value="1">One year</option>
            <option value="2">Two year</option>
          </select>
        </div>
      </div>

      <div class="card p-6 sm:p-7">
        <p class="font-mono text-[11px] tracking-widest uppercase text-mist-400 mb-5">Model output</p>

        <div class="flex items-end justify-between gap-4 pb-5 mb-5 border-b border-edge/8">
          <div>
            <p class="text-xs text-mist-400 mb-1">Churn probability</p>
            <div id="prob-out" class="font-mono text-4xl font-semibold text-fg tabular-nums">--</div>
          </div>
          <span id="risk-badge" class="font-mono text-xs px-3 py-1 rounded-full border">--</span>
        </div>

        <p class="text-xs text-mist-400 mb-4">What's driving this, in log-odds</p>
        <div id="factors" class="space-y-3"></div>
      </div>
    </div>

    <p class="mt-8 text-xs text-mist-400 max-w-2xl leading-relaxed">
      Built on illustrative coefficients, not a dataset — a stand-in for how a logistic regression
      model would weigh these signals. Cyan bars pull the estimate down; rose bars pull it up.
    </p>
  </section>
</Layout>

<style>
  input[type='range'] {
    -webkit-appearance: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-edge) 12%, transparent);
    outline: none;
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-cyan-glow);
    border: 2px solid var(--color-ink-950);
    box-shadow: 0 0 0 1px var(--color-cyan-glow);
    cursor: pointer;
  }
  input[type='range']::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-cyan-glow);
    border: 2px solid var(--color-ink-950);
    cursor: pointer;
  }
  select {
    width: 100%;
    height: 36px;
    padding: 0 0.7rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-edge) 12%, transparent);
    background: color-mix(in srgb, var(--color-edge) 4%, transparent);
    color: var(--color-mist-200);
    font-size: 13px;
  }
  select:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--color-cyan-glow);
    outline-offset: 1px;
  }
</style>

<script>
  function clamp(v: number, a: number, b: number) { return Math.max(a, Math.min(b, v)); }
  function el(id: string) { return document.getElementById(id) as HTMLInputElement | HTMLSelectElement; }

  function paintPill(target: HTMLElement, band: 'low' | 'medium' | 'high') {
    const base = 'font-mono text-xs px-3 py-1 rounded-full border';
    const map: Record<string, [string, string]> = {
      low: ['bg-emerald-500/10 text-emerald-400 border-emerald-500/20', 'Low risk'],
      medium: ['bg-amber-500/10 text-amber-400 border-amber-500/20', 'Medium risk'],
      high: ['bg-rose-500/10 text-rose-400 border-rose-500/20', 'High risk'],
    };
    const [cls, label] = map[band];
    target.className = `${base} ${cls}`;
    target.textContent = label;
  }

  function render() {
    const tenure = parseFloat(el('tenure').value);
    const charges = parseFloat(el('charges').value);
    const tickets = parseFloat(el('tickets').value);
    const contract = parseInt(el('contract').value, 10);

    document.getElementById('tenure-out')!.textContent = tenure + ' months';
    document.getElementById('charges-out')!.textContent = '$' + charges;
    document.getElementById('tickets-out')!.textContent = String(tickets);

    const intercept = -1.5;
    const tTenure = -0.05 * tenure;
    const tCharges = 0.03 * (charges - 70);
    const tTickets = 0.35 * tickets;
    const contractMap = [1.2, 0, -0.8];
    const tContract = contractMap[contract];

    const logit = intercept + tTenure + tCharges + tTickets + tContract;
    const prob = 1 / (1 + Math.exp(-logit));
    const pct = Math.round(clamp(prob, 0, 1) * 100);

    document.getElementById('prob-out')!.textContent = pct + '%';

    const badge = document.getElementById('risk-badge')!;
    if (pct < 30) paintPill(badge, 'low');
    else if (pct < 60) paintPill(badge, 'medium');
    else paintPill(badge, 'high');

    const css = getComputedStyle(document.documentElement);
    const cyan = css.getPropertyValue('--color-cyan-glow').trim();
    const rose = '#f43f5e';

    const factors = [
      { label: 'Tenure', val: tTenure },
      { label: 'Monthly charges', val: tCharges },
      { label: 'Support tickets', val: tTickets },
      { label: 'Contract type', val: tContract },
    ];
    const maxAbs = Math.max(1.5, ...factors.map((f) => Math.abs(f.val)));
    let html = '';
    factors.forEach((f) => {
      const pctWidth = clamp((Math.abs(f.val) / maxAbs) * 50, 0, 50);
      const isUp = f.val > 0;
      const color = isUp ? rose : cyan;
      const side = isUp ? 'left:50%;' : 'right:50%;';
      html += `<div class="flex items-center gap-2.5">
        <div class="w-32 shrink-0 text-xs text-mist-400">${f.label}</div>
        <div class="relative flex-1 h-1.5 rounded bg-white/8">
          <div class="absolute inset-y-0 left-1/2 w-px bg-white/15"></div>
          <div class="absolute inset-y-0 rounded" style="${side} width:${pctWidth}%; background:${color};"></div>
        </div>
        <div class="w-12 text-right font-mono text-xs text-mist-200 tabular-nums">${f.val >= 0 ? '+' : ''}${f.val.toFixed(2)}</div>
      </div>`;
    });
    document.getElementById('factors')!.innerHTML = html;
  }

  ['tenure', 'charges', 'tickets', 'contract'].forEach((id) => {
    el(id).addEventListener('input', render);
    el(id).addEventListener('change', render);
  });
  render();
</script>
