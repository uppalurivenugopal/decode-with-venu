---
import Layout from '../../layouts/Layout.astro';

const bands = [
  { id: 'all', label: 'Any distance' },
  { id: 'short', label: 'Up to 5K' },
  { id: '10k', label: '10K' },
  { id: 'half', label: 'Half (15–21.1K)' },
  { id: 'full', label: 'Marathon (25–42.2K)' },
  { id: 'ultra', label: 'Ultra 43–99K' },
  { id: '100k', label: '100K – 199K' },
  { id: '200k', label: '200K+ / multi-day' },
];
---

<Layout title="RunSphere" description="Every upcoming running event in India plus the world's marquee races, for the next 13 months. Crawled from Indian race platforms weekly, de-duplicated, with sources shown for every race.">
  <section class="relative overflow-hidden border-b border-edge/5">
    <div class="relative z-10 mx-auto max-w-6xl px-5 sm:px-8 pt-14 pb-12 sm:pt-20 sm:pb-14">
      <a href="/projects" class="inline-flex items-center gap-1.5 text-xs text-mist-400 hover:text-fg transition-colors mb-6">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M9.5 6h-7M6 2.5L2.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Casual Projects
      </a>
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow mb-4">Data aggregator &middot; refreshed weekly</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">
        RunSphere: every start line for the next 13 months
      </h1>
      <p class="mt-4 max-w-2xl text-mist-400">
        Every Indian race I can find, from 5K community runs to 300K+ Himalayan ultras, plus the world's
        marquee events: the Majors, Comrades, UTMB and the Ironman championships. A crawler collects listings from
        iFinish, IndiaRunning, MarathonMitra and the FatMarathoner calendar every Monday, merges duplicates and keeps
        a link to every source. Nothing on this page is guessed. If an organiser hasn't published a detail, it says so.
      </p>
      <p id="rs-meta" class="mt-5 text-xs text-mist-400">Loading calendar…</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-10 sm:py-12">
    <div id="stage">
      <div class="rs-stats">
        <div><span id="st-showing">–</span><small>Showing</small></div>
        <div><span id="st-open">–</span><small>Registrations open</small></div>
        <div><span id="st-abroad">–</span><small>Abroad</small></div>
        <div><span id="st-ultra">–</span><small>Ultras &amp; beyond</small></div>
      </div>

      <div class="rs-filters">
        <input id="f-q" type="search" placeholder="Search race, city (Hyderabad, Leh, Chamonix…) or organiser" aria-label="Search races" />
        <div class="rs-grid">
          <label>Discipline<select id="f-disc"><option value="All">All</option></select></label>
          <label>Distance<select id="f-band">{bands.map((b) => <option value={b.id}>{b.label}</option>)}</select></label>
          <label>Region<select id="f-region"><option value="All">All regions</option></select></label>
          <label>Month<select id="f-month"><option value="All">Next 13 months</option></select></label>
          <label>Entry status<select id="f-status"><option value="All">All statuses</option></select></label>
        </div>
        <div class="rs-toggles">
          <label><input type="checkbox" id="f-virtual" checked /> Hide virtual runs</label>
          <label><input type="checkbox" id="f-confirmed" /> Only multi-source or researched</label>
          <button type="button" id="f-reset">Reset</button>
          <button type="button" id="open-compare" class="rs-compare-btn" hidden>Compare (<span id="cmp-n">0</span>)</button>
          <button type="button" id="open-submit" class="rs-link">+ Suggest a race</button>
        </div>
      </div>

      <ol id="rs-list" class="rs-list" aria-live="polite"></ol>
      <p id="rs-empty" class="rs-empty" hidden>No races match these filters.</p>
      <button type="button" id="rs-more" class="btn-primary rs-more" hidden>Show more</button>

      <dialog id="dlg-detail" class="rs-dialog"><div id="detail-body"></div></dialog>
      <dialog id="dlg-compare" class="rs-dialog rs-wide"><div id="compare-body"></div></dialog>
      <dialog id="dlg-submit" class="rs-dialog">
        <button type="button" class="rs-close" data-close aria-label="Close">×</button>
        <h2 class="font-serif text-2xl font-semibold text-fg">Suggest a race</h2>
        <p class="text-sm text-mist-400 mt-1 mb-5">Missing something? Send it over. I check each one before adding it to the curated list.</p>
        <form action="https://formsubmit.co/venu@decodewithvenu.com" method="POST" class="rs-form">
          <input type="hidden" name="_subject" value="RunSphere race suggestion" />
          <input type="hidden" name="_next" value="https://www.decodewithvenu.com/thank-you" />
          <input type="hidden" name="_template" value="table" />
          <label>Race name<input name="race" required placeholder="e.g. Hyderabad Trail 25K 2027" /></label>
          <div class="rs-two">
            <label>Date<input name="date" type="date" required /></label>
            <label>City / country<input name="city" required placeholder="Hyderabad" /></label>
          </div>
          <label>Distances &amp; prices<input name="details" placeholder="10K ₹799 · 21.1K ₹1,299" /></label>
          <label>Official registration link<input name="link" type="url" required placeholder="https://…" /></label>
          <label>Your email (optional)<input name="email" type="email" placeholder="So I can tell you when it's live" /></label>
          <button type="submit" class="btn-primary">Send suggestion</button>
        </form>
      </dialog>

      <p class="rs-foot">
        How this works: listings come from public pages and sitemaps the platforms publish. Races found on two or more
        platforms are marked <em>sources agree</em>. The international and marquee Indian races are researched by hand
        against official sites and press coverage, and dates not yet officially announced are marked <em>TBC</em>.
        Always confirm with the organiser before you book travel.
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  #stage {
    --ink: var(--color-fg);
    --ink-muted: var(--color-mist-300);
    --ink-faint: var(--color-mist-400);
    --line: color-mix(in srgb, var(--color-edge) 12%, transparent);
    --line-strong: color-mix(in srgb, var(--color-edge) 22%, transparent);
    --accent: var(--color-cyan-glow);
    --accent-tint: color-mix(in srgb, var(--color-cyan-glow) 9%, transparent);
    --blue: var(--color-indigo-glow);
    --good: #2f6b4f;
    --warn: #9a5b12;
    --bad: #9e3d2f;
    --paper: var(--color-ink-900);
  }
  #stage .rs-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line); margin-bottom: 1.75rem; }
  #stage .rs-stats div { padding: 1rem 0.75rem 0.9rem 0; }
  #stage .rs-stats span { display: block; font-family: var(--font-serif); font-size: 2rem; font-weight: 600; color: var(--ink); line-height: 1; }
  #stage .rs-stats small { display: block; margin-top: 0.35rem; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); }
  @media (max-width: 640px) { #stage .rs-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } #stage .rs-stats span { font-size: 1.6rem; } }

  #stage .rs-filters { margin-bottom: 1.5rem; }
  #stage input[type='search'], #stage select, #stage .rs-form input {
    width: 100%; background: var(--paper); border: 1px solid var(--line-strong); border-radius: 0;
    padding: 0.6rem 0.75rem; font-size: 14px; color: var(--ink);
  }
  #stage input:focus, #stage select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  #stage .rs-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; margin-top: 0.75rem; }
  @media (max-width: 900px) { #stage .rs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  #stage .rs-grid label, #stage .rs-form label { display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); font-weight: 600; }
  #stage .rs-grid select, #stage .rs-form input { margin-top: 0.35rem; text-transform: none; letter-spacing: 0; font-weight: 400; }
  #stage .rs-toggles { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.25rem; margin-top: 0.9rem; font-size: 13.5px; color: var(--ink-muted); }
  #stage .rs-toggles label { display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer; }
  #stage .rs-toggles input { accent-color: var(--accent); width: 15px; height: 15px; }
  #stage #f-reset, #stage .rs-link { color: var(--ink-faint); text-decoration: underline; text-underline-offset: 3px; }
  #stage .rs-link { margin-left: auto; color: var(--accent); }
  #stage .rs-compare-btn { background: var(--accent); color: #fff; padding: 0.35rem 0.8rem; font-weight: 600; }

  #stage .rs-list { list-style: none; padding: 0; margin: 0; }
  #stage .rs-row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) 13rem 6.5rem; gap: 1.25rem; align-items: start; padding: 1.1rem 0; border-top: 1px solid var(--line); }
  #stage .rs-row:hover { background: color-mix(in srgb, var(--color-cyan-glow) 3%, transparent); }
  #stage .rs-date b { display: block; font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; color: var(--ink); line-height: 1.15; }
  #stage .rs-date span { font-size: 12px; color: var(--ink-faint); }
  #stage .rs-name { font-weight: 600; color: var(--ink); font-size: 1.02rem; text-align: left; line-height: 1.3; }
  #stage .rs-name:hover { color: var(--accent); }
  #stage .rs-sub { margin-top: 0.3rem; font-size: 12.5px; color: var(--ink-faint); display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; align-items: center; }
  #stage .rs-pills { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
  #stage .rs-pill { font-size: 11px; font-weight: 600; padding: 0.1rem 0.45rem; border: 1px solid var(--line-strong); color: var(--ink-muted); }
  #stage .rs-pill.long { border-color: color-mix(in srgb, var(--accent) 45%, transparent); color: var(--accent); background: var(--accent-tint); }
  #stage .rs-tier { font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); }
  #stage .rs-conf.ok { color: var(--good); }
  #stage .rs-conf.single { color: var(--warn); }
  #stage .rs-status { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 0.15rem 0.5rem; border: 1px solid currentColor; }
  #stage .st-open { color: var(--good); } #stage .st-soon { color: var(--warn); } #stage .st-closed { color: var(--bad); } #stage .st-other { color: var(--ink-faint); }
  #stage .rs-price { display: block; margin-top: 0.4rem; font-size: 12.5px; color: var(--ink-muted); }
  #stage .rs-actions { display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-end; }
  #stage .rs-actions button { font-size: 12.5px; color: var(--ink-muted); text-decoration: underline; text-underline-offset: 3px; }
  #stage .rs-actions button.on { color: var(--accent); font-weight: 600; }
  #stage .rs-tbc { color: var(--warn); font-weight: 600; }
  @media (max-width: 760px) {
    #stage .rs-row { grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0.4rem 1rem; }
    #stage .rs-entry { grid-column: 2; }
    #stage .rs-actions { grid-column: 2; flex-direction: row; gap: 1rem; align-items: center; }
  }
  #stage .rs-empty { padding: 2.5rem 0; text-align: center; color: var(--ink-faint); border-top: 1px solid var(--line); }
  #stage .rs-more { display: block; margin: 1.5rem auto 0; padding: 0.65rem 1.5rem; font-weight: 600; font-size: 14px; }
  #stage .rs-foot { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: 13px; color: var(--ink-faint); max-width: 48rem; line-height: 1.7; }

  .rs-dialog { margin: auto; width: min(42rem, calc(100vw - 2rem)); max-height: 88vh; background: var(--color-ink-900); color: var(--color-mist-200); border: 0; border-top: 3px solid var(--color-cyan-glow); padding: 1.75rem; }
  .rs-dialog.rs-wide { width: min(64rem, calc(100vw - 2rem)); }
  .rs-dialog::backdrop { background: rgba(19, 40, 60, 0.45); }
  .rs-dialog .rs-close { position: absolute; top: 0.75rem; right: 1rem; font-size: 1.6rem; line-height: 1; color: var(--color-mist-400); }
  .rs-dialog .rs-specs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin: 1.25rem 0; border-top: 1px solid color-mix(in srgb, var(--color-edge) 12%, transparent); }
  .rs-dialog .rs-specs div { padding: 0.75rem 0.75rem 0.75rem 0; border-bottom: 1px solid color-mix(in srgb, var(--color-edge) 10%, transparent); font-size: 14px; }
  .rs-dialog .rs-specs dt { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-mist-400); font-weight: 600; margin-bottom: 0.2rem; }
  @media (max-width: 560px) { .rs-dialog .rs-specs { grid-template-columns: 1fr; } }
  .rs-dialog .rs-np { color: var(--color-mist-400); font-style: italic; }
  .rs-dialog .rs-note { background: color-mix(in srgb, #9a5b12 8%, transparent); border-left: 2px solid #9a5b12; padding: 0.65rem 0.85rem; font-size: 13.5px; margin-bottom: 1.25rem; }
  .rs-dialog .rs-src a { color: var(--color-indigo-glow); text-decoration: underline; text-underline-offset: 3px; font-size: 13.5px; }
  .rs-dialog .rs-cta { display: block; text-align: center; margin-top: 1.25rem; padding: 0.75rem 1rem; font-weight: 600; }
  .rs-dialog .rs-cmp { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem; margin-top: 1rem; }
  .rs-dialog .rs-cmp > div { border-top: 2px solid var(--color-fg); padding-top: 0.75rem; font-size: 13.5px; }
  .rs-dialog .rs-cmp dt { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-mist-400); font-weight: 600; margin-top: 0.7rem; }
  #stage .rs-form { display: grid; gap: 0.9rem; }
  #stage .rs-form .rs-two { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  #stage .rs-form button { padding: 0.7rem; font-weight: 600; margin-top: 0.25rem; }
</style>

<script>
  type Source = { name: string; url: string };
  type RaceEvent = {
    id: string; name: string; date: string; dateTBC?: boolean; endDate?: string | null; city: string; venue: string;
    country: string; region: string; discipline: string; distances: number[]; categories: string[];
    priceFrom?: number | null; currency?: string; priceNote?: string | null; organizer?: string | null;
    regOpens?: string | null; regCloses?: string | null; status: string; regLink?: string | null; entry?: string | null;
    sources: Source[]; tier?: string; notes?: string | null; lastChecked?: string;
  };

  const WINDOW_MONTHS = 13;
  const PAGE = 60;
  const BANDS: Record<string, (d: number[]) => boolean> = {
    all: () => true,
    short: (d) => d.some((k) => k <= 5),
    '10k': (d) => d.some((k) => k > 5 && k <= 12),
    half: (d) => d.some((k) => k >= 15 && k <= 21.1),
    full: (d) => d.some((k) => k > 21.1 && k <= 42.2),
    ultra: (d) => d.some((k) => k > 42.2 && k < 100),
    '100k': (d) => d.some((k) => k >= 100 && k < 200),
    '200k': (d) => d.some((k) => k >= 200),
  };
  const CURRENCY: Record<string, string> = { INR: '₹', USD: '$', EUR: '€', GBP: '£', JPY: '¥', AUD: 'A$', SGD: 'S$', ZAR: 'R', AED: 'AED ' };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const safeUrl = (u?: string | null) => (u && /^https?:\/\//i.test(u) ? u : '');
  const parseDate = (s: string) => new Date(`${s}T00:00:00`);
  const fmtDate = (s: string) => parseDate(s).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  const fmtShort = (s: string) => parseDate(s).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
  const fmtMonth = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  const fmtKm = (k: number) => (k >= 100 ? `${Math.round(k)}K` : `${k}K`);

  const today = new Date(); today.setHours(0, 0, 0, 0);
  const windowEnd = new Date(today); windowEnd.setMonth(windowEnd.getMonth() + WINDOW_MONTHS);

  function daysUntil(s: string) {
    const n = Math.round((parseDate(s).getTime() - today.getTime()) / 86400000);
    if (n <= 0) return 'today';
    if (n === 1) return 'tomorrow';
    if (n < 60) return `in ${n} days`;
    return `in ${Math.round(n / 30)} months`;
  }

  function confidence(e: RaceEvent) {
    const n = new Set(e.sources.map((s) => s.name)).size;
    if (e.tier && e.tier !== 'community') return { label: 'Researched', cls: 'ok', tip: 'Hand-checked against official site / press coverage' };
    if (n >= 2) return { label: `${n} sources agree`, cls: 'ok', tip: 'Same race and date found on multiple platforms' };
    return { label: 'Single listing', cls: 'single', tip: 'Only one platform lists this race. Verify with the organiser.' };
  }

  function statusCls(s: string) {
    if (s === 'Registrations Open') return 'st-open';
    if (s === 'Closing Soon' || s === 'Opening Soon') return 'st-soon';
    if (['Registrations Closed', 'Sold Out', 'Cancelled'].includes(s)) return 'st-closed';
    return 'st-other';
  }

  const priceText = (e: RaceEvent) => (e.priceFrom ? `From ${CURRENCY[e.currency || 'INR'] || e.currency + ' '}${e.priceFrom.toLocaleString('en-IN')}` : '');
  const pills = (d: number[], max = 6) =>
    d.length
      ? d.slice(0, max).map((k) => `<span class="rs-pill${k > 42.2 ? ' long' : ''}">${fmtKm(k)}</span>`).join('') + (d.length > max ? `<span class="rs-pill">+${d.length - max}</span>` : '')
      : '<span class="rs-sub">Distances on race page</span>';

  let all: RaceEvent[] = [];
  let shown = PAGE;
  const compare: RaceEvent[] = [];

  const els = {
    q: $<HTMLInputElement>('f-q'), disc: $<HTMLSelectElement>('f-disc'), band: $<HTMLSelectElement>('f-band'),
    region: $<HTMLSelectElement>('f-region'), month: $<HTMLSelectElement>('f-month'), status: $<HTMLSelectElement>('f-status'),
    virtual: $<HTMLInputElement>('f-virtual'), confirmed: $<HTMLInputElement>('f-confirmed'),
  };

  function filtered() {
    const q = els.q.value.trim().toLowerCase();
    return all.filter((e) => {
      if (q && !`${e.name} ${e.city} ${e.venue} ${e.organizer || ''} ${e.country}`.toLowerCase().includes(q)) return false;
      if (els.disc.value !== 'All' && e.discipline !== els.disc.value) return false;
      const r = els.region.value;
      if (r !== 'All' && !(r === 'International' ? e.region.startsWith('International') : e.region === r)) return false;
      if (els.status.value !== 'All' && e.status !== els.status.value) return false;
      if (els.month.value !== 'All' && !e.date.startsWith(els.month.value)) return false;
      if (!BANDS[els.band.value](e.distances || [])) return false;
      if (els.virtual.checked && e.discipline === 'Virtual') return false;
      if (els.confirmed.checked && confidence(e).cls === 'single') return false;
      return true;
    });
  }

  function row(e: RaceEvent) {
    const c = confidence(e);
    const isCmp = compare.some((x) => x.id === e.id);
    const tier = e.tier && e.tier !== 'community' ? `<span class="rs-tier">${esc(e.tier)}</span>` : '';
    const where = [e.city, e.country !== 'India' ? e.country : ''].filter(Boolean).join(', ');
    return `<li class="rs-row">
      <div class="rs-date"><b>${esc(fmtShort(e.date))}</b><span>${e.dateTBC ? '<span class="rs-tbc">Date TBC</span>' : esc(daysUntil(e.date))} · ${parseDate(e.date).getFullYear()}</span></div>
      <div>
        <button type="button" class="rs-name" data-open="${esc(e.id)}">${esc(e.name)}</button>
        <div class="rs-sub">${tier}<span>${esc(where)}</span><span>· ${esc(e.discipline)}</span><span class="rs-conf ${c.cls}" title="${esc(c.tip)}">· ${esc(c.label)}</span></div>
        <div class="rs-pills">${pills(e.distances || [])}</div>
      </div>
      <div class="rs-entry"><span class="rs-status ${statusCls(e.status)}">${esc(e.status)}</span>${priceText(e) ? `<span class="rs-price">${esc(priceText(e))}</span>` : ''}</div>
      <div class="rs-actions"><button type="button" data-open="${esc(e.id)}">Details</button><button type="button" data-cmp="${esc(e.id)}" class="${isCmp ? 'on' : ''}">${isCmp ? '✓ Comparing' : 'Compare'}</button></div>
    </li>`;
  }

  function render() {
    const list = filtered();
    $('rs-list').innerHTML = list.slice(0, shown).map(row).join('');
    $('rs-empty').hidden = list.length > 0;
    $('rs-more').hidden = list.length <= shown;
    $('rs-more').textContent = `Show more (${list.length - shown} left)`;
    $('st-showing').textContent = String(list.length);
    $('st-open').textContent = String(list.filter((e) => e.status === 'Registrations Open' || e.status === 'Closing Soon').length);
    $('st-abroad').textContent = String(list.filter((e) => e.region.startsWith('International')).length);
    $('st-ultra').textContent = String(list.filter((e) => (e.distances || []).some((k) => k > 42.2)).length);
    $('open-compare').hidden = compare.length === 0;
    $('cmp-n').textContent = String(compare.length);
  }

  function fillSelect(sel: HTMLSelectElement, values: string[], label = (v: string) => v) {
    sel.insertAdjacentHTML('beforeend', values.map((v) => `<option value="${esc(v)}">${esc(label(v))}</option>`).join(''));
  }

  function openDetail(e: RaceEvent) {
    const np = '<span class="rs-np">Not published by sources. Check with the organiser.</span>';
    const c = confidence(e);
    const venue = [e.venue, e.city, e.country].filter((v, i, a) => v && a.indexOf(v) === i).join(', ');
    const reg = e.regOpens || e.regCloses ? `${e.regOpens ? fmtDate(e.regOpens) : '?'} → ${e.regCloses ? fmtDate(e.regCloses) : '?'}` : '';
    const link = safeUrl(e.regLink);
    $('detail-body').innerHTML = `
      <button type="button" class="rs-close" data-close aria-label="Close">×</button>
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">${esc(e.discipline)}${e.tier && e.tier !== 'community' ? ' · ' + esc(e.tier) : ''}</p>
      <h2 class="font-serif text-3xl font-semibold text-fg mt-2 leading-tight">${esc(e.name)}</h2>
      <p class="text-sm text-mist-400 mt-2">${esc(fmtDate(e.date))}${e.endDate ? ' – ' + esc(fmtDate(e.endDate)) : ''} · ${e.dateTBC ? '<span class="rs-tbc" style="color:#9a5b12">date not yet officially confirmed</span>' : esc(daysUntil(e.date))}
        · <span style="color:${c.cls === 'ok' ? '#2f6b4f' : '#9a5b12'}">${esc(c.label)}</span></p>
      <dl class="rs-specs">
        <div><dt>Venue</dt><dd>${esc(venue) || np}</dd></div>
        <div><dt>Entry status</dt><dd>${esc(e.status)}</dd></div>
        <div><dt>Organiser</dt><dd>${e.organizer ? esc(e.organizer) : np}</dd></div>
        <div><dt>Entry type</dt><dd>${esc(e.entry || 'Open registration (per listing)')}</dd></div>
        <div><dt>Registration window</dt><dd>${reg ? esc(reg) : np}</dd></div>
        <div><dt>Price</dt><dd>${priceText(e) ? esc(priceText(e)) : e.priceNote ? esc(e.priceNote) : np}</dd></div>
      </dl>
      <p class="text-[10.5px] font-semibold uppercase tracking-[0.12em] text-mist-400 mb-2">Distances</p>
      <div class="rs-pills" style="display:flex;flex-wrap:wrap;gap:.3rem">${(e.distances || []).map((k) => `<span style="font-size:12px;font-weight:600;padding:.1rem .5rem;border:1px solid rgba(19,40,60,.25)">${fmtKm(k)}</span>`).join('') || np}</div>
      ${e.categories?.length ? `<p class="text-sm text-mist-400 mt-2">Categories: ${esc(e.categories.join(' · '))}</p>` : ''}
      ${e.notes ? `<p class="rs-note mt-5">${esc(e.notes)}</p>` : '<div class="mb-5"></div>'}
      <p class="text-[10.5px] font-semibold uppercase tracking-[0.12em] text-mist-400 mb-2">Where this came from</p>
      <ul class="rs-src space-y-1">${e.sources.filter((s) => safeUrl(s.url)).map((s) => `<li><a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.name)} ↗</a></li>`).join('')}</ul>
      <p class="text-xs text-mist-400 mt-3">Last checked ${esc(e.lastChecked || '')}. Aid stations, medical cover, cut-offs and photo policy appear only when an organiser publishes them.</p>
      ${link ? `<a class="btn-primary rs-cta" href="${esc(link)}" target="_blank" rel="noopener">Go to registration / official page ↗</a>` : ''}`;
    $<HTMLDialogElement>('dlg-detail').showModal();
  }

  function openCompare() {
    const f = (label: string, v: string) => `<dt>${label}</dt><dd>${v ? esc(v) : '—'}</dd>`;
    $('compare-body').innerHTML = `
      <button type="button" class="rs-close" data-close aria-label="Close">×</button>
      <h2 class="font-serif text-2xl font-semibold text-fg">Side by side</h2>
      <div class="rs-cmp">${compare.map((e) => `<div>
        <p class="font-semibold text-fg">${esc(e.name)}</p>
        <dl>${f('Date', fmtDate(e.date) + (e.dateTBC ? ' (TBC)' : ''))}${f('Where', [e.city, e.country].filter(Boolean).join(', '))}${f('Discipline', e.discipline)}
        ${f('Distances', (e.distances || []).map(fmtKm).join(' · '))}${f('Price', priceText(e) || e.priceNote || '')}${f('Entry', e.entry || e.status)}
        ${f('Organiser', e.organizer || '')}${f('Confidence', confidence(e).label)}</dl>
        <button type="button" data-cmp="${esc(e.id)}" class="text-sm text-cyan-glow underline mt-3">Remove</button></div>`).join('')}</div>`;
    $<HTMLDialogElement>('dlg-compare').showModal();
  }

  function toggleCompare(id: string) {
    const i = compare.findIndex((x) => x.id === id);
    if (i >= 0) compare.splice(i, 1);
    else if (compare.length >= 3) { alert('You can compare up to 3 races at a time.'); return; }
    else compare.push(all.find((x) => x.id === id)!);
    render();
  }

  // --- wiring ---
  document.getElementById('stage')!.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const open = t.closest<HTMLElement>('[data-open]');
    const cmp = t.closest<HTMLElement>('[data-cmp]');
    if (open) openDetail(all.find((x) => x.id === open.dataset.open)!);
    if (cmp) {
      toggleCompare(cmp.dataset.cmp!);
      if ($<HTMLDialogElement>('dlg-compare').open) compare.length ? openCompare() : $<HTMLDialogElement>('dlg-compare').close();
    }
    if (t.closest('[data-close]')) t.closest('dialog')?.close();
  });
  document.querySelectorAll('dialog').forEach((d) => d.addEventListener('click', (ev) => { if (ev.target === d) d.close(); }));
  Object.values(els).forEach((el) => el.addEventListener(el.tagName === 'INPUT' && (el as HTMLInputElement).type === 'search' ? 'input' : 'change', () => { shown = PAGE; render(); }));
  $('rs-more').addEventListener('click', () => { shown += PAGE; render(); });
  $('open-compare').addEventListener('click', openCompare);
  $('open-submit').addEventListener('click', () => $<HTMLDialogElement>('dlg-submit').showModal());
  $('f-reset').addEventListener('click', () => {
    els.q.value = ''; [els.disc, els.region, els.month, els.status].forEach((s) => (s.value = 'All'));
    els.band.value = 'all'; els.virtual.checked = true; els.confirmed.checked = false; shown = PAGE; render();
  });

  fetch('/data/runsphere/events.json')
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
    .then((data: { generatedAt: string; sources: Record<string, number>; events: RaceEvent[] }) => {
      all = data.events.filter((e) => { const d = parseDate(e.date); return d >= today && d < windowEnd; });
      const uniq = (a: string[]) => [...new Set(a)].sort();
      fillSelect(els.disc, uniq(all.map((e) => e.discipline)));
      const regions = uniq(all.map((e) => e.region));
      fillSelect(els.region, regions.filter((r) => r.startsWith('India')));
      fillSelect(els.region, ['International']);
      els.region.lastElementChild!.textContent = 'International (all)';
      fillSelect(els.region, regions.filter((r) => r.startsWith('International')), (r) => `   ${r.replace('International - ', '')}`);
      fillSelect(els.month, uniq(all.map((e) => e.date.slice(0, 7))), (m) => fmtMonth(parseDate(`${m}-01`)));
      fillSelect(els.status, uniq(all.map((e) => e.status)));
      const when = new Date(data.generatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      $('rs-meta').textContent = `${fmtMonth(today)} → ${fmtMonth(windowEnd)} · last refreshed ${when} · ${Object.entries(data.sources).map(([k, v]) => `${k} ${v}`).join(' · ')}`;
      render();
    })
    .catch((err) => { $('rs-meta').textContent = `Couldn't load the calendar (${err.message}). Please try again later.`; });
</script>
