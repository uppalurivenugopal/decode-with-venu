---
// PRYSM — multi-agent account intelligence for presales.
// The live engine (Python + FastAPI + LangGraph) runs as an internal tool; this page is a showcase
// with a working, read-only sample built from two real reports (public/data/prysm/*.json).
// Dark "prism stage" bands use the logo's own palette and are scoped to #prysm; everything
// else follows the site's cream editorial system.
import Layout from '../../layouts/Layout.astro';

const bands = [
  { key: 'find', name: 'Find the opportunity', colour: 'var(--p-violet)', lenses: [
    ['Opportunity Brief', 'Ranked sales plays for your services: why now, pains, talking points, who to target, what to ask'],
    ['Buying Signals', 'Leadership changes, M&A, restructuring, earnings misses and engineering-hiring spikes'],
  ] },
  { key: 'understand', name: 'Understand the company', colour: 'var(--p-indigo)', lenses: [
    ['About the company', 'What it does, where it operates, scale, listing'],
    ['Business Model Canvas', 'The nine blocks of how it creates and captures value'],
    ['Value Chain & Footprint', 'Where it plays in its industry chain, by region and segment'],
    ['Capability Map', 'The industry capability map with its evidenced areas lit up'],
    ['Financials & Drivers', 'Every line item, what moved it, and where you can help'],
    ['Leadership Strategy', 'What management says it is prioritising and funding'],
  ] },
  { key: 'market', name: 'Read the market', colour: 'var(--p-blue)', lenses: [
    ['Industry View & AI', 'Industry-wide shifts, AI use cases in the field and their measured impact'],
    ['Peer Deep-Dive', 'Competitors’ moves and what each one means for this account'],
    ['Analyst Outlook', 'Consensus, price targets, estimates and rating changes'],
    ['Risks & Challenges', 'Official risk factors and negative news'],
  ] },
  { key: 'account', name: 'Map the account', colour: 'var(--p-teal)', lenses: [
    ['Tech Stack', 'Technologies on its website and in its job ads'],
    ['Vendor Ecosystem', 'Partners, deals, renewals and vendor case studies'],
    ['Key Personas', 'Directors and VPs beyond the C-suite (public metadata only)'],
  ] },
];

const checks = [
  ['Retrieve', 'Every fact starts life as an evidence card: the exact text, its section, the link and the dates.'],
  ['Ground', 'When AI is switched on it sees only those cards. If the answer isn’t there, it must say “Data Unavailable in Public Sources”.'],
  ['Cite', 'Every sentence, number, table cell and highlight carries numbered source badges.'],
  ['Verify', 'Each number must match its source, each ratio is recomputed from raw SEC data, and anything that fails is dropped and logged.'],
  ['Synthesise', 'Only then are sales plays built, and only from facts that passed.'],
];

const sources = ['SEC EDGAR XBRL financials', '10-K business, risk & MD&A text', '8-K event filings', 'Yahoo Finance profile & market data',
  'Analyst consensus & estimates', 'Wikipedia', 'Company websites', 'Google News', 'Bing News + full articles',
  'Greenhouse · Lever · Ashby job boards', 'Website technology fingerprints', 'Vendor sites & case studies'];
const stack = ['Python · FastAPI', 'LangGraph orchestration', 'DuckDB evidence store', 'React · TypeScript · Tailwind',
  'PptxGenJS deck export', 'Claude, in grounded mode (optional)'];
---

<Layout title="PRYSM: account intelligence for presales"
  description="PRYSM splits a company into fifteen lenses a presales lead needs: business model, financial drivers, peers, analysts, industry AI trends and ranked sales plays, with a public source behind every line.">
<div id="prysm">

  <!-- =========================== HERO =========================== -->
  <section class="p-dark p-hero">
    <div class="p-gridlines" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-12 pb-16 sm:pt-16 sm:pb-20">
      <a href="/projects" class="p-back no-print">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M9.5 6h-7M6 2.5L2.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Vibing
      </a>
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="p-eyebrow">Multi-agent research &middot; built for presales</p>
          <h1 class="p-h1">One company.<br /><span class="p-spectrum-text">Every angle.</span></h1>
          <p class="p-lede">
            A prism splits one beam of light into a spectrum. PRYSM does the same to a company name:
            fifteen research agents turn it into the views a presales lead needs, and show the public source behind every line.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#sample" class="p-btn p-btn-solid">Run a live deep dive
              <svg class="w-3.5 h-3.5" viewBox="0 0 12 12" fill="none"><path d="M6 2.5v7M2.5 6L6 9.5 9.5 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#honest" class="p-btn p-btn-ghost">How it stays honest</a>
          </div>
          <dl class="p-stats">
            <div><dt>15</dt><dd>lenses on one account</dd></div>
            <div><dt>12</dt><dd>public source types</dd></div>
            <div><dt id="stat-verified">100%</dt><dd>of numbers checked against source</dd></div>
            <div><dt>0</dt><dd>guesses</dd></div>
          </dl>
        </div>
        <div class="p-logo-wrap">
          <img src="/images/projects/prysm/prysm-logo.png" alt="PRYSM logo: a geometric prism in violet-to-teal light inside three silver chevrons, above the PRYSM wordmark" width="646" height="648" class="p-logo" />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== PROBLEM =========================== -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
    <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Why it exists</p>
    <h2 class="mt-4 max-w-3xl font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">Account prep shouldn&rsquo;t be guesswork.</h2>
    <div class="mt-10 grid gap-x-8 sm:grid-cols-3">
      <div class="card py-6">
        <p class="font-serif text-2xl font-semibold text-fg">Twenty tabs, four hours</p>
        <p class="mt-3 leading-relaxed text-mist-300">Annual reports, earnings calls, job boards, news, analyst notes. The picture exists, but assembling it eats the day before every meeting.</p>
      </div>
      <div class="card py-6">
        <p class="font-serif text-2xl font-semibold text-fg">Fluent, but unsourced</p>
        <p class="mt-3 leading-relaxed text-mist-300">AI will write the brief in seconds, and some of it will be invented. In front of a CFO, one wrong number costs the room.</p>
      </div>
      <div class="card py-6">
        <p class="font-serif text-2xl font-semibold text-fg">Facts with no so-what</p>
        <p class="mt-3 leading-relaxed text-mist-300">Knowing revenue grew 4% doesn&rsquo;t tell you what to pitch. Presales needs the driver behind the number, and the opening it creates.</p>
      </div>
    </div>
  </section>

  <!-- =========================== REFRACTION =========================== -->
  <section class="p-dark p-refract">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
      <p class="p-eyebrow">One input, fifteen lenses</p>
      <h2 class="p-h2">Type a company. PRYSM refracts it.</h2>
      <svg class="p-prism" viewBox="0 0 960 340" role="img" aria-labelledby="prism-t">
        <title id="prism-t">A company name enters as a beam of light, passes through a prism and splits into four coloured rays: find the opportunity, understand the company, read the market, map the account.</title>
        <defs>
          <linearGradient id="pz-stroke" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6b3fb0"/><stop offset=".55" stop-color="#4a7fc1"/><stop offset="1" stop-color="#5fc7da"/></linearGradient>
          <linearGradient id="pz-beam" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#e8fbfc" stop-opacity=".15"/><stop offset="1" stop-color="#e8fbfc"/></linearGradient>
          {bands.map((b, i) => (
            <linearGradient id={`pz-ray-${i}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color={['#8b5cd6', '#6474dd', '#4a96d8', '#5fc7da'][i]} stop-opacity=".95" />
              <stop offset="1" stop-color={['#8b5cd6', '#6474dd', '#4a96d8', '#5fc7da'][i]} stop-opacity=".08" />
            </linearGradient>
          ))}
        </defs>
        <g class="pz-input">
          <rect x="16" y="150" width="190" height="44" rx="22" fill="#0c2026" stroke="rgba(95,199,218,.35)" />
          <circle cx="42" cy="172" r="7" fill="none" stroke="#9db5bb" stroke-width="2"/><path d="M47 177l6 6" stroke="#9db5bb" stroke-width="2" stroke-linecap="round"/>
          <text id="pz-name" x="62" y="177" fill="#e8fbfc" font-size="15" font-weight="600">Caterpillar</text>
        </g>
        <line x1="206" y1="172" x2="428" y2="190" stroke="url(#pz-beam)" stroke-width="4" class="pz-beam"/>
        {bands.map((b, i) => {
          const y = [46, 128, 212, 296][i];
          return (
            <g class="pz-ray" data-band={b.key}>
              <polygon points={`524,${186 + i * 6} 526,${192 + i * 6} 930,${y + 14} 930,${y - 14}`} fill={`url(#pz-ray-${i})`} opacity=".55" />
              <line x1="525" y1={189 + i * 6} x2="930" y2={y} stroke={['#8b5cd6', '#6474dd', '#4a96d8', '#5fc7da'][i]} stroke-width="2.5" class="pz-flow" />
              <text x="940" y={y - 22} text-anchor="end" fill={['#b79cf0', '#9aa6f0', '#86bdf0', '#8fe0ee'][i]} font-size="15" font-weight="700">{b.name}</text>
            </g>
          );
        })}
        <g class="pz-prism">
          <polygon points="476,62 386,300 566,300" fill="rgba(7,22,26,.85)" stroke="url(#pz-stroke)" stroke-width="5" stroke-linejoin="round"/>
          <path d="M476 62 V226 M476 226 L386 300 M476 226 L566 300 M431 181 L476 226 M521 181 L476 226 M431 181 L476 62 M521 181 L476 62" stroke="url(#pz-stroke)" stroke-width="2.5" opacity=".85" fill="none"/>
        </g>
      </svg>

      <div class="p-bands">
        {bands.map((b) => (
          <div class="p-band" data-band={b.key} style={`--band:${b.colour}`} tabindex="0">
            <p class="p-band-name">{b.name}</p>
            <ul>
              {b.lenses.map(([t, d]) => (<li><span>{t}</span>{d}</li>))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== LIVE SAMPLE =========================== -->
  <section id="sample" class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Try it live</p>
        <h2 class="mt-4 max-w-3xl font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">Search a company. Click any number. See where it came from.</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-mist-300">Run a live deep dive on any US-listed company, or explore the two ready-made samples. Move through the tabs, open any numbered badge to see the exact source, and download the report as Word or PDF.</p>
      </div>
      <div class="p-brand-tile" aria-hidden="true">
        <img src="/images/projects/prysm/prysm-logo.png" alt="" width="646" height="648" />
      </div>
    </div>

    <div class="p-disclaimer" role="note">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l9.5 16.5h-19L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 10v4.5M12 17.2v.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <p><strong>AI-generated content. It may contain errors.</strong> PRYSM's reports are produced automatically by AI research agents
        from public sources and can be incomplete, wrong or out of date. Check important facts against the cited sources before you rely on them.
        Not financial, investment or legal advice, and no affiliation with the companies shown.</p>
    </div>

    <form class="p-search" id="p-search" autocomplete="off">
      <label class="p-search-box">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input id="p-q" name="q" maxlength="80" placeholder="Company name or ticker, e.g. Nvidia or WMT" aria-label="Company name or stock ticker" />
        <button type="submit" id="p-go">Deep dive</button>
      </label>
      <label class="p-ack" id="p-ack-wrap">
        <input type="checkbox" id="p-ack" />
        <span>I understand this is AI-generated content that may contain errors, and I'll verify important facts against the cited sources.</span>
      </label>
      <p class="p-search-msg" id="p-msg" role="status"></p>
    </form>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="text-sm text-mist-400">Reports:</span>
      <div class="p-switch" role="tablist" aria-label="Report" id="p-switch">
        <button type="button" role="tab" data-co="caterpillar" aria-selected="true">Caterpillar <small>sample</small></button>
        <button type="button" role="tab" data-co="datadog" aria-selected="false">Datadog <small>sample</small></button>
      </div>
    </div>

    <div class="p-app" id="p-app">
      <div class="p-app-bar">
        <span class="p-app-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <img src="/images/projects/prysm/prysm-logo.png" alt="" width="28" height="28" class="p-app-logo" />
        <span class="p-app-brand">PRYSM</span>
        <span class="p-app-co" id="p-co-name">Loading…</span>
        <span class="p-app-meta" id="p-co-meta"></span>
        <span class="p-app-dl">
          <button type="button" id="p-dl-word" title="Download as a Word document">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2.5v8M4.5 7.5L8 11l3.5-3.5M3 13.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Word</button>
          <button type="button" id="p-dl-pdf" title="Download as PDF (opens the print dialog: choose Save as PDF)">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2.5v8M4.5 7.5L8 11l3.5-3.5M3 13.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>PDF</button>
        </span>
      </div>
      <div class="p-tabs" role="tablist" aria-label="Report sections">
        <button type="button" role="tab" data-tab="overview" aria-selected="true">Overview</button>
        <button type="button" role="tab" data-tab="plays" aria-selected="false">Sales plays</button>
        <button type="button" role="tab" data-tab="drivers" aria-selected="false">Financial drivers</button>
        <button type="button" role="tab" data-tab="market" aria-selected="false">Market</button>
        <button type="button" role="tab" data-tab="competitors" aria-selected="false">Competitors <span class="p-new">New</span></button>
        <button type="button" role="tab" data-tab="signals" aria-selected="false">Signals</button>
      </div>
      <div class="p-body" id="p-body" aria-live="polite"></div>
      <div class="p-app-foot">AI-generated by PRYSM from public sources · may contain errors · verify important facts with the cited sources</div>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-mist-400" id="p-note"></p>
  </section>

  <!-- =========================== HONESTY =========================== -->
  <section id="honest" class="p-dark">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
      <p class="p-eyebrow">Zero guesswork</p>
      <h2 class="p-h2">Five checks before anything reaches the screen.</h2>
      <ol class="p-checks">
        {checks.map(([t, d], i) => (
          <li><span class="p-check-n">{String(i + 1).padStart(2, '0')}</span><p class="p-check-t">{t}</p><p class="p-check-d">{d}</p></li>
        ))}
      </ol>
      <div class="p-proof" id="p-proof"></div>
    </div>
  </section>

  <!-- =========================== UNDER THE HOOD =========================== -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20">
    <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Under the hood</p>
    <h2 class="mt-4 max-w-3xl font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">Fourteen agents, one synthesis.</h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-mist-300">
      A fixed workflow sends fourteen research agents out in parallel, verifies everything they bring back,
      and only then lets a fifteenth agent turn the verified findings into sales plays for the services your firm actually sells.
    </p>
    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div class="card pt-6">
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-indigo-glow">Sources it reads</p>
        <div class="p-chips">{sources.map((s) => <span>{s}</span>)}</div>
      </div>
      <div class="card pt-6">
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-indigo-glow">Built with</p>
        <div class="p-chips">{stack.map((s) => <span>{s}</span>)}</div>
        <p class="mt-5 leading-relaxed text-mist-300">
          Two modes: <strong class="text-fg">extractive</strong>, where every sentence is a verbatim source excerpt, and
          <strong class="text-fg">grounded AI</strong>, where Claude condenses the evidence but is checked line by line against it.
          The financial maths is always done in code. Export any set of sections to a slide deck with the source numbers intact.
        </p>
      </div>
    </div>
  </section>

  <section class="p-dark p-close">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-6 px-5 sm:px-8 py-10">
      <img src="/images/projects/prysm/prysm-logo.png" alt="" width="72" height="72" class="h-[72px] w-[72px] rounded-sm" />
      <p class="max-w-2xl leading-relaxed text-[#9db5bb]">
        The full PRYSM engine runs as an internal tool for presales teams. This page runs PRYSM Live, a lighter public version for US-listed companies, built entirely on public sources.
      </p>
      <a href="/projects" class="p-btn p-btn-ghost ml-auto">More Vibing builds</a>
    </div>
  </section>

  <!-- Citation drawer -->
  <div class="p-scrim" id="p-scrim" hidden></div>
  <aside class="p-drawer" id="p-drawer" role="dialog" aria-modal="true" aria-labelledby="p-dr-title" hidden>
    <button type="button" class="p-dr-close" id="p-dr-close" aria-label="Close source">&times;</button>
    <div id="p-dr-body"></div>
  </aside>
</div>
</Layout>

<style is:global>
  #prysm {
    --p-bg: #07161a; --p-bg2: #0c2026; --p-line: rgba(95, 199, 218, 0.16);
    --p-ink: #e8fbfc; --p-mute: #9db5bb; --p-silver: #d6d6d6;
    --p-violet: #8b5cd6; --p-indigo: #6474dd; --p-blue: #4a96d8; --p-teal: #5fc7da;
    --a-accent: #0e8297; --a-violet: #6a3fb5; --a-ink: var(--color-fg); --a-line: color-mix(in srgb, var(--color-edge) 12%, transparent);
  }
  /* ---------- dark prism stage ---------- */
  #prysm .p-dark { position: relative; background: var(--p-bg); color: var(--p-ink); overflow: hidden; }
  #prysm .p-gridlines { position: absolute; inset: 0; background-image: linear-gradient(var(--p-line) 1px, transparent 1px), linear-gradient(90deg, var(--p-line) 1px, transparent 1px); background-size: 46px 46px; opacity: .35; mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 70%); }
  #prysm .p-back { display: inline-flex; align-items: center; gap: .4rem; font-size: 12px; color: var(--p-mute); margin-bottom: 1.75rem; }
  #prysm .p-back:hover { color: var(--p-ink); }
  #prysm .p-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--p-teal); }
  #prysm .p-h1 { margin-top: 1.1rem; font-family: var(--font-serif); font-weight: 600; font-size: clamp(3rem, 7vw, 5.4rem); line-height: .95; letter-spacing: -.045em; }
  #prysm .p-h2 { margin-top: 1rem; max-width: 48rem; font-family: var(--font-serif); font-weight: 600; font-size: clamp(2.2rem, 4.6vw, 3.4rem); line-height: 1.02; letter-spacing: -.035em; }
  #prysm .p-spectrum-text { background: linear-gradient(90deg, var(--p-violet), var(--p-indigo) 35%, var(--p-blue) 65%, var(--p-teal)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  #prysm .p-lede { margin-top: 1.5rem; max-width: 36rem; font-size: 1.15rem; line-height: 1.65; color: var(--p-mute); }
  #prysm .p-btn { display: inline-flex; align-items: center; gap: .5rem; padding: .8rem 1.25rem; font-size: 15px; font-weight: 600; border: 1px solid transparent; transition: background .15s, color .15s, border-color .15s; }
  #prysm .p-btn-solid { background: var(--p-teal); color: var(--p-bg); }
  #prysm .p-btn-solid:hover { background: var(--p-ink); }
  #prysm .p-btn-ghost { border-color: rgba(232, 251, 252, .3); color: var(--p-ink); }
  #prysm .p-btn-ghost:hover { border-color: var(--p-teal); color: var(--p-teal); }
  #prysm .p-stats { margin-top: 2.75rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; border-top: 1px solid var(--p-line); padding-top: 1.25rem; }
  #prysm .p-stats dt { font-family: var(--font-serif); font-size: 2rem; font-weight: 600; letter-spacing: -.03em; color: var(--p-ink); }
  #prysm .p-stats dd { font-size: 13px; line-height: 1.35; color: var(--p-mute); }
  @media (max-width: 640px) { #prysm .p-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  #prysm .p-logo-wrap { display: flex; justify-content: center; }
  #prysm .p-logo { width: min(100%, 420px); height: auto; animation: p-rise 1s ease-out both; }
  @keyframes p-rise { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: none; } }

  /* ---------- refraction ---------- */
  #prysm .p-prism { display: block; width: 100%; height: auto; margin-top: 2.5rem; overflow: visible; font-family: var(--font-sans); }
  #prysm .pz-beam { stroke-dasharray: 10 10; animation: p-flow 1.1s linear infinite; }
  #prysm .pz-flow { stroke-dasharray: 8 12; animation: p-flow 1.3s linear infinite; }
  @keyframes p-flow { to { stroke-dashoffset: -40; } }
  #prysm .pz-ray { transition: opacity .25s; }
  #prysm .p-refract[data-hot] .pz-ray { opacity: .18; }
  #prysm .p-refract[data-hot] .pz-ray.is-hot { opacity: 1; }
