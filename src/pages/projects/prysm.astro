  #prysm .dr-meta dd { font-size: 13.5px; font-weight: 600; word-break: break-word; }
  #prysm .dr-link { display: block; border: 1px solid var(--a-line); padding: .7rem .85rem; color: var(--a-accent); font-size: 13.5px; word-break: break-all; }
  #prysm .dr-link:hover { background: #f4fbfc; }

  /* ---------- checks ---------- */
  #prysm .p-checks { margin-top: 2.75rem; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.25rem; counter-reset: c; }
  @media (max-width: 960px) { #prysm .p-checks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { #prysm .p-checks { grid-template-columns: 1fr; } }
  #prysm .p-checks li { position: relative; border-top: 1px solid var(--p-line); padding-top: 1rem; }
  #prysm .p-checks li::before { content: ''; position: absolute; top: -1px; left: 0; width: 42px; height: 3px; background: linear-gradient(90deg, var(--p-violet), var(--p-teal)); }
  #prysm .p-check-n { font-size: 12px; font-weight: 700; letter-spacing: .14em; color: var(--p-teal); }
  #prysm .p-check-t { margin-top: .35rem; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; }
  #prysm .p-check-d { margin-top: .5rem; font-size: 14px; line-height: 1.55; color: var(--p-mute); }
  #prysm .p-proof { margin-top: 2.75rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; background: var(--p-bg2); border: 1px solid var(--p-line); padding: 1.25rem 1.5rem; }
  @media (max-width: 760px) { #prysm .p-proof { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  #prysm .p-proof b { display: block; font-family: var(--font-serif); font-size: 2rem; font-weight: 600; color: var(--p-ink); }
  #prysm .p-proof span { font-size: 13px; color: var(--p-mute); }
  #prysm .p-proof p { grid-column: 1 / -1; font-size: 12.5px; color: var(--p-mute); }

  #prysm .p-chips { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  #prysm .p-chips span { border: 1px solid color-mix(in srgb, var(--color-edge) 18%, transparent); padding: .35rem .7rem; font-size: 13.5px; color: var(--color-fg); }

  @media (prefers-reduced-motion: reduce) {
    #prysm .pz-beam, #prysm .pz-flow, #prysm .p-logo, #prysm .p-drawer { animation: none; }
  }
  @media print { #prysm .p-dark { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style>

<script>
  import { exportPdf, exportWord } from '../../scripts/prysm-export';
  type Cl = { t: string; c: string[]; i?: number };
  type Met = { l: string; d: string; p: string; c: string[]; f?: string };
  type Ev = { s: string; ty: string; sec: string; q: string; u: string; pd: string | null; fd: string; b: string };
  type Sample = {
    company: { name: string; ticker: string; cik: string; domain: string; industry: string };
    generated: string; mode: string;
    verification: { numbers_checked: number; numbers_verified: number; metrics_checked: number; metrics_verified: number; claims_dropped: number };
    about: { claims: Cl[]; facts: { l: string; v: string; c: string[] }[]; regions: { n: string; d: string; c: string[] }[] };
    kpis: Met[];
    plays: { o: string; cat: string; conf: string; score: number; why: Cl[]; pain: Cl[]; talk: Cl[]; roles: string[]; q: string[]; mods: string[] }[];
    lines: { l: string; g: string; v: Met; yoy: Met | null; share: Met | null; shift: Met | null; a: string; drv: Cl[]; angle: { o: string; r: Cl } | null }[];
    peers: { n: string; t: string; rel: string; threat: string; m: { v: string; c: string[] }[]; moves: { k: string; d: string; dt: string; u: string; c: string[] }[]; imp: Cl[] }[];
    trends: { t: string; k: string; mom: string; def: string; imp: Cl[]; use: Cl[]; rel: Cl[] }[];
    signals: { k: string; d: string; dt: string; c: string[] }[];
    evidence: Record<string, Ev>;
  };

  const root = document.getElementById('prysm')!;
  const body = document.getElementById('p-body')!;
  const cache: Record<string, Sample> = {};
  let data: Sample | null = null;
  let tab = 'overview';
  let peerIdx = 0;
  let numbers = new Map<string, number>();
  const openRows = new Set<number>();

  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));

  /** Number every cited source once, in a fixed reading order, so a source keeps its number across tabs. */
  function numberAll(d: Sample) {
    const m = new Map<string, number>();
    const add = (ids: string[] = []) => ids.forEach((id) => { if (!m.has(id) && d.evidence[id]) m.set(id, m.size + 1); });
    d.about.claims.forEach((c) => add(c.c)); d.about.facts.forEach((f) => add(f.c)); d.about.regions.forEach((r) => add(r.c));
    d.kpis.forEach((k) => add(k.c));
    d.plays.forEach((p) => [...p.why, ...p.pain, ...p.talk].forEach((c) => add(c.c)));
    d.lines.forEach((l) => { [l.v, l.yoy, l.share, l.shift].forEach((x) => x && add(x.c)); l.drv.forEach((c) => add(c.c)); if (l.angle) add(l.angle.r.c); });
    d.peers.forEach((p) => { p.m.forEach((c) => add(c.c)); p.moves.forEach((mv) => add(mv.c)); p.imp.forEach((c) => add(c.c)); });
    d.trends.forEach((t) => [...t.imp, ...t.use, ...t.rel].forEach((c) => add(c.c)));
    d.signals.forEach((s) => add(s.c));
    return m;
  }

  const cites = (ids: string[] = []) => [...new Set(ids)].filter((id) => numbers.has(id))
    .map((id) => `<button type="button" class="cite" data-ev="${id}" aria-label="Source ${numbers.get(id)}">${numbers.get(id)}</button>`).join('');
  const claim = (c: Cl) => `<li class="${c.i ? 'inf' : ''}"><span>${c.i ? '<span class="a-inf">Inference</span>' : ''}${esc(c.t)} ${cites(c.c)}</span></li>`;
  const claims = (cs: Cl[]) => cs.length ? `<ul class="a-claims">${cs.map(claim).join('')}</ul>` : '<p class="text-sm italic text-mist-400">Data Unavailable in Public Sources</p>';

  function overview(d: Sample) {
    const a = d.about;
    return `
      <div class="a-grid2">
        <div>
          <p class="a-h">About the company</p>
          <p class="a-title">${esc(d.company.name)}</p>
          ${claims(a.claims)}
          ${a.regions.length ? `<p class="a-h" style="margin-top:1.25rem">Where it operates</p>
            <div class="a-chipset">${a.regions.map((r) => `<span class="a-chip">${esc(r.n)} <span style="color:var(--color-mist-400)">· ${esc(r.d)}</span>${cites(r.c)}</span>`).join('')}</div>` : ''}
        </div>
        <dl class="a-facts">${a.facts.map((f) => `<div class="a-fact"><dt>${esc(f.l)}</dt><dd>${esc(f.v)} ${cites(f.c)}</dd></div>`).join('')}</dl>
      </div>
      <div class="a-sec" style="margin-top:2rem">
        <p class="a-h">Key numbers</p>
        <div class="a-kpis">${d.kpis.map((k) => `<div class="a-kpi" title="${esc(k.f || '')}"><span>${esc(k.l)}</span><b>${esc(k.d)}</b><span>${esc(k.p)} ${cites(k.c)}</span></div>`).join('')}</div>
      </div>
      <div class="a-sec">
        <p class="a-h">Top sales plays</p>
        <div class="a-chipset">${d.plays.map((p, i) => `<button type="button" class="a-chip" data-go="plays"><b>${i + 1}</b> ${esc(p.o)} <span class="a-conf ${p.conf}">${p.conf}</span></button>`).join('')}</div>
      </div>`;
  }

  function plays(d: Sample) {
    return `<div class="a-plays">${d.plays.map((p, i) => `
      <article class="a-play">
        <div class="a-play-head">
          <span class="a-rank">${i + 1}</span>
          <div><p class="a-cat">${esc(p.cat)}</p><p class="a-play-t">${esc(p.o)}</p>
            <p style="margin-top:.35rem"><span class="a-conf ${p.conf}">${p.conf} confidence</span>
            <span style="font-size:12px;color:var(--color-mist-400)"> · evidence from ${p.mods.length} sections</span></p></div>
        </div>
        <div><p class="a-h">Why now</p>${claims(p.why)}</div>
        ${p.pain.length ? `<div><p class="a-h">Pain point</p>${claims(p.pain)}</div>` : ''}
        <div><p class="a-h">Talking point</p>${claims(p.talk)}</div>
        <div><p class="a-h">Who to target</p><div class="a-chipset">${p.roles.map((r) => `<span class="a-chip">${esc(r)}</span>`).join('')}</div></div>
        <div><p class="a-h">Ask in discovery</p><ol class="a-q">${p.q.map((q) => `<li>${esc(q)}</li>`).join('')}</ol></div>
      </article>`).join('')}</div>`;
  }

  function drivers(d: Sample) {
    let lastG = '';
    const rows = d.lines.map((l, i) => {
      const g = l.g !== lastG ? `<tr class="a-group"><td colspan="7">${esc(l.g)}</td></tr>` : '';
      lastG = l.g;
      const open = openRows.has(i);
      const detail = open ? `<tr class="a-detail"><td colspan="7"><div class="a-detail-grid">
          <div><p class="a-h">Driver, in management's words</p>${l.drv.length ? claims(l.drv) : '<p class="text-sm italic text-mist-400">The filing does not explain this change.</p>'}</div>
          ${l.angle ? `<div class="a-anglebox"><p class="a-h" style="color:var(--a-violet)">Sales angle · ${esc(l.angle.o)}</p>${esc(l.angle.r.t)} ${cites(l.angle.r.c)}</div>` : '<div></div>'}
        </div></td></tr>` : '';
      return `${g}<tr class="a-row" data-row="${i}" aria-expanded="${open}">
        <td><b>${open ? '▾' : '▸'}</b> ${esc(l.l)}</td>
        <td>${esc(l.v.d)} ${cites(l.v.c)}</td>
        <td>${l.yoy ? esc(l.yoy.d) : '—'}</td>
        <td>${l.share ? esc(l.share.d) : '—'}</td>
        <td>${l.shift ? esc(l.shift.d) : '—'}</td>
        <td><span class="a-read ${l.a}">${esc(l.a)}</span></td>
        <td>${l.angle ? `<span class="a-angle">${esc(l.angle.o)}</span>` : '—'}</td></tr>${detail}`;
    }).join('');
    return `<p class="a-h">What moved, why, and where you can help <span style="text-transform:none;letter-spacing:0;font-weight:500">· click a row</span></p>
      <div class="a-scroll"><table class="a-table"><thead><tr><th>Line item</th><th>FY value</th><th>YoY</th><th>% of revenue</th><th>Shift</th><th>Read</th><th>Sales angle</th></tr></thead><tbody>${rows}</tbody></table></div>
      <p style="margin-top:.75rem;font-size:12.5px;color:var(--color-mist-400)">Every figure is recomputed from raw SEC XBRL data before it is shown.</p>`;
  }

  function market(d: Sample) {
    const p = d.peers[Math.min(peerIdx, d.peers.length - 1)];
    const cols = ['Revenue (FY)', 'Growth', 'Op. margin', 'R&D %', 'Employees', 'Market cap'];
    return `
      <p class="a-h">Competitive landscape</p>
      <div class="a-scroll"><table class="a-table"><thead><tr><th>Peer</th><th>Relationship</th>${cols.map((c) => `<th>${c}</th>`).join('')}<th>Threat</th></tr></thead><tbody>
        ${d.peers.map((x, i) => `<tr class="a-row" data-peer="${i}"><td><b>${esc(x.n)}</b> <span style="color:var(--color-mist-400)">${esc(x.t)}</span></td>
          <td style="font-size:12.5px;color:var(--color-mist-400)">${esc(x.rel.replace(' (Yahoo Finance)', ''))}</td>
          ${x.m.map((c) => `<td>${esc(c.v)} ${cites(c.c)}</td>`).join('')}<td><span class="a-threat ${x.threat}">${esc(x.threat)}</span></td></tr>`).join('')}
      </tbody></table></div>
      ${p ? `<div class="a-peerbtns">${d.peers.map((x, i) => `<button type="button" data-peer="${i}" aria-pressed="${i === peerIdx}">${esc(x.n)}</button>`).join('')}</div>
      <div class="a-grid2">
        <div><p class="a-h">${esc(p.n)}: recent moves</p>
          ${p.moves.length ? `<ol class="a-moves">${p.moves.map((m) => `<li><b>${esc(m.k)} · ${esc(m.dt)}</b>${esc(m.d)} ${cites(m.c)}</li>`).join('')}</ol>` : '<p class="text-sm italic text-mist-400">No recent moves found in news.</p>'}</div>
        <div class="a-impact"><p class="a-h" style="color:var(--a-violet)">Impact on ${esc(d.company.name.replace(/,? Inc\.?$/, ''))} → what to do</p>${claims(p.imp)}</div>
      </div>` : ''}
      <div class="a-sec">
        <p class="a-h">Industry shifts, beyond this company</p>
        <div class="a-trends">${d.trends.map((t) => `<div class="a-trend">
          <span class="a-kind">${t.k === 'AI' ? 'AI shift' : 'Market shift'} · ${esc(t.mom)} momentum</span>
          <p class="a-play-t">${esc(t.t)}</p>
          ${t.imp.map((c) => `<div class="a-quote">${esc(c.t)} ${cites(c.c)}</div>`).join('')}
          ${t.use.length ? `<div><p class="a-h">Use cases in the field</p>${claims(t.use)}</div>` : ''}
          ${t.rel.length ? `<div><p class="a-h">Relevance to this account</p>${claims(t.rel)}</div>` : ''}
        </div>`).join('')}</div>
      </div>`;
  }

  // ---------------------------------------------------------------- competitor scan
  type CompClaim = Cl;
  type CompCo = { ticker: string; name: string; industry: string; fy: string; m: Record<string, { d: string; c: string[]; best?: number }>;
    own: CompClaim[]; nums: CompClaim[]; customer: { flag: string; claims: CompClaim[] }; geo: { flag: string; claims: CompClaim[] };
    diff: CompClaim[]; short: CompClaim[]; long: CompClaim[] };
  type CompResult = { generated: string; rows: { key: string; label: string; dir: string }[]; companies: CompCo[];
    verification: Sample['verification']; evidence: Record<string, Ev> };
  type CompState = { status: 'idle' | 'suggesting' | 'ready' | 'comparing' | 'done' | 'error'; subject?: { ticker: string; name: string };
    options: { ticker: string; name: string; reason: string }[]; selected: Set<string>; result?: CompResult; view: string; msg: string };
  const compStates: Record<string, CompState> = {};
  let currentKey = 'caterpillar';
  const MAX_PEERS = 4;
  const comp = () => (compStates[currentKey] ??= { status: 'idle', options: [], selected: new Set(), view: 'fin', msg: '' });

  async function compSuggest() {
    const st = comp(); if (!data || st.status !== 'idle') return;
    st.status = 'suggesting'; render();
    try {
      const r = await fetch(`/api/prysm-compare?suggest=${encodeURIComponent(data.company.ticker)}`);
      const j = await r.json();
      if (!r.ok || j.error) throw new Error(j.error || 'failed');
      st.subject = j.subject; st.options = j.suggestions; st.selected = new Set(j.suggestions.map((x: { ticker: string }) => x.ticker));
      st.status = 'ready';
    } catch { st.status = 'error'; st.msg = 'Couldn\u2019t load suggested competitors. You can still add competitors yourself.'; st.subject = { ticker: data.company.ticker, name: data.company.name }; }
    render();
  }

  function paragraph(cs: CompClaim[], empty = 'Not disclosed in the latest 10-K text.') {
    if (!cs.length) return `<p class="c-empty">${empty}</p>`;
    return `<p class="c-para">${cs.map((c) => `${c.i ? '<span class="a-inf">Inference</span>' : ''}${esc(c.t)} ${cites(c.c)}`).join(' ')}</p>`;
  }

  function compResultHtml(res: CompResult, view: string) {
    const cos = res.companies;
    const views: [string, string][] = [['fin', 'Financials'], ['growth', 'Growth strategy'], ['conc', 'Customer & geo concentration'], ['diff', 'Differentiators'], ['outlook', 'Market outlook']];
    const head = `<div class="c-views" role="tablist">${views.map(([k, l]) => `<button type="button" data-cview="${k}" aria-selected="${k === view}">${l}</button>`).join('')}</div>`;
    let bodyHtml = '';
    if (view === 'fin') {
      bodyHtml = `<div class="a-scroll"><table class="a-table c-table"><thead><tr><th>Indicator</th>${cos.map((c, i) => `<th class="${i === 0 ? 'c-subj' : ''}">${esc(c.name)}<small>${esc(c.ticker)}${c.fy ? ` · FY ${esc(c.fy.slice(0, 4))}` : ''}</small></th>`).join('')}</tr></thead><tbody>
        ${res.rows.map((r) => `<tr><td>${esc(r.label)}</td>${cos.map((c, i) => { const v = c.m[r.key]; return `<td class="${i === 0 ? 'c-subj' : ''}${v?.best ? ' c-best' : ''}">${v ? `${esc(v.d)} ${cites(v.c)}` : '—'}</td>`; }).join('')}</tr>`).join('')}
      </tbody></table></div><p class="c-note">Latest fiscal year per company from SEC XBRL, every figure recomputed before display. <span class="c-best-key">Shaded</span> = best in group (lower is better for cost ratios and leverage). Fiscal year-ends differ.</p>`;
    } else {
      const col = (c: CompCo, i: number) => {
        let inner = '';
        if (view === 'growth') inner = `<p class="a-h">In its own words</p>${paragraph(c.own)}<p class="a-h">What the numbers say</p>${paragraph(c.nums, 'Not enough comparable data.')}`;
        if (view === 'conc') inner = `<p class="a-h">Customer concentration</p><p class="c-flag">${esc(c.customer.flag)}</p>${paragraph(c.customer.claims)}<p class="a-h">Geographic concentration</p><p class="c-flag">${esc(c.geo.flag)}</p>${paragraph(c.geo.claims)}`;
        if (view === 'diff') inner = c.diff.length ? `<ul class="a-claims">${c.diff.map(claim).join('')}</ul>` : '<p class="c-empty">Not stated in the latest 10-K text.</p>';
        if (view === 'outlook') inner = `<p class="a-h">Short term (next 12–18 months)</p>${paragraph(c.short)}<p class="a-h">Long term (3–5 years)</p>${paragraph(c.long)}${c.m.cagr ? `<p class="c-flag">3-year revenue CAGR: ${esc(c.m.cagr.d)} ${cites(c.m.cagr.c)}</p>` : ''}`;
        return `<article class="c-col${i === 0 ? ' c-col-subj' : ''}"><header><b>${esc(c.name)}</b><small>${esc(c.ticker)} · ${esc(c.industry)}</small></header>${inner}</article>`;
      };
      bodyHtml = `<div class="c-cols">${cos.map(col).join('')}</div>`;
    }
    const v = res.verification;
    return `${head}${bodyHtml}<p class="c-note">Comparison generated ${esc(res.generated)} · ${v.metrics_verified}/${v.metrics_checked} metrics recomputed · ${v.numbers_verified}/${v.numbers_checked} numbers in quotes matched to source. Text is quoted from each company\u2019s latest 10-K; \u201cwhat the numbers say\u201d is a computed comparison (inference). AI-generated; may contain errors.</p>`;
  }

  function competitors(d: Sample) {
    const st = comp();
    if (st.status === 'idle') { setTimeout(compSuggest, 0); }
    if (st.status === 'idle' || st.status === 'suggesting') return `<p class="a-h">Competitor scan</p><ol class="p-progress"><li class="on">Finding ${esc(d.company.name)}\u2019s nearest competitors (10-K, industry code, investor peer lists)</li></ol>`;
    const chosen = st.selected.size;
    const opts = st.options.map((o) => `<label class="c-opt${st.selected.has(o.ticker) ? ' on' : ''}"><input type="checkbox" data-comp-toggle="${esc(o.ticker)}" ${st.selected.has(o.ticker) ? 'checked' : ''} ${!st.selected.has(o.ticker) && chosen >= MAX_PEERS ? 'disabled' : ''} />
      <span><b>${esc(o.name)}</b> <small>${esc(o.ticker)}</small><em>${esc(o.reason)}</em></span></label>`).join('');
    const busy = st.status === 'comparing';
    return `
      <div class="c-head">
        <div><p class="a-h">Competitor scan</p><p class="a-title" style="margin-bottom:.25rem">${esc(d.company.name)} vs. its nearest competitors</p>
        <p class="c-sub">Pick up to ${MAX_PEERS} competitors (${chosen}/${MAX_PEERS} selected), add your own, then compare on financials, growth strategy, concentration, differentiators and market outlook.</p></div>
      </div>
      <div class="c-opts">${opts || '<p class="c-empty">No suggestions found. Add competitors below.</p>'}</div>
      <form class="c-add" id="c-add" autocomplete="off">
        <input id="c-add-q" maxlength="80" placeholder="Add a competitor: name or ticker (US-listed)" aria-label="Add a competitor by name or ticker" ${chosen >= MAX_PEERS ? 'disabled' : ''} />
        <button type="submit" ${chosen >= MAX_PEERS ? 'disabled' : ''}>Add</button>
        <button type="button" class="c-run" id="c-run" ${!chosen || busy ? 'disabled' : ''}>${busy ? 'Comparing…' : `Compare ${chosen + 1} companies`}</button>
      </form>
      <p class="p-search-msg">${esc(st.msg)}</p>
      ${busy ? `<ol class="p-progress"><li class="on">Reading each company\u2019s SEC financials and latest 10-K, then verifying every number</li></ol>` : ''}
      ${st.result && !busy ? compResultHtml(st.result, st.view) : ''}`;
  }

  async function compAdd(q: string) {
    const st = comp(); st.msg = '';
    if (st.selected.size >= MAX_PEERS) { st.msg = `You can compare up to ${MAX_PEERS} competitors.`; render(); return; }
    try {
      const r = await fetch(`/api/prysm-compare?resolve=${encodeURIComponent(q)}`);
      const j = await r.json();
      if (!r.ok || j.error) { st.msg = `\u201c${q}\u201d isn\u2019t a US-listed (SEC) company. Try its exact name or stock ticker.`; render(); return; }
      if (j.ticker === data?.company.ticker) { st.msg = 'That\u2019s the company you\u2019re researching.'; render(); return; }
      if (!st.options.some((o) => o.ticker === j.ticker)) st.options.push({ ticker: j.ticker, name: j.name, reason: 'Added by you' });
      st.selected.add(j.ticker);
    } catch { st.msg = 'Couldn\u2019t look that company up just now. Please try again.'; }
    render();
  }

  async function compRun() {
    const st = comp(); if (!data || !st.selected.size) return;
    st.status = 'comparing'; st.msg = ''; render();
    const tickers = [data.company.ticker, ...st.options.filter((o) => st.selected.has(o.ticker)).map((o) => o.ticker)];
    try {
      const r = await fetch(`/api/prysm-compare?tickers=${encodeURIComponent(tickers.join(','))}`);
      const j: CompResult & { error?: string } = await r.json();
      if (!r.ok || j.error) throw new Error(j.error);
      // merge sources so badges open in the same drawer and continue the numbering
      Object.assign(data.evidence, j.evidence);
      const walk = (x: unknown) => { if (Array.isArray(x)) x.forEach(walk); else if (x && typeof x === 'object') { const o = x as { c?: string[] }; if (Array.isArray(o.c)) o.c.forEach((id) => { if (!numbers.has(id) && data!.evidence[id]) numbers.set(id, numbers.size + 1); }); Object.values(x).forEach(walk); } };
      walk(j.companies);
      st.result = j; (data as unknown as { comparison?: CompResult }).comparison = j;
      st.status = 'done'; st.view = 'fin';
      track('prysm_compare', { company: data.company.ticker, peers: String(tickers.length - 1) });
    } catch { st.status = 'ready'; st.msg = 'The comparison couldn\u2019t be completed (a data source didn\u2019t respond). Please try again.'; }
    render();
  }

  function signals(d: Sample) {
    return `<p class="a-h">Buying signals & triggers, newest first</p>
      <ul class="a-sig">${d.signals.map((s) => `<li><time>${esc(s.dt)}</time><div><b>${esc(s.k)}</b>${esc(s.d)} ${cites(s.c)}</div></li>`).join('')}</ul>`;
  }

  function render() {
    if (!data) return;
    const d = data;
    body.innerHTML = ({ overview, plays, drivers, market, competitors, signals } as Record<string, (d: Sample) => string>)[tab](d);
    root.querySelectorAll<HTMLButtonElement>('.p-tabs [data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
  }

  function setHeader(d: Sample) {
    document.getElementById('p-co-name')!.textContent = d.company.name;
    document.getElementById('p-co-meta')!.textContent = [d.company.ticker, d.company.industry].filter(Boolean).join(' · ');
    const v = d.verification;
    const when = new Date(d.generated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    document.getElementById('p-note')!.textContent = d.mode === 'live'
      ? `Live result generated on ${when} by PRYSM Live, a lighter public version of the engine: SEC filings and financials, company news, peers and industry headlines. Analyst views, tech stack and capability maps are in the full internal engine. AI-generated; may contain errors.`
      : `Sample generated on ${when} by the full PRYSM engine from public sources (extractive mode: every sentence is a verbatim excerpt). AI-generated; may contain errors.`;
    document.getElementById('p-proof')!.innerHTML = `
      <div><b>${v.numbers_verified}/${v.numbers_checked}</b><span>numbers in sentences matched to their source</span></div>
      <div><b>${v.metrics_verified}/${v.metrics_checked}</b><span>financial metrics recomputed from raw data</span></div>
      <div><b>${Object.keys(d.evidence).length}</b><span>sources cited in this sample</span></div>
      <div><b>${v.claims_dropped}</b><span>claims dropped by the guardrail</span></div>
      <p>Live figures from the ${esc(d.company.name)} sample above.</p>`;
    const pz = document.getElementById('pz-name'); if (pz) pz.textContent = d.company.name.replace(/,? Inc\.?$/, '');
  }

  async function load(slug: string) {
    try {
      if (!cache[slug] && slug.startsWith('live:')) throw new Error('missing');
      if (!cache[slug]) {
        const r = await fetch(`/data/prysm/${slug}.json`);
        if (!r.ok) throw new Error(String(r.status));
        cache[slug] = await r.json();
      }
      data = cache[slug]; currentKey = slug; numbers = numberAll(data); peerIdx = 0; openRows.clear();
      const prior = compStates[slug]?.result;
      if (prior) { const walk = (x: unknown) => { if (Array.isArray(x)) x.forEach(walk); else if (x && typeof x === 'object') { const o = x as { c?: string[] }; if (Array.isArray(o.c)) o.c.forEach((id) => { if (!numbers.has(id) && data!.evidence[id]) numbers.set(id, numbers.size + 1); }); Object.values(x).forEach(walk); } }; walk(prior.companies); }
      data.lines.forEach((l, i) => { if (l.angle) openRows.add(i); });
      setHeader(data); render();
    } catch {
      body.innerHTML = '<p class="text-mist-400">The sample could not be loaded. Please refresh the page.</p>';
    }
  }

  // ---- drawer
  const drawer = document.getElementById('p-drawer')!;
  const scrim = document.getElementById('p-scrim')!;
  let lastFocus: HTMLElement | null = null;
  function openSource(id: string) {
    if (!data) return;
    const e = data.evidence[id];
    if (!e) return;
    lastFocus = document.activeElement as HTMLElement;
    document.getElementById('p-dr-body')!.innerHTML = `
      <div class="dr-head"><small>Source ${numbers.get(id)} · ${esc(e.ty)}</small><h3 id="p-dr-title">${esc(e.s)}</h3><p>${esc(e.sec || e.b)}</p></div>
      <div class="dr-body">
        <div><p class="a-h">Raw context snippet</p><blockquote class="dr-quote">${esc(e.q)}</blockquote></div>
        <dl class="dr-meta">
          <div><dt>Document date</dt><dd>${esc(e.pd || 'Not stated')}</dd></div>
          <div><dt>Fetched</dt><dd>${esc(e.fd)} UTC</dd></div>
          <div><dt>Citation label</dt><dd>${esc(e.b)}</dd></div>
          <div><dt>Evidence ID</dt><dd style="font-family:ui-monospace,monospace;font-size:12px">${esc(id)}</dd></div>
        </dl>
        ${e.u ? `<div><p class="a-h">Source reference</p><a class="dr-link" href="${esc(e.u)}" target="_blank" rel="noopener noreferrer">${esc(e.u)} ↗</a></div>` : ''}
      </div>`;
    drawer.hidden = false; scrim.hidden = false;
    (document.getElementById('p-dr-close') as HTMLButtonElement).focus();
  }
  function closeSource() { drawer.hidden = true; scrim.hidden = true; lastFocus?.focus(); }
  document.getElementById('p-dr-close')!.addEventListener('click', closeSource);
  scrim.addEventListener('click', closeSource);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) closeSource(); });

  // ---- events
  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const cite = t.closest<HTMLElement>('.cite');
    if (cite) { e.stopPropagation(); openSource(cite.dataset.ev!); return; }
    const tabBtn = t.closest<HTMLElement>('.p-tabs [data-tab]');
    if (tabBtn) { tab = tabBtn.dataset.tab!; render(); return; }
    const go = t.closest<HTMLElement>('[data-go]');
    if (go) { tab = go.dataset.go!; render(); return; }
    const co = t.closest<HTMLElement>('.p-switch [data-co]');
    if (co) {
      root.querySelectorAll('.p-switch [data-co]').forEach((b) => b.setAttribute('aria-selected', String(b === co)));
      load(co.dataset.co!); return;
    }
    const peer = t.closest<HTMLElement>('[data-peer]');
    if (peer) { peerIdx = Number(peer.dataset.peer); render(); return; }
    const cview = t.closest<HTMLElement>('[data-cview]');
    if (cview) { comp().view = cview.dataset.cview!; render(); return; }
    if (t.closest('#c-run')) { compRun(); return; }
    const row = t.closest<HTMLElement>('[data-row]');
    if (row) { const i = Number(row.dataset.row); openRows.has(i) ? openRows.delete(i) : openRows.add(i); render(); }
  });

  // ---- competitor selection + add
  body.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.dataset.compToggle) return;
    const st = comp(); st.msg = '';
    if (t.checked) { if (st.selected.size < MAX_PEERS) st.selected.add(t.dataset.compToggle); } else st.selected.delete(t.dataset.compToggle);
    render();
  });
  body.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement;
    if (f.id !== 'c-add') return;
    e.preventDefault();
    const q = (f.querySelector('#c-add-q') as HTMLInputElement).value.trim();
    if (q && /^[\p{L}\p{N} .,&'()-]+$/u.test(q)) compAdd(q);
  });

  // ---- prism: hovering a band lights its ray
  const refract = root.querySelector<HTMLElement>('.p-refract')!;
  root.querySelectorAll<HTMLElement>('.p-band').forEach((b) => {
    const on = () => { refract.dataset.hot = b.dataset.band!; root.querySelectorAll('.pz-ray').forEach((r) => r.classList.toggle('is-hot', (r as HTMLElement).dataset.band === b.dataset.band)); };
    const off = () => { delete refract.dataset.hot; };
    b.addEventListener('mouseenter', on); b.addEventListener('focus', on);
    b.addEventListener('mouseleave', off); b.addEventListener('blur', off);
  });

  // ---- anonymous usage events (Google Analytics via the site's consent-mode gtag; sent as cookieless
  // signals when a visitor has declined cookies). Only the company and format are recorded, nothing personal.
  const track = (name: string, params: Record<string, string>) => {
    try { (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', name, params); } catch { /* ignore */ }
  };

  // ---- live search
  const form = document.getElementById('p-search') as HTMLFormElement;
  const qInput = document.getElementById('p-q') as HTMLInputElement;
  const goBtn = document.getElementById('p-go') as HTMLButtonElement;
  const ack = document.getElementById('p-ack') as HTMLInputElement;
  const msg = document.getElementById('p-msg')!;
  const switchEl = document.getElementById('p-switch')!;
  try { if (localStorage.getItem('prysm-ack') === '1') ack.checked = true; } catch { /* storage unavailable */ }
  const syncGo = () => { goBtn.disabled = !ack.checked || !qInput.value.trim(); };
  ack.addEventListener('change', () => { syncGo(); try { localStorage.setItem('prysm-ack', ack.checked ? '1' : '0'); } catch { /* ignore */ } });
  qInput.addEventListener('input', syncGo);
  syncGo();

  const STEPS = ['Finding the company in SEC EDGAR', 'Reading financials (XBRL) and the latest 10-K', 'Scanning news, 8-K filings and buying signals',
    'Profiling peers and their recent moves', 'Checking industry shifts', 'Building sales plays and verifying every number'];
  let busy = false;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = qInput.value.trim();
    if (!q || busy) return;
    if (!ack.checked) { msg.textContent = 'Please confirm you understand the content is AI-generated and may contain errors.'; ack.focus(); return; }
    busy = true; goBtn.disabled = true; msg.textContent = '';
    document.getElementById('p-co-name')!.textContent = q;
    document.getElementById('p-co-meta')!.textContent = 'Researching…';
    body.innerHTML = `<ol class="p-progress">${STEPS.map((s) => `<li>${s}</li>`).join('')}</ol>`;
    const lis = [...body.querySelectorAll('li')];
    let i = 0;
    const tick = setInterval(() => { if (i > 0) lis[i - 1]?.classList.replace('on', 'done'); lis[i]?.classList.add('on'); i = Math.min(i + 1, lis.length); }, 900);
    try {
      const r = await fetch(`/api/prysm?q=${encodeURIComponent(q)}`);
      const j = await r.json().catch(() => ({ error: 'upstream' }));
      if (!r.ok || j.error) {
        msg.textContent = j.error === 'not_found'
          ? `No SEC-registered company matched “${q}”. PRYSM Live covers US-listed companies: try the exact name or the stock ticker.`
          : j.error === 'no_financials' ? `${j.name || q} files with the SEC but has no annual financial data yet, so a deep dive isn't possible.`
          : j.error === 'bad_query' ? 'Please use letters, numbers and basic punctuation only.'
          : 'The public data sources didn’t respond in time. Please try again in a minute.';
        track('prysm_search', { company: q.slice(0, 40), result: String(j.error || 'error') });
        if (data) { setHeader(data); render(); }
        return;
      }
      track('prysm_search', { company: j.company.ticker, result: 'ok' });
      const key = `live:${j.company.ticker}`;
      cache[key] = j;
      let chip = switchEl.querySelector<HTMLButtonElement>(`[data-co="${key}"]`);
      if (!chip) {
        chip = document.createElement('button');
        chip.type = 'button'; chip.setAttribute('role', 'tab'); chip.dataset.co = key;
        chip.innerHTML = `${j.company.name.replace(/,? Inc\.?$/, '').replace(/[&<>]/g, '')} <small>live</small>`;
        switchEl.appendChild(chip);
      }
      switchEl.querySelectorAll('[data-co]').forEach((b) => b.setAttribute('aria-selected', String(b === chip)));
      tab = 'overview';
      await load(key);
    } finally {
      clearInterval(tick); busy = false; syncGo();
    }
  });

  // ---- downloads (Word / PDF) of whichever report is on screen
  const num = (id: string) => numbers.get(id) ?? 0;
  document.getElementById('p-dl-word')!.addEventListener('click', async () => {
    if (!data) return; track('prysm_download', { format: 'word', company: data.company.ticker }); await exportWord(data as never, num);
  });
  document.getElementById('p-dl-pdf')!.addEventListener('click', () => {
    if (!data) return; track('prysm_download', { format: 'pdf', company: data.company.ticker }); exportPdf(data as never, num);
  });

  load('caterpillar');
</script>
