---
import Layout from '../layouts/Layout.astro';

const publications = [
  {
    title: 'Shift Right — Microsoft’s Navigation from CCaaS to UCaaS',
    href: 'https://www.infosys.com/services/microsoft-cloud-business/insights/documents/shift-right-microsofts-navigation.pdf',
  },
  {
    title: 'Azure Confidential Ledger for Enhanced Privacy',
    href: 'https://www.infosys.com/services/microsoft-dynamics/insights/documents/azure-confidential-ledger.pdf',
  },
];
---

<Layout title="Thought Leadership" description="Publications and frameworks from Venu Uppaluri on strategy, analytics, and AI.">
  <section class="border-b border-edge/15">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-glow">Thought leadership</p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-fg sm:text-6xl">Ideas worth returning to.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-mist-300">A growing library of publications and frameworks on strategy, analytics, AI, and leadership.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid border-y border-edge/15 md:grid-cols-2">
      <article class="py-8 md:pr-8 md:py-10">
        <p class="text-[11px] font-semibold tracking-[0.14em] text-cyan-glow">01</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-[-0.03em] text-fg">Publications</h2>
        <p class="mt-3 leading-relaxed text-mist-300">Articles, reports, and published points of view.</p>
        <ul class="mt-6 space-y-4">
          {publications.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="group flex items-start justify-between gap-3">
                <span class="text-sm font-medium leading-snug text-mist-200 group-hover:text-fg transition-colors">{p.title}</span>
                <span class="mt-0.5 flex shrink-0 items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wide text-mist-400 group-hover:text-cyan-glow transition-colors">
                  PDF
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M3.5 8.5 8.5 3.5M4 3.5h4.5V8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </article>
      <article class="border-t border-edge/15 py-8 md:border-l md:border-t-0 md:pl-8 md:py-10"><p class="text-[11px] font-semibold tracking-[0.14em] text-cyan-glow">02</p><h2 class="mt-4 font-serif text-3xl font-semibold tracking-[-0.03em] text-fg">Frameworks</h2><p class="mt-3 leading-relaxed text-mist-300">Reusable ways to frame problems, assess choices, and connect analysis to business action.</p><a href="/decode-framework" class="mt-6 inline-flex border-b border-cyan-glow pb-0.5 text-sm font-semibold text-fg hover:text-cyan-glow">Explore DECODE →</a></article>
    </div>
  </section>
</Layout>
