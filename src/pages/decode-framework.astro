---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const steps = [
  { letter: 'D', word: 'Define', desc: 'Focus on problem framing and KPI alignment.' },
  { letter: 'E', word: 'Explore', desc: 'Assess the data landscape, governance, pipelines, and architecture safety.' },
  { letter: 'C', word: 'Contextualize', desc: 'Layer business reality and operational constraints onto the numbers.' },
  { letter: 'O', word: 'Optimize', desc: 'Fine-tune analytical models, maximize processing efficiencies, and align team capabilities.' },
  { letter: 'D', word: 'Deliver', desc: 'Master executive data storytelling and clean visualization.' },
  { letter: 'E', word: 'Execute', desc: 'Drive user adoption, operationalize the insight, and measure the exact strategic or financial ROI.' },
];

const personas = [
  { title: 'The Technical Builder', who: 'Data Engineers, Analysts, Developers' },
  { title: 'The Practice Leader', who: 'Consultants, Managers, Practice Leads' },
  { title: 'The Business Executive', who: 'C-Suite, Directors, Stakeholders' },
];
---

<Layout title="DECODE Framework" description="A repeatable leadership methodology that ensures every data model, pipeline, and report is directly anchored to an executive decision and a concrete business outcome.">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <PageHero eyebrow="Methodology" aside="Six steps, one story: from the business question to measured ROI." rule>
      <Fragment slot="title">DECODE <span class="gradient-text">Framework</span></Fragment>
      Driving Business Value through Strategic Analytics
    </PageHero>

    <section class="grid gap-8 py-12 sm:py-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <div>
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">The Mission</p>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold leading-tight tracking-[-0.03em] text-fg">Bridging the Data Execution Gap</h2>
      </div>
      <div class="prose-decode">
        <p>
          Most analytics initiatives fail not because of technical execution, but because they lack
          alignment with business reality. Throughout my consulting career and client engagements, I
          consistently observe a distinct disconnect: technical teams excel at deploying brilliant data
          models and executive dashboards, while business leaders focus entirely on driving customer
          value and top- or bottom-line growth.
        </p>
        <blockquote><p>The missing link is a single, coherent story that bridges the technical output to the strategic outcome.</p></blockquote>
        <p>
          The DECODE framework was envisioned to bridge this exact gap. It is a repeatable leadership
          methodology that ensures every data model, pipeline, and report is directly anchored to an
          executive decision and a concrete business outcome.
        </p>
      </div>
    </section>

    <section class="border-t border-edge/15 pt-12 sm:pt-16">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">The six steps</p>
      <ol class="mt-8 grid border-t border-edge/15 sm:grid-cols-2 lg:grid-cols-3">
        {steps.map((s, i) => (
          <li class:list={[
            'border-b border-edge/15 py-8',
            i % 2 === 0 ? 'sm:pr-8' : 'sm:border-l sm:pl-8',
            i % 3 === 0 ? 'lg:border-l-0 lg:pl-0' : 'lg:border-l lg:pl-8',
            i % 3 === 2 ? 'lg:pr-0' : 'lg:pr-8',
          ]}>
            <div class="flex items-baseline gap-4">
              <span class="font-serif text-6xl font-semibold leading-none tracking-[-0.04em] text-cyan-glow">{s.letter}</span>
              <span class="text-[13px] font-bold tracking-[0.14em] text-mist-400">0{i + 1}</span>
            </div>
            <h3 class="mt-5 font-serif text-2xl font-semibold tracking-[-0.02em] text-fg">{s.word}</h3>
            <p class="mt-2 max-w-sm leading-relaxed text-mist-300">{s.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="pt-14 sm:pt-20">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Who It's For</p>
      <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold tracking-[-0.03em] text-fg">Framework Inference for Personas</h2>
      <div class="mt-8 grid gap-x-8 sm:grid-cols-3">
        {personas.map((p, i) => (
          <div class="card py-6">
            <p class="text-sm font-semibold text-mist-400">Persona {i + 1}</p>
            <h3 class="mt-2 font-serif text-xl font-semibold text-fg">{p.title}</h3>
            <p class="mt-2 text-mist-300">{p.who}</p>
          </div>
        ))}
      </div>
      <a href="/concepts" class="mt-10 inline-flex items-center btn-primary px-5 py-3 text-sm font-semibold">
        Explore DECODE Insights
      </a>
    </section>
  </div>
</Layout>
