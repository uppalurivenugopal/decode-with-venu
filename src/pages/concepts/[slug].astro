---
import ArticleLayout from '../../components/ArticleLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'concepts'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allConcepts = (await getCollection('concepts')).sort(
  (a, b) => (a.data.seriesIndex ?? 0) - (b.data.seriesIndex ?? 0)
);
const series = allConcepts.filter((c) => entry.data.series && c.data.series === entry.data.series);
const next = allConcepts.find((c) => (c.data.seriesIndex ?? 0) === (entry.data.seriesIndex ?? 0) + 1);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  subtitle={entry.data.subtitle}
  date={entry.data.date}
  body={entry.body}
  section="Concepts"
  sectionHref="/concepts"
  kicker={entry.data.series && `Part ${entry.data.seriesIndex}`}
  headings={headings}
  dropcap={false}
>
  <Content />

  {next && (
    <div slot="after" class="mt-16">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Next in the series</p>
      <a href={`/concepts/${next.id}`} class="card group mt-4 block py-6">
        <h3 class="font-serif text-2xl font-semibold tracking-[-0.02em] text-fg group-hover:text-cyan-glow transition-colors">{next.data.title}</h3>
        {next.data.subtitle && <p class="mt-2 text-mist-400">{next.data.subtitle}</p>}
        <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-fg group-hover:text-cyan-glow transition-colors">Continue reading <span aria-hidden="true">→</span></span>
      </a>
    </div>
  )}

  {series.length > 1 && (
    <nav slot="rail" aria-label="Series">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">The series</p>
      <p class="mt-3 font-serif text-lg leading-snug text-fg">{entry.data.series}</p>
      <ol class="mt-3 space-y-2 text-sm leading-snug">
        {series.map((c) => (
          <li class="flex gap-3">
            <span class="w-4 shrink-0 text-mist-400">{c.data.seriesIndex}</span>
            {c.id === entry.id
              ? <span class="font-semibold text-fg">{c.data.title}</span>
              : <a href={`/concepts/${c.id}`} class="text-mist-400 hover:text-fg transition-colors">{c.data.title}</a>}
          </li>
        ))}
      </ol>
    </nav>
  )}
</ArticleLayout>
