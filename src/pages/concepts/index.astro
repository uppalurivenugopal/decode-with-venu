---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getCollection } from 'astro:content';

const concepts = (await getCollection('concepts')).sort(
  (a, b) => (a.data.seriesIndex ?? 0) - (b.data.seriesIndex ?? 0)
);
const seriesName = concepts.find((c) => c.data.series)?.data.series;
---

<Layout title="Concepts" description="Demystifying data models, analytics, and practical AI frameworks.">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <PageHero eyebrow="Concepts" aside={seriesName && `Currently running: “${seriesName}”, a ${concepts.length}-part series.`}>
      <Fragment slot="title">Demystifying <span class="gradient-text">data models</span></Fragment>
      Analytics and practical AI frameworks — simplified technical insights broken down
      for business application, one article at a time.
    </PageHero>

    <section>
      {seriesName && <p class="mb-6 text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Series &middot; {seriesName}</p>}
      <ArticleList items={concepts.map((c) => ({
        href: `/concepts/${c.id}`,
        title: c.data.title,
        description: c.data.description,
        date: c.data.date,
        body: c.body,
        kicker: c.data.seriesIndex ? `Part ${c.data.seriesIndex} · ${c.data.subtitle ?? ''}` : c.data.subtitle,
        image: `/images/articles/${c.id}.png`,
      }))} />
    </section>
  </div>
</Layout>
