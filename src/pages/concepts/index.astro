---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const concepts = (await getCollection('concepts')).sort(
  (a, b) => (a.data.seriesIndex ?? 0) - (b.data.seriesIndex ?? 0)
);
---

<Layout title="Concepts" description="Demystifying data models, analytics, and practical AI frameworks.">
  <section class="relative overflow-hidden bg-grid border-b border-white/5">
    <div class="glow w-[30rem] h-[30rem] bg-cyan-glow/15 -top-40 right-1/3"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-5 sm:px-8 pt-20 pb-16 sm:pt-28 sm:pb-20">
      <p class="font-mono text-xs tracking-widest text-cyan-glow/80 uppercase mb-4">Concepts</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Why your data <span class="gradient-text">may be lying</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-mist-300">
        Demystifying data models, analytics, and practical AI frameworks — simplified
        technical insights broken down for business application.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 sm:px-8 py-16 sm:py-20">
    <p class="font-mono text-xs tracking-widest text-mist-400 uppercase mb-6">Series &middot; The Architecture of Deception</p>
    <div class="space-y-5">
      {concepts.map((c) => (
        <a href={`/concepts/${c.id}`} class="card group block p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="font-mono text-xs text-cyan-glow/80">Part {c.data.seriesIndex}</span>
            <span class="text-mist-400/40 text-xs">&bull;</span>
            <span class="text-xs text-mist-400">{c.data.subtitle}</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-glow transition-colors">
            {c.data.title}
          </h2>
          <p class="mt-3 text-mist-400 leading-relaxed">{c.data.description}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-mist-300 group-hover:text-white transition-colors">
            Read article
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7M6 2.5L9.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
