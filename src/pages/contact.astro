---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Me" description="Get in touch with Venu Uppaluri about consulting, career guidance, or analytics learning.">
  <section class="border-b border-edge/15">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Contact me</p>
      <h1 class="mt-5 max-w-3xl font-serif text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-fg sm:text-6xl">A useful conversation can be a good place to start.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-mist-300">Whether you are exploring a consulting engagement, seeking career guidance, or learning analytics, I’d be pleased to hear from you.</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-14 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[.78fr_1.22fr]">
    <div class="space-y-8">
      <div>
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">How I can help</p>
        <div class="mt-5 space-y-5">
          <div><h2 class="font-serif text-2xl font-semibold text-fg">Consulting</h2><p class="mt-1 leading-relaxed text-mist-300">Strategy, analytics, AI, operating models, and the path from insight to action.</p></div>
          <div><h2 class="font-serif text-2xl font-semibold text-fg">Career guidance</h2><p class="mt-1 leading-relaxed text-mist-300">A practical perspective for people shaping their next step in analytics, consulting, or leadership.</p></div>
          <div><h2 class="font-serif text-2xl font-semibold text-fg">Analytics learning</h2><p class="mt-1 leading-relaxed text-mist-300">Clear, grounded conversations for teams and individuals building analytical confidence.</p></div>
        </div>
      </div>
      <a href="https://www.linkedin.com/in/uppalurivenugopal/" target="_blank" rel="noopener noreferrer" class="inline-flex border-b border-cyan-glow pb-1 text-sm font-semibold text-fg hover:text-cyan-glow">Connect on LinkedIn ↗</a>
    </div>

    <div class="border border-edge/15 bg-ink-900 p-6 sm:p-9">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Send an enquiry</p>
      <form class="mt-7 grid gap-5" action="https://formsubmit.co/venu@decodewithvenu.com" method="POST">
        <input type="hidden" name="_subject" value="New contact enquiry — Decode with Venu" />
        <input type="hidden" name="_next" value="https://www.decodewithvenu.com/thank-you" />
        <input type="hidden" name="_template" value="table" />
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-semibold text-fg">Your name<input required name="name" class="form-input" autocomplete="name" /></label>
          <label class="grid gap-2 text-sm font-semibold text-fg">Email address<input required name="email" type="email" class="form-input" autocomplete="email" /></label>
        </div>
        <label class="grid gap-2 text-sm font-semibold text-fg">I’m getting in touch about<select name="topic" class="form-input"><option>Consulting opportunity</option><option>Career guidance</option><option>Analytics learning</option><option>Something else</option></select></label>
        <label class="grid gap-2 text-sm font-semibold text-fg">Your message<textarea required name="message" rows="6" class="form-input resize-y"></textarea></label>
        <button type="submit" class="justify-self-start btn-primary px-5 py-3 text-sm font-semibold">Send message</button>
      </form>
    </div>
  </section>
</Layout>
