---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const strategies = await getCollection('strategies');
  return strategies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'strategies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article>
    <section class="relative overflow-hidden bg-grid border-b border-edge/5">
      <div class="glow w-[26rem] h-[26rem] bg-indigo-glow/15 -top-32 left-1/4"></div>
      <div class="relative z-10 mx-auto max-w-3xl px-5 sm:px-8 pt-16 pb-14 sm:pt-20 sm:pb-16">
        <a href="/strategies" class="inline-flex items-center gap-1.5 text-sm text-mist-400 hover:text-fg transition-colors mb-8">
          <svg class="w-3.5 h-3.5" viewBox="0 0 12 12" fill="none"><path d="M9.5 6h-7M6 9.5L2.5 6 6 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Strategies
        </a>
        <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow mb-4">Strategies</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-fg">
          {entry.data.title}
        </h1>
        {entry.data.subtitle && (
          <p class="mt-4 text-lg text-mist-300">{entry.data.subtitle}</p>
        )}
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-5 sm:px-8 py-14 sm:py-16">
      <div class="prose-decode">
        <Content />
      </div>

      {entry.data.source && (
        <p class="mt-12 pt-8 border-t border-edge/5 text-sm text-mist-400">
          Originally published on{' '}
          <a href={entry.data.source} target="_blank" rel="noopener noreferrer" class="text-cyan-glow hover:underline">LinkedIn</a>.
        </p>
      )}
    </section>
  </article>
</Layout>
