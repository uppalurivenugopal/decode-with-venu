---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ArticleList from '../components/ArticleList.astro';
import { getCollection } from 'astro:content';
import { formatShortDate } from '../utils/article';

const entries = (await getCollection('perspectives')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const aside = entries.length
  ? `${entries.length} ${entries.length === 1 ? 'perspective' : 'perspectives'}. Latest ${formatShortDate(entries[0].data.date)}.`
  : undefined;
---

<Layout title="Perspectives" description="Curated reviews and strategic takeaways from leading business books and podcasts.">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <PageHero eyebrow="Perspectives" aside={aside}>
      <Fragment slot="title">Ideas worth <span class="gradient-text">borrowing</span></Fragment>
      Curated reviews and strategic takeaways from leading business books and podcasts —
      blending external ideas with leadership reflections from over two decades in global consulting.
    </PageHero>

    <section>
      {entries.length > 0 ? (
        <ArticleList items={entries.map((e) => ({
          href: `/perspectives/${e.id}`,
          title: e.data.title,
          description: e.data.description,
          date: e.data.date,
          body: e.body,
          kicker: e.data.subtitle,
          image: `/images/articles/${e.id}.png`,
        }))} />
      ) : (
        <div class="card py-12">
          <h2 class="font-serif text-2xl font-semibold text-fg">More coming soon</h2>
          <p class="mt-3 max-w-md leading-relaxed text-mist-400">Subscribe to get the next one in your inbox the moment it publishes.</p>
          <a href="/subscribe" class="mt-8 inline-flex items-center btn-primary px-5 py-3 text-sm font-semibold">
            Get notified when it's live
          </a>
        </div>
      )}
    </section>
  </div>
</Layout>
