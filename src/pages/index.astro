---
import Layout from '../layouts/Layout.astro';

const sections = [
  { href: '/concepts', number: '01', title: 'Concepts', description: 'Clear explanations of data models, analytics, and practical AI—written for people who need to make decisions with them.' },
  { href: '/strategies', number: '02', title: 'Strategies', description: 'Enterprise case studies and observations on the choices that shape growth, execution, and competitive advantage.' },
  { href: '/perspectives', number: '03', title: 'Perspectives', description: 'Books, podcasts, and ideas worth examining through the lens of leadership and lived consulting experience.' },
  { href: '/projects', number: '04', title: 'Projects', description: 'Small, hands-on experiments that make analytical ideas easier to see, test, and understand.' },
];
---

<Layout title="Home" description="Practical notes on strategy, analytics, and AI from Venu Uppaluri.">
  <section class="border-b border-edge/15">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-glow">Strategy · Analytics · AI</p>
      <h1 class="mt-6 max-w-4xl font-serif text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-fg sm:text-6xl lg:text-7xl">Making analytics useful in the real world.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-mist-300">I write about turning technical possibility into better business decisions—drawing on two decades in strategy, analytics, and global consulting.</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/decode-framework" class="inline-flex items-center btn-primary px-5 py-3 text-sm font-semibold">The DECODE framework</a>
        <a href="/about" class="border-b border-edge/30 pb-0.5 text-sm font-semibold text-fg hover:border-cyan-glow hover:text-cyan-glow transition-colors">More about Venu</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-glow">The notebook</p>
      <h2 class="mt-4 font-serif text-4xl font-semibold leading-tight tracking-[-0.035em] text-fg sm:text-5xl">Work that starts with the question, not the technology.</h2>
      <p class="mt-5 text-lg leading-relaxed text-mist-300">A place for practical frameworks, observed patterns, and useful ideas—without the jargon or the theatre.</p>
    </div>

    <div class="mt-12 grid border-y border-edge/15 md:grid-cols-2">
      {sections.map((section, index) => (
        <a href={section.href} class:list={[
          'group relative block py-8 md:px-8 md:py-10',
          index % 2 === 0 ? 'md:pr-12' : 'md:border-l md:border-edge/15 md:pl-12',
          index < 2 ? 'border-b border-edge/15' : '',
        ]}>
          <p class="text-[11px] font-semibold tracking-[0.14em] text-cyan-glow">{section.number}</p>
          <h3 class="mt-4 font-serif text-3xl font-semibold tracking-[-0.03em] text-fg group-hover:text-cyan-glow transition-colors">{section.title}</h3>
          <p class="mt-3 max-w-md leading-relaxed text-mist-300">{section.description}</p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-fg group-hover:text-cyan-glow transition-colors">Explore <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-edge/15 bg-ink-900">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:px-8 sm:py-16 md:grid-cols-[.7fr_1.3fr] md:items-start">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-glow">A working belief</p>
      <blockquote class="font-serif text-3xl font-medium leading-[1.18] tracking-[-0.025em] text-fg sm:text-4xl">“The value of analytics is not in the model. It is in the decision it helps someone make.”</blockquote>
    </div>
  </section>
</Layout>
