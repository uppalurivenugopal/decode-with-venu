---
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    href: '/concepts',
    icon: 'concepts',
    title: 'Concepts',
    description: 'Demystifying data models, analytics, and practical AI frameworks. Simplified technical insights and foundational learnings broken down for business application.',
  },
  {
    href: '/strategies',
    icon: 'strategies',
    title: 'Strategies',
    description: 'Real-world enterprise case studies and deep dives into shifting market dynamics. Dissecting execution models, structural growth, and strategic pitfalls across industries.',
  },
  {
    href: '/perspectives',
    icon: 'perspectives',
    title: 'Perspectives',
    description: 'Curated reviews and strategic takeaways from leading business books and podcasts. Blending external ideas with leadership reflections from over two decades in global consulting.',
  },
];
---

<Layout title="Home">
  <section class="relative overflow-hidden bg-grid">
    <div class="glow w-[36rem] h-[36rem] bg-cyan-glow/20 -top-56 left-1/2 -translate-x-1/2"></div>
    <div class="glow w-[28rem] h-[28rem] bg-indigo-glow/20 top-20 right-0"></div>

    <div class="relative z-10 mx-auto max-w-6xl px-5 sm:px-8 pt-24 pb-20 sm:pt-32 sm:pb-28 text-center">
      <p class="font-mono text-xs tracking-widest text-cyan-glow/80 uppercase mb-6">Strategy &middot; Analytics &middot; AI</p>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-fg leading-[1.08]">
        Strategy, Analytics, AI <span class="gradient-text">— Decoded</span>
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-mist-400">
        Practical frameworks and real enterprise case studies from two decades bridging
        the gap between data models and boardroom decisions.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/decode-framework" class="inline-flex items-center rounded-full btn-primary px-6 py-3 text-sm font-semibold transition-colors">
          Explore the DECODE Framework
        </a>
        <a href="/about" class="inline-flex items-center rounded-full border border-edge/15 text-mist-200 px-6 py-3 text-sm font-semibold hover:border-edge/30 hover:text-fg transition-colors">
          About Venu
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8 pb-24 sm:pb-32">
    <div class="grid sm:grid-cols-3 gap-5">
      {pillars.map((p) => (
        <a href={p.href} class="card group p-7 flex flex-col">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-glow/20 to-indigo-glow/20 border border-edge/10 flex items-center justify-center mb-6">
            {p.icon === 'concepts' && (
              <svg class="w-5 h-5 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M9.5 4a5.5 5.5 0 013.9 9.4L15 15h1a1 1 0 011 1v1a1 1 0 01-1 1h-1v1a1 1 0 01-1 1h-2a1 1 0 01-1-1v-1H9a1 1 0 01-1-1v-1H7a1 1 0 01-1-1v-1l1.6-1.6A5.5 5.5 0 019.5 4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            )}
            {p.icon === 'strategies' && (
              <svg class="w-5 h-5 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M4 20l4-4m0 0l5-9 3 5 4-7M8 16l3-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {p.icon === 'perspectives' && (
              <svg class="w-5 h-5 text-cyan-glow" viewBox="0 0 24 24" fill="none"><path d="M4 5a2 2 0 012-2h9l5 5v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            )}
          </div>
          <h3 class="text-lg font-semibold text-fg flex items-center gap-2">
            {p.title}
            <svg class="w-3.5 h-3.5 text-mist-400 group-hover:text-cyan-glow group-hover:translate-x-0.5 transition-all" viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7M6 2.5L9.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </h3>
          <p class="mt-3 text-sm text-mist-400 leading-relaxed">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
