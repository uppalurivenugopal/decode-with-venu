---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You" description="Your message has been sent to Decode with Venu.">
  <section class="min-h-[65vh] border-b border-edge/15">
    <div class="mx-auto max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-cyan-glow">Thank you</p>
      <h1 class="mt-5 font-serif text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-fg sm:text-6xl">Your message is on its way.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-mist-300">Thank you for getting in touch. Venu will respond as soon as possible.</p>
      <a href="/" class="mt-9 inline-flex btn-primary px-5 py-3 text-sm font-semibold">Back to home</a>
    </div>
  </section>
</Layout>
