---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

// Drawn only from the bio below, so the rail never says more than the page does.
const facts = [
  { value: '20+ years', label: 'Strategy, analytics and AI' },
  { value: 'Accenture · Infosys', label: 'Global engagements led' },
  { value: '15 full marathons', label: 'And counting' },
];
---

<Layout title="About Me" description="Strategic Advisor — AI & Analytics. Over two decades of experience at the intersection of technology and business strategy.">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <PageHero eyebrow="About Me" rule>
      <Fragment slot="title">Strategy, analytics, <span class="gradient-text">and the work in between.</span></Fragment>
    </PageHero>

    <section class="grid gap-10 pt-10 sm:pt-12 md:grid-cols-[13rem_minmax(0,1fr)] lg:grid-cols-[13rem_minmax(0,38rem)_14rem] lg:justify-between">
      <div>
        <div class="w-44 h-44 md:w-full md:h-auto md:aspect-square overflow-hidden border border-edge/15 bg-ink-800 flex items-center justify-center p-2">
          <img
            src="/images/venu.jpg"
            alt="Venu"
            class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <span class="hidden w-full h-full items-center justify-center font-serif text-3xl font-semibold text-cyan-glow">VU</span>
        </div>
        <a
          href="https://www.linkedin.com/in/uppalurivenugopal/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 border-b border-cyan-glow pb-1 text-sm font-semibold text-fg hover:text-cyan-glow transition-colors"
        >
          Connect on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="prose-decode dropcap">
        <p>
          With over two decades of experience at the intersection of technology and business
          strategy, I specialize in transforming complex organizational challenges into
          high-impact solutions. Having led global engagements at <strong>Accenture</strong> and <strong>Infosys</strong>, I bring a seasoned perspective to Analytics, Machine Learning, and
          the design of AI Centers of Excellence.
        </p>
        <p>
          I thrive on decoding intricate data to provide C-suite leaders with the actionable
          insights they need to navigate competitive landscapes. My approach is rooted in the
          belief that sustainable growth requires more than just vision — it demands disciplined
          execution and measurable checkpoints.
        </p>
        <p>
          Much like my experience as a <strong>passionate marathoner</strong>, I view every business
          objective as a journey that requires long-term planning, resilience, and a relentless
          focus on the finish line.
        </p>
      </div>

      <dl class="border-t border-edge/15 md:col-start-2 lg:col-start-auto lg:border-t-0 lg:border-l lg:pl-6">
        {facts.map((f) => (
          <div class="border-b border-edge/15 py-4 lg:first:pt-0 last:border-b-0">
            <dt class="font-serif text-xl font-semibold tracking-[-0.02em] text-fg">{f.value}</dt>
            <dd class="mt-1 text-sm text-mist-400">{f.label}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</Layout>
