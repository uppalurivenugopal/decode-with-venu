---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Strategy, Analytics, AI — Decoded. Practical frameworks and real-world case studies at the intersection of data, strategy, and leadership.',
  image = '/images/og/default.png',
} = Astro.props;

const absoluteImage = new URL(image, Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · Decode with Venu</title>

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={`${title} · Decode with Venu`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Decode with Venu`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <script is:inline>
      // Apply the reader's saved text size before first paint (see TextSize.astro).
      try {
        var t = localStorage.getItem('text-size');
        if (t === 'large' || t === 'xlarge') document.documentElement.dataset.textSize = t;
      } catch (e) {}
    </script>

    <script>
      // Vercel Web Analytics: aggregate, anonymized pageview counts only.
      // No cookies, no personal data, no cross-site tracking.
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body class="bg-ink-950 text-mist-200 selection:bg-cyan-glow/20">
    <Nav />
    <div class="md:ml-[248px] flex min-h-screen flex-col">
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <CookieConsent />

    <script>
      // Text-size control: one handler for every instance (sidebar and mobile header).
      const root = document.documentElement;
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-text-size-btn]');
      const sync = () => {
        const current = root.dataset.textSize ?? 'default';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.textSizeBtn === current)));
      };
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const size = b.dataset.textSizeBtn ?? 'default';
          if (size === 'default') delete root.dataset.textSize;
          else root.dataset.textSize = size;
          try {
            if (size === 'default') localStorage.removeItem('text-size');
            else localStorage.setItem('text-size', size);
          } catch {}
          sync();
        })
      );
      sync();
    </script>
  </body>
</html>
